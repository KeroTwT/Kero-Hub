local VariantSuffixes = { " Gold", " Rainbow", " Shiny", " Void" }
local function DetectUnitVariant(unitName, recordedVariant)
    local explicit = tostring(recordedVariant or "")
    if explicit ~= "" then return explicit end
    local name = tostring(unitName or "")
    if name:sub(-5) == " Gold" or name:sub(-6) == " Shiny" then return "Shiny" end
    if name:sub(-8) == " Rainbow" or name:sub(-5) == " Void" then return "Void" end
    return "Normal"
end

local function ResolveBaseUnitName(unitName, recordedBaseUnit)
    local explicit = tostring(recordedBaseUnit or "")
    if explicit ~= "" then return explicit end

    local variant = tostring(unitName or "")
    local templates = ReplicatedStorage:FindFirstChild("Towers")
    for _, suffix in ipairs(VariantSuffixes) do
        if variant:sub(-#suffix) == suffix then
            local candidate = variant:sub(1, #variant - #suffix)
            if candidate ~= "" and (not templates or templates:FindFirstChild(candidate)) then
                return candidate
            end
        end
    end
    if templates and templates:FindFirstChild(variant) then
        return variant
    end
    return variant
end

