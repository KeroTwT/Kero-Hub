local function GetLoadoutUnit(slot)
    local playerGui = LocalPlayer and LocalPlayer:FindFirstChildOfClass("PlayerGui")
    local gameGui = playerGui and playerGui:FindFirstChild("GameGui")
    local towers = gameGui and gameGui:FindFirstChild("Towers")
    local frame = towers and towers:FindFirstChild("Frame")
    local slotFrame = frame and frame:FindFirstChild("Slot" .. tostring(slot))
    local towerValue = slotFrame and slotFrame:FindFirstChild("TowerValue")
    if towerValue and towerValue:IsA("StringValue") then
        return tostring(towerValue.Value or "")
    end
    return ""
end

local function GetCurrentMapModel()
    local mapFolder = Workspace:FindFirstChild("Map")
    if not mapFolder then return nil end
    RefreshObjects()
    local currentName = tostring(GetValue(InfoFolder, "Mode", ""))
    local exact = mapFolder:FindFirstChild(currentName ~= "" and currentName or State.SelectedMap)
    if exact then return exact end
    for _, candidate in ipairs(mapFolder:GetChildren()) do
        if candidate:FindFirstChild("Waypoints") then return candidate end
    end
    return nil
end

local function SortedWaypointParts(parent)
    local result = {}
    for _, object in ipairs(parent:GetChildren()) do
        if object:IsA("BasePart") then table.insert(result, object) end
    end
    table.sort(result, function(a, b)
        local aNumber, bNumber = tonumber(a.Name), tonumber(b.Name)
        if aNumber and bNumber then return aNumber < bNumber end
        if aNumber then return true end
        if bNumber then return false end
        return a.Name < b.Name
    end)
    return result
end

local function RouteLength(route)
    local length = 0
    for index = 2, #route do
        length = length + (route[index].Position - route[index - 1].Position).Magnitude
    end
    return length
end

local function DetectWaypointRoutes()
    local map = GetCurrentMapModel()
    if not map then return nil, nil, "Map was not found" end
    local waypoints = map:FindFirstChild("Waypoints")
    if not waypoints then return nil, map, "Waypoints were not found in " .. map.Name end
    local routes = {}
    local direct = SortedWaypointParts(waypoints)
    if #direct >= 2 then table.insert(routes, direct) end
    for _, lane in ipairs(waypoints:GetChildren()) do
        if not lane:IsA("BasePart") then
            local route = SortedWaypointParts(lane)
            if #route >= 2 then table.insert(routes, route) end
        end
    end
    table.sort(routes, function(a, b) return RouteLength(a) > RouteLength(b) end)
    if #routes == 0 then return nil, map, "No numbered waypoint route was found" end
    return routes, map
end

local function InterpolateRoute(route, percent)
    if not route or #route == 0 then return nil end
    if #route == 1 then return route[1].Position end
    local total = RouteLength(route)
    if total <= 0 then return route[1].Position end
    local remaining = total * math.clamp((tonumber(percent) or 50) / 100, 0, 1)
    for index = 2, #route do
        local from, to = route[index - 1].Position, route[index].Position
        local segment = (to - from).Magnitude
        if remaining <= segment then
            return from:Lerp(to, segment > 0 and remaining / segment or 0)
        end
        remaining = remaining - segment
    end
    return route[#route].Position
end

local function RefreshPlacementRoutes(force)
    local routes, map, reason = DetectWaypointRoutes()
    if not routes then
        State.PlacementRoutes = nil
        State.PlacementRoute = nil
        State.PlacementNode = nil
        State.PlacementRouteMap = nil
        State.PlacementRouteReason = reason
        return false, reason
    end
    if force or State.PlacementRouteMap ~= map then
        State.PlacementRoutes = routes
        State.PlacementRoute = routes[1]
        State.PlacementRouteMap = map
        State.PlacementAttempt = 0
    end
    State.PlacementRouteReason = nil
    State.PlacementNode = InterpolateRoute(State.PlacementRoute, State.RoutePercent)
    return State.PlacementNode ~= nil
end

local function GetPlacementNodePosition()
    RefreshPlacementRoutes(false)
    return State.PlacementNode
end

local function DestroyPlacementVisual()
    if State.PlacementVisual then
        pcall(function() State.PlacementVisual:Destroy() end)
        State.PlacementVisual = nil
    end
end

local function UpdatePlacementVisual()
    if not State.ShowPlacementNode then
        DestroyPlacementVisual()
        return
    end
    local position = GetPlacementNodePosition()
    if not position then
        if Gui.PlacementNode then
            Gui.PlacementNode:SetDesc(State.PlacementRouteReason or "Waiting for map waypoints")
        end
        return
    end
    if not State.PlacementVisual or not State.PlacementVisual.Parent then
        DestroyPlacementVisual()
        local folder = Instance.new("Folder")
        folder.Name = "SlopTD_PlacementNode"
        folder.Parent = Workspace

        local range = Instance.new("Part")
        range.Name = "Range"
        range.Anchored = true
        range.CanCollide = false
        range.CanQuery = false
        range.CanTouch = false
        range.CastShadow = false
        range.Shape = Enum.PartType.Cylinder
        range.Material = Enum.Material.Neon
        range.Color = Color3.fromRGB(70, 170, 255)
        range.Transparency = 0.78
        range.Parent = folder

        local center = Instance.new("Part")
        center.Name = "Center"
        center.Anchored = true
        center.CanCollide = false
        center.CanQuery = false
        center.CanTouch = false
        center.CastShadow = false
        center.Shape = Enum.PartType.Ball
        center.Material = Enum.Material.Neon
        center.Color = Color3.fromRGB(255, 255, 255)
        center.Size = Vector3.new(0.8, 0.8, 0.8)
        center.Parent = folder
        State.PlacementVisual = folder
    end
    local range = State.PlacementVisual:FindFirstChild("Range")
    local center = State.PlacementVisual:FindFirstChild("Center")
    if range then
        range.Size = Vector3.new(0.12, State.PlacementRadius * 2, State.PlacementRadius * 2)
        range.CFrame = CFrame.new(position + Vector3.new(0, 0.08, 0)) * CFrame.Angles(0, 0, math.rad(90))
    end
    if center then center.Position = position + Vector3.new(0, 0.45, 0) end
    if Gui.PlacementNode then
        Gui.PlacementNode:SetTitle("Auto-detected route")
        Gui.PlacementNode:SetDesc(string.format("%s | %d%% Entrance -> Base | Radius %.1f",
            State.PlacementRouteMap and State.PlacementRouteMap.Name or "Map",
            State.RoutePercent,
            State.PlacementRadius))
    end
end

