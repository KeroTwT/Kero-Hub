local function WaitForActionGate(action, playbackStarted)
    local timeout = os.clock() + 600
    while State.Playing and State.Running and os.clock() < timeout do
        local ready = false
        if State.PlaybackMode == "Time" then
            ready = os.clock() - playbackStarted >= (tonumber(action.Time) or 0)
        elseif State.PlaybackMode == "Money" then
            ready = GetCash() >= (tonumber(action.Cost) or 0)
        else
            ready = GetWave() >= (tonumber(action.Wave) or 0)
                and GetCash() >= (tonumber(action.Cost) or 0)
        end
        if ready then return true end
        task.wait(0.08)
    end
    return false, "Action gate timed out"
end

local function FindNewTower(before, unit, cframe)
    local found
    local failure
    WaitUntil(function()
        RefreshObjects()
        if not TowersFolder then return false end
        local candidates = {}
        for _, tower in ipairs(TowersFolder:GetChildren()) do
            if not before[tower] and IsOwnTower(tower) and GetTowerName(tower) == unit then
                local pivot = GetTowerCFrame(tower)
                local distance = pivot and (pivot.Position - cframe.Position).Magnitude or math.huge
                if distance <= 2 then
                    table.insert(candidates, { Tower = tower, Distance = distance })
                end
            end
        end
        table.sort(candidates, function(a, b) return a.Distance < b.Distance end)
        if #candidates > 1 and math.abs(candidates[1].Distance - candidates[2].Distance) < 0.05 then
            failure = "Placed tower identity is ambiguous"
            return true
        end
        found = candidates[1] and candidates[1].Tower or nil
        return found ~= nil
    end, 5, 0.05)
    return found, failure
end

local function ExecuteAction(action)
    RefreshObjects()
    local kind = tostring(action.Type)
    if kind == "Place" then
        local cframe = ArrayToCFrame(action.CFrame)
        if not cframe then return false, "Invalid placement CFrame" end
        local variantUnit = tostring(action.Unit or "")
        local baseUnit = ResolveBaseUnitName(variantUnit, action.BaseUnit)
        if baseUnit == "" or variantUnit == "" then return false, "Invalid unit identity" end
        local before = {}
        if TowersFolder then
            for _, tower in ipairs(TowersFolder:GetChildren()) do before[tower] = true end
        end
        local ok, accepted, placementMetadata = Invoke(
            Remotes.Request,
            { variantUnit, baseUnit },
            false,
            true
        )
        local reason = accepted
        if not ok then return false, "RequestTower: " .. tostring(reason) end
        if accepted == false then return false, "RequestTower was rejected" end
        if type(placementMetadata) ~= "table" then placementMetadata = {} end
        task.wait(0.05)
        local spawned
        ok, spawned = Invoke(
            Remotes.Place,
            baseUnit,
            cframe,
            false,
            variantUnit,
            placementMetadata
        )
        reason = spawned
        if not ok then return false, "SpawnTower: " .. tostring(reason) end
        if spawned == false then return false, "SpawnTower was rejected" end
        local tower = typeof(spawned) == "Instance" and spawned or nil
        if not tower or not tower.Parent or not IsOwnTower(tower) then
            local mappingReason
            tower, mappingReason = FindNewTower(before, variantUnit, cframe)
            if mappingReason then return false, mappingReason end
        end
        if not tower then return false, "Server did not create the placed tower" end
        local actual = GetTowerCFrame(tower)
        if not actual or (actual.Position - cframe.Position).Magnitude > 2 then
            return false, "Placed tower position did not match the macro"
        end
        State.RuntimeHandles[tostring(action.Handle)] = tower
        return true
    end

    local tower = State.RuntimeHandles[tostring(action.Handle)]
    if not tower or not tower.Parent then return false, "Runtime tower handle is missing" end

    if kind == "Upgrade" then
        local oldLevel = GetTowerLevel(tower)
        local expectedLevel = tonumber(action.Level) or (oldLevel + 1)
        local expectedPrevious = tonumber(action.PreviousLevel)
        if expectedPrevious and oldLevel ~= expectedPrevious then
            return false, string.format("Upgrade precondition mismatch: expected level %d, got %d", expectedPrevious, oldLevel)
        end
        if expectedLevel ~= oldLevel + 1 then
            return false, string.format("Upgrade order mismatch: level %d cannot become %d", oldLevel, expectedLevel)
        end
        local variantUnit = tostring(action.Unit or GetTowerName(tower))
        local ok, accepted = Invoke(Remotes.Upgrade, tower, variantUnit)
        if not ok then return false, "UpgradeTower: " .. tostring(accepted) end
        if accepted == false then return false, "UpgradeTower was rejected" end
        local confirmed = WaitUntil(function()
            return not tower.Parent or GetTowerLevel(tower) == expectedLevel
        end, 5, 0.05)
        return confirmed, confirmed and nil or "Upgrade was not confirmed"
    elseif kind == "Target" then
        local wanted = tostring(action.Mode or "")
        if wanted == "" or wanted == "N/A" then return true end
        local oldMode = GetTargetMode(tower)
        local expectedPrevious = tostring(action.PreviousMode or "")
        if expectedPrevious ~= "" and oldMode ~= expectedPrevious then
            return false, string.format("Target precondition mismatch: expected %s, got %s", expectedPrevious, oldMode)
        end
        local ok, accepted = Invoke(Remotes.Target, tower)
        if not ok then return false, "ChangeTowerMode: " .. tostring(accepted) end
        if accepted == false then return false, "ChangeTowerMode was rejected" end
        local confirmed = WaitUntil(function()
            return not tower.Parent or GetTargetMode(tower) == wanted
        end, 3, 0.05)
        return confirmed, confirmed and nil or "Target mode did not become " .. wanted
    elseif kind == "Sell" then
        local ok, accepted = Invoke(Remotes.Sell, tower)
        if not ok then return false, "SellTower: " .. tostring(accepted) end
        if accepted == false then return false, "SellTower was rejected" end
        local confirmed = WaitUntil(function() return not tower.Parent end, 5, 0.05)
        if confirmed then State.RuntimeHandles[tostring(action.Handle)] = nil end
        return confirmed, confirmed and nil or "Sell was not confirmed"
    end
    return false, "Unknown action type: " .. kind
end

local function StopPlayback(reason)
    State.Playing = false
    State.FirstPlaybackActionDone = false
    SetStatus("Stopped", reason or "Playback stopped")
end

local function StartPlayback()
    if State.Playing then return true end
    if State.Recording then return false, "Stop recording first" end
    if #State.Actions == 0 then return false, "Selected macro has no actions" end
    if not IsMatchActive() then
        SetStatus("Playback armed", "Waiting for GameRunning and wave 1")
        return false, "Waiting for the match to start"
    end

    State.Playing = true
    State.FirstPlaybackActionDone = false
    State.RuntimeHandles = {}
    State.PlaybackSerial = State.MatchSerial
    local copied, actions = pcall(function()
        return HttpService:JSONDecode(HttpService:JSONEncode(State.Actions))
    end)
    if not copied or type(actions) ~= "table" then
        State.Playing = false
        return false, "Could not snapshot macro actions"
    end
    task.spawn(function()
        local started = os.clock()
        for index, action in ipairs(actions) do
            if not State.Playing or not State.Running then return end
            SetStatus("Playback", string.format("%d/%d %s | W%d", index, #actions, action.Type, GetWave()))
            local ready, gateReason = WaitForActionGate(action, started)
            if not ready then
                StopPlayback(string.format("Action %d failed: %s", index, tostring(gateReason)))
                return
            end
            local ok, reason = ExecuteAction(action)
            if not ok then
                StopPlayback(string.format("Action %d failed: %s", index, tostring(reason)))
                return
            end
            if index == 1 then State.FirstPlaybackActionDone = true end
            task.wait(0.04)
        end
        State.Playing = false
        SetStatus("Complete", string.format("Played all %d actions", #actions))
    end)
    return true
end

