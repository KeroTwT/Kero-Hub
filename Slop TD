local function SellAllOwnTowers()
    if State.AutoSellBusy then return false, "Sell is already running" end
    State.AutoSellBusy = true
    RefreshObjects()
    if not Remotes.Sell then
        State.AutoSellBusy = false
        return false, "SellTower remote is unavailable"
    end

    if State.Playing then
        StopPlayback("Auto Sell All reached wave " .. tostring(State.AutoSellWave))
    end

    local sold, failed, emptyPasses = 0, 0, 0
    for _ = 1, 5 do
        RefreshObjects()
        local targets = {}
        if TowersFolder then
            for _, tower in ipairs(TowersFolder:GetChildren()) do
                if IsOwnTower(tower) then table.insert(targets, tower) end
            end
        end
        if #targets == 0 then
            emptyPasses = emptyPasses + 1
            if emptyPasses >= 2 then break end
            task.wait(0.2)
        else
            emptyPasses = 0
        end

        for _, tower in ipairs(targets) do
            if State.Running and tower.Parent and IsOwnTower(tower) then
                local ok, accepted = Invoke(Remotes.Sell, tower)
                if ok and accepted ~= false then
                    local removed = WaitUntil(function() return not tower.Parent end, 1.5, 0.05)
                    if removed then sold = sold + 1 else failed = failed + 1 end
                else
                    failed = failed + 1
                end
                task.wait(0.06)
            end
        end
        task.wait(0.15)
    end

    local remaining = 0
    RefreshObjects()
    if TowersFolder then
        for _, tower in ipairs(TowersFolder:GetChildren()) do
            if IsOwnTower(tower) then remaining = remaining + 1 end
        end
    end
    State.AutoSellBusy = false
    local detail = string.format("Sold %d | Failed %d | Remaining %d", sold, failed, remaining)
    return remaining == 0, detail
end

local function StartPlayback()
    if State.Playing then return true end
    if State.Recording then return false, "Stop recording first" end
    if #State.Actions == 0 then return false, "Selected macro has no actions" end
    if not IsMatchActive() then
        SetStatus("Playback armed", "Waiting for GameRunning and wave 1")
        return false, "Waiting for the match to start"
    end
    if State.ProfilePlaceId and State.ProfilePlaceId ~= game.PlaceId then
        State.PlaybackSerial = State.MatchSerial
        local reason = string.format(
            "Macro belongs to PlaceId %s, current match is %s",
            tostring(State.ProfilePlaceId), tostring(game.PlaceId)
        )
        SetStatus("Playback blocked", reason)
        return false, reason
    end

    State.Playing = true
    State.FirstPlaybackActionDone = false
    State.RuntimeHandles = {}
    State.PlaybackSerial = State.MatchSerial
    local copied, actions = pcall(function()
        return HttpService:JSONDecode(HttpService:JSONEncode(State.Actions))
    end)
    if not copied or type(actions) ~= "table" then
        State.Playing = false
        return false, "Could not snapshot macro actions"
    end
    task.spawn(function()
        local started = os.clock()
        for index, action in ipairs(actions) do
            if not State.Playing or not State.Running then return end
            SetStatus("Playback", string.format("%d/%d %s | W%d", index, #actions, action.Type, GetWave()))
            local ready, gateReason = WaitForActionGate(action, started)
            if not ready then
                StopPlayback(string.format("Action %d failed: %s", index, tostring(gateReason)))
                return
            end
            local ok, reason = ExecuteAction(action)
            if not ok then
                StopPlayback(string.format("Action %d failed: %s", index, tostring(reason)))
                return
            end
            if index == 1 then State.FirstPlaybackActionDone = true end
            task.wait(0.04)
        end
        State.Playing = false
        SetStatus("Complete", string.format("Played all %d actions", #actions))
    end)
    return true
end

