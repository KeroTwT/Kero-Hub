local function GetMatchResultText()
    local endScreen = GetEndScreen()
    local candidates = endScreen and endScreen:GetDescendants() or {}
    if endScreen then table.insert(candidates, 1, endScreen) end

    for _, object in ipairs(candidates) do
        if object:IsA("TextLabel") or object:IsA("TextButton") then
            local text = string.lower(tostring(object.Text or ""))
            if text:find("victory", 1, true) or text:find("you won", 1, true) then
                return "Victory"
            end
        end
    end
    for _, object in ipairs(candidates) do
        if object:IsA("TextLabel") or object:IsA("TextButton") then
            local text = string.lower(tostring(object.Text or ""))
            if text:find("defeat", 1, true) or text:find("game over", 1, true) then
                return "Defeat"
            end
        end
    end

    local message = string.lower(GetMatchMessage())
    if message:find("victory", 1, true) then return "Victory" end
    if message:find("defeat", 1, true) then return "Defeat" end
    return "Match Ended"
end

