local function BindMutatorRemote()
    RefreshObjects()
    local remote = Remotes.SlopMutator
    if remote == State.MutatorBoundRemote and State.MutatorConnection
        and State.MutatorConnection.Connected then
        return
    end
    if State.MutatorConnection then
        pcall(function() State.MutatorConnection:Disconnect() end)
        State.MutatorConnection = nil
    end
    State.MutatorBoundRemote = remote
    if not remote or not remote:IsA("RemoteEvent") then return end

    State.MutatorConnection = AddConnection(State.Connections, remote.OnClientEvent:Connect(
        function(action, payload, deadline)
            action = tostring(action or "")
            if action == "Vote" and type(payload) == "table" then
                local offer, discovered = {}, {}
                for _, raw in ipairs(payload) do
                    if type(raw) == "table" then
                        local id = tostring(raw.Id or "")
                        if id ~= "" then
                            local entry = {
                                Id = id,
                                Title = tostring(raw.Title or id),
                                Bad = tostring(raw.Bad or "Unknown drawback"),
                                Good = tostring(raw.Good or "Unknown reward"),
                            }
                            table.insert(offer, entry)
                            local previous = State.MutatorCatalog[id]
                            if not previous or previous.Title ~= entry.Title
                                or previous.Bad ~= entry.Bad or previous.Good ~= entry.Good then
                                State.MutatorCatalog[id] = table.clone(entry)
                                table.insert(discovered, entry.Title)
                            end
                        end
                    end
                end
                State.CurrentMutatorOffer = offer
                State.MutatorVoteSerial = State.MutatorVoteSerial + 1
                State.MutatorLastVoteSerial = -1
                State.MutatorLastVoteId = nil
                State.MutatorVoteDeadline = tonumber(deadline)

                local titles = {}
                for _, entry in ipairs(offer) do table.insert(titles, entry.Title) end
                SetMutatorStatus("Mutator vote open", table.concat(titles, ", "))
                if #discovered > 0 then
                    QueueSave()
                    if RefreshMutatorControls then RefreshMutatorControls() end
                    Notify("New Mutator discovered", table.concat(discovered, ", "))
                end
                task.defer(TryAutoVoteMutator)
            elseif action == "Votes" and type(payload) == "table" then
                local votes = {}
                for id, count in pairs(payload) do
                    count = tonumber(count) or 0
                    if count > 0 then
                        local entry = State.MutatorCatalog[tostring(id)]
                        table.insert(votes, string.format(
                            "%s: %d", entry and entry.Title or tostring(id), count
                        ))
                    end
                end
                table.sort(votes)
                if #votes > 0 then SetMutatorStatus("Vote update", table.concat(votes, " | ")) end
            elseif action == "Active" then
                local id = type(payload) == "table" and tostring(payload.Id or "") or "None"
                if id == "" then id = "None" end
                State.ActiveMutator = id
                State.CurrentMutatorOffer = {}
                State.MutatorVoteDeadline = nil
                local entry = State.MutatorCatalog[id]
                SetMutatorStatus(
                    "Active: " .. tostring(entry and entry.Title or id),
                    entry and string.format("%s | %s", entry.Bad, entry.Good) or ""
                )
            end
        end
    ))
end

