local function FindAntiMacroToken(value, depth)
    depth = depth or 0
    if depth > 4 then return nil end
    if type(value) == "string" then
        if value:match("^[%x]+%-%x+%-%x+%-%x+%-%x+$") then return value end
        return nil
    end
    if type(value) == "table" then
        for _, item in pairs(value) do
            local found = FindAntiMacroToken(item, depth + 1)
            if found then return found end
        end
    end
    return nil
end

