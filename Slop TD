local function MutatorRewardScore(entry)
    local reward = tostring(entry and entry.Good or "")
    local multiplier = tonumber(reward:lower():match("x%s*(%d+%.?%d*)"))
    if multiplier then return math.max(0, (multiplier - 1) * 100) end
    return tonumber(reward:match("%+(%d+%.?%d*)%%")) or 0
end

local function PickMutatorFromOffer()
    local offeredById = {}
    for _, entry in ipairs(State.CurrentMutatorOffer) do
        offeredById[entry.Id] = entry
    end
    if State.MutatorAutoPick == "No Mutator" then
        return offeredById.None and "None" or nil, "No Mutator"
    end

    local selected = {}
    for _, id in ipairs(State.SelectedMutators) do selected[id] = true end
    local best, bestValue
    for index, entry in ipairs(State.CurrentMutatorOffer) do
        if entry.Id ~= "None" and selected[entry.Id] then
            local value = State.MutatorAutoPick == "Highest Reward"
                and -MutatorRewardScore(entry)
                or (tonumber(State.MutatorPriorities[entry.Id]) or 20)
            if best == nil or value < bestValue then
                best, bestValue = entry, value
            elseif value == bestValue then
                local bestPriority = tonumber(State.MutatorPriorities[best.Id]) or 20
                local entryPriority = tonumber(State.MutatorPriorities[entry.Id]) or 20
                if entryPriority < bestPriority or (entryPriority == bestPriority and index < best._OfferIndex) then
                    best, bestValue = entry, value
                end
            end
            entry._OfferIndex = index
        end
    end
    if best then
        return best.Id, State.MutatorAutoPick == "Highest Reward"
            and (best.Good or "Highest reward")
            or ("Priority " .. tostring(State.MutatorPriorities[best.Id] or 20))
    end
    return offeredById.None and "None" or nil, "No selected Mutator was offered"
end

TryAutoVoteMutator = function(force)
    if not State.AutoVoteMutator or #State.CurrentMutatorOffer == 0 then return false end
    if State.MutatorVoteDeadline then
        local ok, serverNow = pcall(Workspace.GetServerTimeNow, Workspace)
        if ok and tonumber(serverNow) and serverNow >= State.MutatorVoteDeadline then
            SetMutatorStatus("Vote closed", "Waiting for the next Mutator offer")
            return false
        end
    end
    RefreshObjects()
    local id, reason = PickMutatorFromOffer()
    if not id then
        SetMutatorStatus("No valid choice", reason)
        return false
    end
    if not force and State.MutatorLastVoteSerial == State.MutatorVoteSerial
        and State.MutatorLastVoteId == id then
        return true
    end
    local ok, failure = Fire(Remotes.SlopMutator, "Vote", id)
    if ok then
        State.MutatorLastVoteSerial = State.MutatorVoteSerial
        State.MutatorLastVoteId = id
        local title = State.MutatorCatalog[id] and State.MutatorCatalog[id].Title or id
        SetMutatorStatus("Vote requested: " .. tostring(title), reason)
        return true
    end
    SetMutatorStatus("Vote failed", tostring(failure))
    return false
end

