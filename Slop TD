local function RefreshActions()
    if not Gui.Actions then return end
    local lines = {}
    local first = math.max(1, #State.Actions - 7)
    for index = first, #State.Actions do
        local action = State.Actions[index]
        table.insert(lines, string.format(
            "%02d | W%s | %s | T%s",
            index,
            tostring(action.Wave or 0),
            tostring(action.Type or "?"),
            tostring(action.Handle or "-")
        ))
    end
    Gui.Actions:SetTitle(string.format("Recorded actions: %d", #State.Actions))
    Gui.Actions:SetDesc(#lines > 0 and table.concat(lines, "\n") or "No actions loaded")
end

local function AddAction(action)
    action.Wave = GetWave()
    action.Time = os.clock() - State.RecordStartedAt
    action.Cash = GetCash()
    table.insert(State.Actions, action)
    RefreshActions()
    SetStatus("Recording", string.format("Captured %s at wave %d", action.Type, action.Wave))
end

local function AttachTower(tower, recordPlacement)
    if not tower or State.TowerMeta[tower] then return end
    local owned = WaitUntil(function()
        return not tower.Parent or IsOwnTower(tower)
    end, 3, 0.05)
    if not owned or not tower.Parent or not IsOwnTower(tower) then return end

    local handle = State.NextHandle
    State.NextHandle = State.NextHandle + 1
    local cframe = GetTowerCFrame(tower)
    local meta = {
        Handle = handle,
        Level = GetTowerLevel(tower),
        Target = GetTargetMode(tower),
        NextPrice = GetNextUpgradePrice(tower),
        LastUpgradeAt = -math.huge,
        Removed = false,
    }
    State.TowerMeta[tower] = meta

    if recordPlacement and State.Recording and cframe then
        local variantUnit = GetTowerName(tower)
        AddAction({
            Type = "Place",
            Handle = handle,
            Unit = variantUnit,
            BaseUnit = ResolveBaseUnitName(variantUnit),
            Variant = DetectUnitVariant(variantUnit),
            Cost = GetTowerCost(tower),
            CFrame = CFrameToArray(cframe),
        })
    end

    local config = GetConfig(tower)
    local level = config and config:FindFirstChild("LVL")
    local target = config and config:FindFirstChild("TargetMode")

    if level and level:IsA("ValueBase") then
        AddConnection(State.RecorderConnections, level.Changed:Connect(function()
            local newLevel = tonumber(level.Value) or meta.Level
            if State.Recording and newLevel > meta.Level then
                for expected = meta.Level + 1, newLevel do
                    AddAction({
                        Type = "Upgrade",
                        Handle = meta.Handle,
                        Unit = GetTowerName(tower),
                        BaseUnit = ResolveBaseUnitName(GetTowerName(tower)),
                        Variant = DetectUnitVariant(GetTowerName(tower)),
                        PreviousLevel = expected - 1,
                        Level = expected,
                        Cost = meta.NextPrice,
                    })
                end
                meta.LastUpgradeAt = os.clock()
            end
            meta.Level = newLevel
            task.defer(function()
                if tower.Parent then meta.NextPrice = GetNextUpgradePrice(tower) end
            end)
        end))
    end

    if target and target:IsA("ValueBase") then
        AddConnection(State.RecorderConnections, target.Changed:Connect(function()
            local newMode = tostring(target.Value)
            local automaticUpgradeChange = os.clock() - meta.LastUpgradeAt < 0.8
            if State.Recording and newMode ~= meta.Target and not automaticUpgradeChange
                and newMode ~= "" and newMode ~= "N/A" then
                AddAction({
                    Type = "Target",
                    Handle = meta.Handle,
                    Unit = GetTowerName(tower),
                    PreviousMode = meta.Target,
                    Mode = newMode,
                })
            end
            meta.Target = newMode
        end))
    end

    AddConnection(State.RecorderConnections, tower:GetAttributeChangedSignal("NextUpgradePrice"):Connect(function()
        task.defer(function()
            if tower.Parent then meta.NextPrice = GetNextUpgradePrice(tower) end
        end)
    end))

    AddConnection(State.RecorderConnections, tower.AncestryChanged:Connect(function(_, parent)
        if parent == nil and not meta.Removed then
            meta.Removed = true
            if State.Recording and IsGameRunning() then
                AddAction({ Type = "Sell", Handle = meta.Handle, Unit = GetTowerName(tower) })
            end
        end
    end))
end

local function StartRecorderWatcher()
    RefreshObjects()
    DisconnectAll(State.RecorderConnections)
    State.TowerMeta = setmetatable({}, { __mode = "k" })
    State.NextHandle = 1
    if not TowersFolder then return false, "Workspace.Towers was not found" end
    for _, tower in ipairs(TowersFolder:GetChildren()) do
        AttachTower(tower, false)
    end
    AddConnection(State.RecorderConnections, TowersFolder.ChildAdded:Connect(function(tower)
        task.defer(AttachTower, tower, true)
    end))
    return true
end

local function StartRecording(name)
    if State.Playing then return false, "Playback is running" end
    name = SanitizeName(name or State.ProfileName)
    if name == "" then return false, "Create or select a macro first" end
    RefreshObjects()
    if not TowersFolder then return false, "Join a match before recording" end
    for _, tower in ipairs(TowersFolder:GetChildren()) do
        if IsOwnTower(tower) then
            return false, "Start recording before placing the first tower"
        end
    end
    State.Actions = {}
    State.ProfileName = name
    State.RecordStartedAt = os.clock()
    State.Recording = true
    local ok, reason = StartRecorderWatcher()
    if not ok then
        State.Recording = false
        return false, reason
    end
    RefreshActions()
    SetStatus("Recording", name .. " | waiting for the first placement")
    return true
end

local function StopRecording(save)
    State.Recording = false
    DisconnectAll(State.RecorderConnections)
    if save then
        local ok, reason = SaveProfile(State.ProfileName)
        if not ok then
            SetStatus("Save failed", tostring(reason))
            return false, reason
        end
    end
    SetStatus("Recorded", string.format("%s | %d actions", State.ProfileName, #State.Actions))
    return true
end

local function Invoke(remote, ...)
    if not remote or not remote:IsA("RemoteFunction") then
        return false, "Required RemoteFunction is missing"
    end
    local packed = table.pack(pcall(remote.InvokeServer, remote, ...))
    if not packed[1] then return false, packed[2] end
    return true, table.unpack(packed, 2, packed.n)
end

local function Fire(remote, ...)
    if not remote or not remote:IsA("RemoteEvent") then
        return false, "Required RemoteEvent is missing"
    end
    local ok, reason = pcall(remote.FireServer, remote, ...)
    return ok, reason
end

local function IsDiscordWebhookURL(value)
    local url = tostring(value or "")
    return url:match("^https://discord%.com/api/webhooks/") ~= nil
        or url:match("^https://discordapp%.com/api/webhooks/") ~= nil
end

local function GetRequestFunction()
    return http_request or request or (syn and syn.request) or (fluxus and fluxus.request)
end

local function SendDiscordWebhook(title, description, color, fields, imageURL, footerIconURL)
    if not State.WebhookEnabled then
        return false, "Webhook is disabled"
    end
    if not IsDiscordWebhookURL(State.WebhookURL) then
        return false, "Enter a valid Discord webhook URL"
    end

    local requestFunction = GetRequestFunction()
    if type(requestFunction) ~= "function" then
        return false, "This executor does not support HTTP requests"
    end

    local embed = {
        title = tostring(title or "Slop TD Hub"),
        description = tostring(description or ""),
        color = tonumber(color) or 5793266,
        fields = type(fields) == "table" and fields or nil,
        footer = {
            text = "Made By Kero",
            icon_url = footerIconURL,
        },
        timestamp = DateTime.now():ToIsoDate(),
    }
    if imageURL and imageURL ~= "" then
        embed.image = { url = imageURL }
    end
    local payload = {
        username = "Slop TD Hub",
        embeds = { embed },
    }
    local ok, response = pcall(function()
        return requestFunction({
            Url = State.WebhookURL,
            Method = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body = HttpService:JSONEncode(payload),
        })
    end)
    if not ok then return false, tostring(response) end

    if type(response) == "table" then
        local statusCode = tonumber(response.StatusCode or response.Status)
        if response.Success == false or (statusCode and (statusCode < 200 or statusCode >= 300)) then
            return false, "Discord returned HTTP " .. tostring(statusCode or "error")
        end
    end
    return true
end

local function SendMatchEndWebhook()
    if not State.WebhookEnabled or not State.WebhookMatchEnd then
        return false, "Match notifications are disabled"
    end

    local result = GetMatchResultText()
    local color = result == "Victory" and 65280
        or result == "Defeat" and 16711680
        or 16776960
