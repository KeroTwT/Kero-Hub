local function SanitizeName(name)
    name = tostring(name or ""):gsub("[^%w%-%_]", "_"):gsub("_+", "_")
    return name:sub(1, 48)
end

local function CFrameToArray(value)
    return { value:GetComponents() }
end

local function ArrayToCFrame(value)
    if type(value) ~= "table" or #value < 12 then return nil end
    return CFrame.new(table.unpack(value, 1, 12))
end

local function ProfilePath(name)
    return MacroFolder .. "/" .. SanitizeName(name) .. ".json"
end

local function ValidateActions(actions)
    if type(actions) ~= "table" then return false, "Actions must be a table" end
    local seenHandles = {}
    local liveHandles = {}
    for index, action in ipairs(actions) do
        if type(action) ~= "table" then
            return false, string.format("Action %d is not a table", index)
        end
        local kind = tostring(action.Type or "")
        local handle = tostring(action.Handle or "")
        if kind == "Place" then
            if handle == "" or seenHandles[handle] then
                return false, string.format("Action %d has an invalid/duplicate tower handle", index)
            end
            if tostring(action.Unit or "") == "" or not ArrayToCFrame(action.CFrame) then
                return false, string.format("Action %d has invalid placement data", index)
            end
            seenHandles[handle] = true
            liveHandles[handle] = true
        elseif kind == "Upgrade" or kind == "Target" or kind == "Sell" then
            if not liveHandles[handle] then
                return false, string.format("Action %d references an unknown tower handle", index)
            end
            if kind == "Upgrade" and (tonumber(action.Level) or 0) < 1 then
                return false, string.format("Action %d has an invalid upgrade level", index)
            end
            if kind == "Target" and tostring(action.Mode or "") == "" then
                return false, string.format("Action %d has an invalid target mode", index)
            end
            if kind == "Sell" then liveHandles[handle] = nil end
        else
            return false, string.format("Action %d has unknown type %s", index, kind)
        end
    end
    return true
end

local function WriteVerifiedJson(path, payload)
    local encodedOk, encoded = pcall(HttpService.JSONEncode, HttpService, payload)
    if not encodedOk then return false, encoded end

    local pending = path .. ".pending"
    local backup = path .. ".bak"
    local wrotePending, pendingReason = pcall(writefile, pending, encoded)
    if not wrotePending then return false, pendingReason end

    local verifiedPending, pendingDecoded = pcall(function()
        return HttpService:JSONDecode(readfile(pending))
    end)
    if not verifiedPending or type(pendingDecoded) ~= "table" then
        return false, "Pending file verification failed"
    end

    if isfile(path) then
        local oldOk, oldContent = pcall(readfile, path)
        if oldOk and type(oldContent) == "string" then
            pcall(writefile, backup, oldContent)
        end
    end

    local wroteFinal, finalReason = pcall(writefile, path, encoded)
    if not wroteFinal then return false, finalReason end
    local verifiedFinal, finalDecoded = pcall(function()
        return HttpService:JSONDecode(readfile(path))
    end)
    if not verifiedFinal or type(finalDecoded) ~= "table"
        or tonumber(finalDecoded.ActionCount) ~= #payload.Actions then
        return false, "Final file verification failed; backup was preserved"
    end
    if type(delfile) == "function" then pcall(delfile, pending) end
    return true
end

local function ListProfiles()
    if not HasFilesystem or type(listfiles) ~= "function" then return {} end
    local result = {}
    for _, path in ipairs(listfiles(MacroFolder)) do
        local name = tostring(path):match("([^\\/]+)%.json$")
        if name and name ~= "Settings" then table.insert(result, name) end
    end
    table.sort(result)
    return result
end

local function SaveProfile(name)
    name = SanitizeName(name)
    if name == "" then return false, "Macro name is empty" end
    if not HasFilesystem then return false, "Executor filesystem APIs are unavailable" end
    local valid, validationReason = ValidateActions(State.Actions)
    if not valid then return false, validationReason end
    local payload = {
        Version = 3,
        Game = "Slop TD",
        PlaceId = game.PlaceId,
        Name = name,
        RecordedAt = os.time(),
        ActionCount = #State.Actions,
        Actions = State.Actions,
    }
    local wrote, reason = WriteVerifiedJson(ProfilePath(name), payload)
    if not wrote then return false, reason end
    State.ProfileName = name
    State.ProfilePlaceId = game.PlaceId
    return true
end

local function LoadProfile(name)
    name = SanitizeName(name)
    local path = ProfilePath(name)
    if name == "" or not HasFilesystem or (not isfile(path) and not isfile(path .. ".bak")) then
        return false, "Macro was not found"
    end
    local decoded
    local lastReason = "Invalid macro file"
    for _, candidate in ipairs({ path, path .. ".bak" }) do
        if isfile(candidate) then
            local ok, value = pcall(function()
                return HttpService:JSONDecode(readfile(candidate))
            end)
            if ok and type(value) == "table" and type(value.Actions) == "table" then
                local valid, validationReason = ValidateActions(value.Actions)
                if valid then
                    decoded = value
                    break
                end
                lastReason = validationReason
            end
        end
    end
    if not decoded then return false, lastReason end
    for _, action in ipairs(decoded.Actions) do
        if action.Type == "Place" or action.Type == "Upgrade" then
            action.BaseUnit = ResolveBaseUnitName(action.Unit, action.BaseUnit)
            action.Variant = DetectUnitVariant(action.Unit, action.Variant)
        end
    end
    State.Actions = decoded.Actions
    State.ProfileName = name
    State.ProfilePlaceId = tonumber(decoded.PlaceId)
    return true
end

