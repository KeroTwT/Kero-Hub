    end
    merge(DEFAULT_MUTATORS)
    merge(source)
    return catalog
end

local function LoadMutatorSelection(source)
    local selected, seen = {}, {}
    if type(source) ~= "table" then return selected end
    for key, value in pairs(source) do
        local id
        if type(key) == "number" and type(value) == "string" then
            id = value
        elseif type(key) == "string" and value == true then
            id = key
        end
        id = id and tostring(id) or nil
        if id and id ~= "" and not seen[id] then
            seen[id] = true
            table.insert(selected, id)
        end
    end
    return selected
end

