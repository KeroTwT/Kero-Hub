local Crates = Hub.Crates

function Crates.ParseCompactNumber(value)
    local text = tostring(value or ""):upper():gsub(",", ""):gsub("%s", "")
    local number, suffix = text:match("^([%d%.]+)([KMB]?)$")
    number = tonumber(number)
    if not number then return nil end
    local multipliers = { K = 1e3, M = 1e6, B = 1e9 }
    return number * (multipliers[suffix] or 1)
end

function Crates.NormalizeCurrency(value)
    local text = tostring(value or ""):lower()
    if text:find("slopbux", 1, true) then return "Slopbux" end
    if text:find("sheckle", 1, true) then return "Sheckles" end
    if text:find("gem", 1, true) then return "Gems" end
    if text:find("star", 1, true) then return "Stars" end
    return nil
end

function Crates.ReadPrice(title)
    if not title or not (title:IsA("TextLabel") or title:IsA("TextButton")) then return nil, nil end
    local amountText, currencyText = tostring(title.Text or ""):match("^%s*([%d%.,]+%s*[KMBkmb]?)%s+(.+)%s*$")
    return Crates.ParseCompactNumber(amountText), Crates.NormalizeCurrency(currencyText)
end

function Crates.Discover()
    local catalog = {}
    for name, entry in pairs(Crates.Fallback) do
        catalog[name] = {
            Name = name,
            Currency = entry.Currency,
            BasePrice = entry.BasePrice,
            Prices = {},
        }
    end

    local playerGui = LocalPlayer and LocalPlayer:FindFirstChildOfClass("PlayerGui")
    local main = playerGui and playerGui:FindFirstChild("Main")
    local shop = main and main:FindFirstChild("Shop")
    local list = shop and shop:FindFirstChild("List")
    local scrolling = list and list:FindFirstChild("ScrollingFrame")
    if scrolling then
        for _, frame in ipairs(scrolling:GetChildren()) do
            local actions = frame:FindFirstChild("Actions")
            if actions then
                local title = frame:FindFirstChild("Title")
                local name = title and title:IsA("TextLabel") and tostring(title.Text) or frame.Name
                if name ~= "" and name:lower():find("crate", 1, true) then
                    local entry = catalog[name] or { Name = name, Prices = {} }
                    entry.Prices = entry.Prices or {}
                    for _, amount in ipairs({ 1, 3, 10, 25, 50 }) do
                        local button = actions:FindFirstChild(tostring(amount))
                        local price, currency = Crates.ReadPrice(button and button:FindFirstChild("Title"))
                        if price then entry.Prices[amount] = price end
                        if currency then entry.Currency = currency end
                    end
                    if not entry.BasePrice and entry.Prices[1] then entry.BasePrice = entry.Prices[1] end
                    if entry.Currency then catalog[name] = entry end
                end
            end
        end
    end
    Crates.Catalog = catalog
    return catalog
end

function Crates.Label(name)
    local entry = Crates.Catalog[tostring(name)] or Crates.Fallback[tostring(name)]
    return entry and string.format("%s [%s]", tostring(name), tostring(entry.Currency)) or tostring(name)
end

