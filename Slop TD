                RefreshProfiles(State.ProfileName)
                Notify("Macro saved", string.format("%s | %d actions", State.ProfileName, #State.Actions))
            else
                Notify("Auto-save failed", tostring(reason))
            end
        end
        recordingFinalizePending = false
    end)
end
task.spawn(function()
    while State.Running do
        RefreshObjects()
        local running = IsGameRunning()
        local active = running and GetWave() >= 1
        local mapVoting = IsMapVoting()
        local complicationVoting = IsComplicationVoting()
        local currentEndScreenVisible = IsEndScreenVisible()

        if mapVoting and not lastMapVoting then votedMap = false end
        if complicationVoting and not lastComplicationVoting then votedComplication = false end

        if active and not lastMatchActive then
            State.MatchSerial = State.MatchSerial + 1
            State.PlaybackSerial = -1
            State.FirstPlaybackActionDone = false
            matchEndedAt = nil
        elseif not active and lastMatchActive then
            State.Playing = false
            State.RuntimeHandles = {}
            matchEndedAt = os.clock()
        end

        if currentEndScreenVisible and not endScreenVisible then
            endScreenShownAt = os.clock()
            endActionSent = false
            webhookSent = false
            webhookPending = false
        elseif not currentEndScreenVisible then
            endScreenShownAt = nil
            endActionSent = false
            webhookSent = false
            webhookPending = false
        elseif not endScreenShownAt then
            endScreenShownAt = matchEndedAt or os.clock()
        end
        if currentEndScreenVisible then
            FinalizeRecordingAtMatchEnd()
        end
        endScreenVisible = currentEndScreenVisible
        lastMatchActive = active
        lastMapVoting = mapVoting
        lastComplicationVoting = complicationVoting

        if active and State.PlaybackEnabled and not State.Playing
            and State.PlaybackSerial ~= State.MatchSerial and #State.Actions > 0 then
            StartPlayback()
        end

        local automationReady = not State.PlaybackEnabled or State.FirstPlaybackActionDone
        if active and automationReady then
            if State.AutoSkip and Remotes.Skip and IsSkipAvailable()
                and os.clock() - lastSkipRequest >= 1.5 then
                lastSkipRequest = os.clock()
                task.spawn(function() Invoke(Remotes.Skip) end)
            end
            if State.AutoSpeed and Remotes.Speed and GetSpeed() ~= State.Speed
                and os.clock() - lastSpeedRequest >= 1 then
                lastSpeedRequest = os.clock()
                task.spawn(function()
                    local ok, accepted = Invoke(Remotes.Speed, State.Speed)
                    if not ok or accepted == false then
                        SetStatus("Speed rejected", tostring(accepted))
                    end
                end)
            end
        end

        if mapVoting and State.AutoVoteMap and not votedMap and Remotes.VoteMap then
            local ok = Fire(Remotes.VoteMap, State.SelectedMap)
            votedMap = ok
        end
        if complicationVoting and State.AutoVoteComplication
            and not votedComplication and Remotes.VoteComplication then
            local ok = Fire(Remotes.VoteComplication, State.Complication)
            votedComplication = ok
        end

        if currentEndScreenVisible and State.WebhookEnabled
            and State.WebhookMatchEnd and not webhookSent then
            webhookSent = true
            webhookPending = true
            webhookStartedAt = os.clock()
            task.spawn(function()
                local ok, reason = SendMatchEndWebhook()
                webhookPending = false
                if not ok and State.Running then
                    SetStatus("Webhook failed", tostring(reason))
                end
            end)
        end

        if State.EndAction ~= "None" and endScreenShownAt and not endActionSent
            and os.clock() - endScreenShownAt >= 1.5
            and (not webhookPending or os.clock() - webhookStartedAt >= 5) then
            local ok, reason
            if State.EndAction == "Replay" then
                ok, reason = Fire(Remotes.EndDecision, true)
            elseif State.EndAction == "New Map" then
                ok, reason = Fire(Remotes.EndDecision, "new")
            elseif State.EndAction == "Return Lobby" then
                ok, reason = Fire(Remotes.ExitGame)
            end
            if ok then
                endActionSent = true
                SetStatus("End action sent", State.EndAction)
            elseif reason then
                SetStatus("End action unavailable", tostring(reason))
            end
        end

        if Gui.Runtime then
            local phase = active and "Live match"
                or complicationVoting and "Difficulty voting"
                or mapVoting and "Chapter voting"
                or running and "Starting"
                or "Waiting"
            Gui.Runtime:SetTitle(State.Playing and (phase .. " - " .. State.PlaybackMode) or phase)
            Gui.Runtime:SetDesc(string.format(
                "Wave %s | Money %s | Towers %s | Speed x%s | %s",
                tostring(GetWave()), tostring(GetCash()),
                tostring(LocalPlayer:FindFirstChild("PlacedTowers") and LocalPlayer.PlacedTowers.Value or "?"),
                tostring(GetSpeed()), GetMatchMessage()
            ))
        end
        task.wait(0.75)
    end
end)

function Hub.Destroy()
    if not State.Running then return end
    State.Running = false
    State.Recording = false
    State.Playing = false
    DisconnectAll(State.RecorderConnections)
    DisconnectAll(State.Connections)
    SaveConfig()
    pcall(function() Window:Destroy() end)
    if Environment.SlopTDHub == Hub then Environment.SlopTDHub = nil end
end

Hub.State = State
Hub.StartRecording = StartRecording
Hub.StopRecording = StopRecording
Hub.StartPlayback = StartPlayback
Hub.StopPlayback = StopPlayback
Hub.SaveProfile = SaveProfile
Hub.LoadProfile = LoadProfile
Hub.ListProfiles = ListProfiles

if State.ProfileName ~= "" then
    local loaded = LoadProfile(State.ProfileName)
    if not loaded then State.ProfileName = "" end
end
RefreshActions()
if State.ProfileName ~= "" then
    SetStatus("Loaded", string.format("%s | %d actions", State.ProfileName, #State.Actions))
else
    SetStatus("Idle", "Create a macro, then start recording before placing a tower")
end

print("Slop TD Hub loaded. RightShift toggles the UI.")
