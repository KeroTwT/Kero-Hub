local function SaveAndSetPerformanceProperty(instance, property, value)
    if not instance then return false end
    local originals = State.FpsOriginals[instance]
    if not originals then
        originals = {}
        State.FpsOriginals[instance] = originals
    end
    if originals[property] == nil then
        local readOk, original = pcall(function() return instance[property] end)
        if not readOk then return false end
        originals[property] = original
    end
    return pcall(function() instance[property] = value end)
end

local function OptimizePerformanceObject(object)
    if not State.FpsBoost or not object then return end
    if object:IsA("ParticleEmitter") or object:IsA("Trail") or object:IsA("Beam")
        or object:IsA("Smoke") or object:IsA("Fire") or object:IsA("Sparkles")
        or object:IsA("PostEffect") then
        SaveAndSetPerformanceProperty(object, "Enabled", false)
    elseif object:IsA("BasePart") then
        SaveAndSetPerformanceProperty(object, "CastShadow", false)
        if object:IsA("MeshPart") then
            SaveAndSetPerformanceProperty(object, "RenderFidelity", Enum.RenderFidelity.Performance)
        end
    end
end

local function DisconnectFpsBoostWatchers()
    if State.FpsBoostConnection then
        pcall(function() State.FpsBoostConnection:Disconnect() end)
        State.FpsBoostConnection = nil
    end
    if State.FpsBoostLightingConnection then
        pcall(function() State.FpsBoostLightingConnection:Disconnect() end)
        State.FpsBoostLightingConnection = nil
    end
end

local function RestoreFpsBoost()
    DisconnectFpsBoostWatchers()
    State.FpsBoostSerial = State.FpsBoostSerial + 1
    for instance, properties in pairs(State.FpsOriginals) do
        if instance then
            for property, value in pairs(properties) do
                pcall(function() instance[property] = value end)
            end
        end
    end
    State.FpsOriginals = setmetatable({}, { __mode = "k" })
end

local function SetFpsBoost(enabled)
    enabled = enabled == true
    if not enabled then
        State.FpsBoost = false
        RestoreFpsBoost()
        SetPerformanceStatus("FPS Boost disabled", "Original effects and shadows restored")
        return true
    end

    State.FpsBoost = true
    State.FpsBoostSerial = State.FpsBoostSerial + 1
    local serial = State.FpsBoostSerial
    DisconnectFpsBoostWatchers()
    SaveAndSetPerformanceProperty(Lighting, "GlobalShadows", false)
    SaveAndSetPerformanceProperty(Lighting, "EnvironmentDiffuseScale", 0)
    SaveAndSetPerformanceProperty(Lighting, "EnvironmentSpecularScale", 0)
    SaveAndSetPerformanceProperty(Lighting, "ShadowSoftness", 0)
    local terrain = Workspace:FindFirstChildOfClass("Terrain")
    if terrain then
        SaveAndSetPerformanceProperty(terrain, "Decoration", false)
        SaveAndSetPerformanceProperty(terrain, "WaterWaveSize", 0)
        SaveAndSetPerformanceProperty(terrain, "WaterWaveSpeed", 0)
        SaveAndSetPerformanceProperty(terrain, "WaterReflectance", 0)
    end

    State.FpsBoostConnection = Workspace.DescendantAdded:Connect(function(object)
        task.defer(OptimizePerformanceObject, object)
    end)
    State.FpsBoostLightingConnection = Lighting.DescendantAdded:Connect(function(object)
        task.defer(OptimizePerformanceObject, object)
    end)
    task.spawn(function()
        local objects = Workspace:GetDescendants()
        for _, object in ipairs(Lighting:GetDescendants()) do table.insert(objects, object) end
        for index, object in ipairs(objects) do
            if not State.FpsBoost or State.FpsBoostSerial ~= serial then return end
            OptimizePerformanceObject(object)
            if index % 250 == 0 then task.wait() end
        end
        if State.FpsBoost and State.FpsBoostSerial == serial then
            SetPerformanceStatus("FPS Boost enabled", string.format("Optimized %d objects", #objects))
        end
    end)
    SetPerformanceStatus("FPS Boost enabling", "Disabling effects, shadows and post-processing")
    return true
end

