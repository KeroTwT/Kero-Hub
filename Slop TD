local function ResolvePlayElevator(playerCount)
    local elevators = Workspace:FindFirstChild("Elevators")
    if elevators then
        for _, elevator in ipairs(elevators:GetChildren()) do
            local maxPlayers = tonumber(elevator:GetAttribute("MaxPlayers"))
            local isRaid = tostring(elevator:GetAttribute("IsRaid")):lower() == "true"
            if elevator:IsA("Model") and maxPlayers == playerCount and not isRaid then
                return elevator.Name
            end
        end
    end
    return ElevatorByPlayers[playerCount]
end

local function GetElevatorStandPosition(elevator)
    if not elevator then return nil end
    local bestPart
    local bestScore = -math.huge
    for _, object in ipairs(elevator:GetDescendants()) do
        if object:IsA("BasePart") then
            local size = object.Size
            local cframe = object.CFrame
            local worldX = math.abs(cframe.RightVector.X) * size.X
                + math.abs(cframe.UpVector.X) * size.Y
                + math.abs(cframe.LookVector.X) * size.Z
            local worldY = math.abs(cframe.RightVector.Y) * size.X
                + math.abs(cframe.UpVector.Y) * size.Y
                + math.abs(cframe.LookVector.Y) * size.Z
            local worldZ = math.abs(cframe.RightVector.Z) * size.X
                + math.abs(cframe.UpVector.Z) * size.Y
                + math.abs(cframe.LookVector.Z) * size.Z
            local score = (worldX * worldZ) / math.max(worldY, 0.2)
            local lowerName = object.Name:lower()
            if lowerName:find("pad", 1, true) or lowerName:find("circle", 1, true)
                or lowerName:find("teleport", 1, true) or lowerName:find("floor", 1, true) then
                score = score * 4
            end
            if score > bestScore then
                bestScore = score
                bestPart = object
            end
        end
    end
    if bestPart then
        local size = bestPart.Size
        local cframe = bestPart.CFrame
        local worldY = math.abs(cframe.RightVector.Y) * size.X
            + math.abs(cframe.UpVector.Y) * size.Y
            + math.abs(cframe.LookVector.Y) * size.Z
        return bestPart.Position + Vector3.new(0, worldY * 0.5 + 3, 0)
    end
    local boxCFrame, boxSize = elevator:GetBoundingBox()
    return Vector3.new(
        elevator:GetPivot().Position.X,
        boxCFrame.Position.Y - boxSize.Y * 0.5 + 3,
        elevator:GetPivot().Position.Z
    )
end

local function MoveIntoElevator(elevator)
    local character = LocalPlayer.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local position = GetElevatorStandPosition(elevator)
    if not root or not position then return false end
    root.CFrame = CFrame.new(position) * root.CFrame.Rotation
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero
    return true, position
end

local function IsPlayerInElevator(elevator)
    if not elevator then return false end
    local ids = tostring(elevator:GetAttribute("PlayerUserIds") or "")
    return (tonumber(elevator:GetAttribute("Players")) or 0) > 0
        and ids:find(tostring(LocalPlayer.UserId), 1, true) ~= nil
end

