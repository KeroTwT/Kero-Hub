local function FinalizeRecordingAtMatchEnd()
    if not State.Recording or recordingFinalizePending then return end
    recordingFinalizePending = true
    task.spawn(function()
        -- Let any final replicated tower changes already queued this frame reach the recorder.
        task.wait(0.2)
