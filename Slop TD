local function GetTowerTemplate(unitName)
    local folder = ReplicatedStorage:FindFirstChild("Towers")
    if not folder then return nil end
    return folder:FindFirstChild(tostring(unitName))
        or folder:FindFirstChild(ResolveBaseUnitName(unitName))
end

local function GetTemplateBottomOffset(unitName)
    local template = GetTowerTemplate(unitName)
    if not template or not template:IsA("Model") then return 0 end
    local ok, pivot, boxCFrame, boxSize = pcall(function()
        return template:GetPivot(), template:GetBoundingBox()
    end)
    if not ok then return 0 end
    return pivot.Position.Y - (boxCFrame.Position.Y - boxSize.Y * 0.5)
end

local function GetPlacementCandidate(unitName)
    local center = GetPlacementNodePosition()
    if not center then return nil, "Waiting for the map waypoint route" end
    local attempt = tonumber(State.PlacementAttempt) or 0
    local routes = State.PlacementRoutes or {}
    if #routes > 1 then
        local route = routes[(attempt % #routes) + 1]
        center = InterpolateRoute(route, State.RoutePercent) or center
    end
    local radius = math.min(State.PlacementRadius, State.PlacementSpacing * math.sqrt(attempt + 1))
    local angle = attempt * 2.399963229728653
    local x = center.X + math.cos(angle) * radius
    local z = center.Z + math.sin(angle) * radius
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {
        LocalPlayer.Character,
        TowersFolder,
        State.PlacementVisual,
    }
    local hit = Workspace:Raycast(Vector3.new(x, center.Y + 100, z), Vector3.new(0, -250, 0), params)
    if not hit then return nil, "No map surface under this point" end

    RefreshObjects()
    if TowersFolder then
        for _, tower in ipairs(TowersFolder:GetChildren()) do
            local pivot = GetTowerCFrame(tower)
            if pivot then
                local flatDistance = (Vector2.new(pivot.Position.X, pivot.Position.Z)
                    - Vector2.new(hit.Position.X, hit.Position.Z)).Magnitude
                if flatDistance < State.PlacementSpacing then
                    return nil, "Point is too close to another tower"
                end
            end
        end
    end
    local y = hit.Position.Y + GetTemplateBottomOffset(unitName)
    return CFrame.new(hit.Position.X, y, hit.Position.Z)
end

local function UnitNamesMatch(left, right)
    left, right = tostring(left or ""), tostring(right or "")
    if left == "" or right == "" then return false end
    if left == right then return true end
    return ResolveBaseUnitName(left) == ResolveBaseUnitName(right)
end

local function GetTowerLoadoutSlot(tower)
    local towerName = GetTowerName(tower)
    for slot = 1, 6 do
        if towerName == GetLoadoutUnit(slot) then return slot end
    end
    for slot = 1, 6 do
        if UnitNamesMatch(towerName, GetLoadoutUnit(slot)) then return slot end
    end
    return nil
end

local function GetPrioritySlots(priorities)
    local slots = { 1, 2, 3, 4, 5, 6 }
    table.sort(slots, function(a, b)
        local aPriority = tonumber(priorities[a]) or a
        local bPriority = tonumber(priorities[b]) or b
        return aPriority == bPriority and a < b or aPriority < bPriority
    end)
    return slots
end

local function CountPlacedBySlot()
    local counts = { 0, 0, 0, 0, 0, 0 }
    RefreshObjects()
    if not TowersFolder then return counts end
    for _, tower in ipairs(TowersFolder:GetChildren()) do
        if IsOwnTower(tower) then
            local slot = GetTowerLoadoutSlot(tower)
            if slot then counts[slot] = counts[slot] + 1 end
        end
    end
    return counts
end

local function FindPlacementSlot()
    local counts = CountPlacedBySlot()
    for _, slot in ipairs(GetPrioritySlots(State.PlaceSlotPriority)) do
        local unit = GetLoadoutUnit(slot)
        local maximum = tonumber(State.PlaceSlotMax[slot]) or 1
        if unit ~= "" and counts[slot] < maximum then
            return slot, unit, counts[slot], maximum
        end
    end
    return nil
end

local function TryAutoPlace()
    if not State.AutoPlace then return false, "disabled" end
    if GetWave() < State.PlacementWave then return false, "wave" end
    local slot, variantUnit, placedCount, maximum = FindPlacementSlot()
    if not slot then
        if Gui.PlacementNode then Gui.PlacementNode:SetDesc("All equipped slots reached Max Placement") end
        return false, "complete"
    end
    local baseUnit = ResolveBaseUnitName(variantUnit)
    if baseUnit == "" then return false, "unit" end
    local cframe, pointReason = GetPlacementCandidate(variantUnit)
    if not cframe then
        State.PlacementAttempt = (tonumber(State.PlacementAttempt) or 0) + 1
        if Gui.PlacementNode then Gui.PlacementNode:SetDesc("Slot " .. slot .. " | " .. tostring(pointReason)) end
        return false, "point"
    end

    local price = GetValue(GetConfig(GetTowerTemplate(baseUnit)), "Price", 0)
    if tonumber(price) and tonumber(price) > GetCash() then return false, "money" end
    local before = {}
    if TowersFolder then
        for _, tower in ipairs(TowersFolder:GetChildren()) do before[tower] = true end
    end
    local ok, accepted, metadata = Invoke(Remotes.Request, { variantUnit, baseUnit }, false, true)
    if not ok or accepted == false then
        if Gui.PlacementNode then Gui.PlacementNode:SetDesc("Slot " .. slot .. " | RequestTower rejected " .. variantUnit) end
        return false, "request"
    end
    if type(metadata) ~= "table" then metadata = {} end
    task.wait(0.05)
    local placedOk, spawned = Invoke(Remotes.Place, baseUnit, cframe, false, variantUnit, metadata)
    if not placedOk or spawned == false then
        State.PlacementAttempt = (tonumber(State.PlacementAttempt) or 0) + 1
        if Gui.PlacementNode then Gui.PlacementNode:SetDesc("Searching for a valid point inside the range") end
        return false, "position"
    end
    local tower = typeof(spawned) == "Instance" and spawned or nil
    if not tower or not tower.Parent or not IsOwnTower(tower) then
        tower = FindNewTower(before, variantUnit, cframe)
    end
    if not tower then
        if Gui.PlacementNode then Gui.PlacementNode:SetDesc("SpawnTower returned without a confirmed tower") end
        return false, "unconfirmed"
    end
    State.PlacementAttempt = (tonumber(State.PlacementAttempt) or 0) + 1
    if Gui.PlacementNode then
        Gui.PlacementNode:SetDesc(string.format("Slot %d | %s | %d/%d placed",
            slot, variantUnit, placedCount + 1, maximum))
    end
    return true
end

local function HasNextUpgrade(tower)
    local config = GetConfig(tower)
    local upgrade = config and config:FindFirstChild("Upgrade")
    if upgrade and upgrade:IsA("ObjectValue") and upgrade.Value then return true end
    return GetNextUpgradePrice(tower) > 0
end

local function FindUpgradeCandidate()
    RefreshObjects()
    if not TowersFolder then return nil end
    local bySlot = { {}, {}, {}, {}, {}, {} }
    for _, tower in ipairs(TowersFolder:GetChildren()) do
        if IsOwnTower(tower) and not State.AutoPlayMaxed[tower] then
            local slot = GetTowerLoadoutSlot(tower)
            local level = GetTowerLevel(tower)
            if not HasNextUpgrade(tower) then
                State.AutoPlayMaxed[tower] = true
            elseif slot and level < (tonumber(State.UpgradeSlotMax[slot]) or 10) then
                table.insert(bySlot[slot], tower)
            end
        end
    end
    for _, slot in ipairs(GetPrioritySlots(State.UpgradeSlotPriority)) do
        local candidates = bySlot[slot]
        if #candidates > 0 then
            table.sort(candidates, function(a, b)
                local aLevel, bLevel = GetTowerLevel(a), GetTowerLevel(b)
                if aLevel ~= bLevel then return aLevel < bLevel end
                return GetNextUpgradePrice(a) < GetNextUpgradePrice(b)
            end)
            return candidates[1], slot
        end
    end
    return nil
end

local function TryAutoUpgrade()
    if not State.AutoUpgrade or GetWave() < State.UpgradeWave then return false, "wave" end
    local tower, slot = FindUpgradeCandidate()
    if not tower then
        if Gui.UpgradeStatus then Gui.UpgradeStatus:SetDesc("All owned towers reached their selected or actual maximum") end
        return false, "complete"
    end
    local price = GetNextUpgradePrice(tower)
    if price > GetCash() then
        if Gui.UpgradeStatus then Gui.UpgradeStatus:SetDesc(string.format("Slot %d | Waiting for %d | %s", slot, price, GetTowerName(tower))) end
        return false, "money"
    end
    local oldLevel = GetTowerLevel(tower)
    local unitName = GetTowerName(tower)
    local ok, accepted = Invoke(Remotes.Upgrade, tower, unitName)
    if not ok or accepted == false then
        State.AutoPlayUpgradeFailures[tower] = (State.AutoPlayUpgradeFailures[tower] or 0) + 1
        if not HasNextUpgrade(tower) or State.AutoPlayUpgradeFailures[tower] >= 2 then
            State.AutoPlayMaxed[tower] = true
            if Gui.UpgradeStatus then Gui.UpgradeStatus:SetDesc(unitName .. " reached its actual maximum") end
        elseif Gui.UpgradeStatus then
            Gui.UpgradeStatus:SetDesc("Upgrade rejected once: " .. unitName)
        end
        return false, "rejected"
    end
    local confirmed = WaitUntil(function()
        return not tower.Parent or GetTowerLevel(tower) > oldLevel
    end, 5, 0.05)
    if not confirmed then
        if Gui.UpgradeStatus then Gui.UpgradeStatus:SetDesc("Upgrade was not confirmed") end
        return false, "unconfirmed"
    end
    State.AutoPlayUpgradeFailures[tower] = nil
    if not tower.Parent or not HasNextUpgrade(tower) then State.AutoPlayMaxed[tower] = true end
    if Gui.UpgradeStatus then
        Gui.UpgradeStatus:SetDesc(string.format("Slot %d | %s | Level %d/%d",
            slot, unitName, GetTowerLevel(tower), State.UpgradeSlotMax[slot]))
    end
    return true
end

local function RunAutoPlayStep()
    local function place()
        local did, reason = TryAutoPlace()
        if did then State.AutoPlayTurn = "Upgrade" return true, State.PlacementDelay end
        return false, reason
    end
    local function upgrade()
        local did, reason = TryAutoUpgrade()
        if did then State.AutoPlayTurn = "Place" return true, State.UpgradeDelay end
        return false, reason
    end

    if State.PlacementPriority == "Place First" then
        local did, reason = place()
        if did then return true, State.PlacementDelay end
        if reason == "point" or reason == "position" then return false, State.PlacementDelay end
        local upgraded = upgrade()
        return upgraded, State.UpgradeDelay
    elseif State.PlacementPriority == "Upgrade First" then
        local did, reason = upgrade()
        if did then return true, State.UpgradeDelay end
        if reason == "rejected" or reason == "unconfirmed" then return false, State.UpgradeDelay end
        local placed = place()
        return placed, State.PlacementDelay
    end

    if State.AutoPlayTurn == "Upgrade" then
        local did = upgrade()
        if did then return true, State.UpgradeDelay end
        local placed = place()
        return placed, State.PlacementDelay
    end
    local did = place()
    if did then return true, State.PlacementDelay end
    local upgraded = upgrade()
    return upgraded, State.UpgradeDelay
end

