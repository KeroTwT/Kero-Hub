local removeEnemiesConnection = nil
local removeEnemiesFolder = nil
local function AttachRemoveEnemies()
    local mobsFolder = Workspace:FindFirstChild("Mobs")
    if not mobsFolder then
        return false
    end
    if removeEnemiesConnection and removeEnemiesFolder == mobsFolder then
        return true
    end
    if removeEnemiesConnection then
        removeEnemiesConnection:Disconnect()
        removeEnemiesConnection = nil
    end
    for _, mob in pairs(mobsFolder:GetChildren()) do
        pcall(function()
            mob:Destroy()
        end)
    end
    removeEnemiesFolder = mobsFolder
    removeEnemiesConnection = mobsFolder.ChildAdded:Connect(function(child)
        if SettingsFlags.RemoveEnemies then
            pcall(function()
                child:Destroy()
            end)
        end
    end)
    return true
end

local function DetachRemoveEnemies()
    if removeEnemiesConnection then
        removeEnemiesConnection:Disconnect()
        removeEnemiesConnection = nil
    end
    removeEnemiesFolder = nil
end

