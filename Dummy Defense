    local Lighting = game:GetService("Lighting")
    if v then
        Lighting.GlobalShadows = false
        local function optimizeObj(obj)
            if obj:IsA("BasePart") then
                obj.Material = Enum.Material.SmoothPlastic
                obj.CastShadow = false
            elseif obj:IsA("Decal") or obj:IsA("Texture") then
                obj.Transparency = 1
            end
        end
        for _, obj in pairs(Workspace:GetDescendants()) do
            optimizeObj(obj)
        end
        for _, obj in pairs(Lighting:GetDescendants()) do
            if obj:IsA("PostEffect") or obj:IsA("Atmosphere") or obj:IsA("Sky") then
                pcall(function()
                    obj.Enabled = false
                end)
            end
        end
        fpsConnection = Workspace.DescendantAdded:Connect(optimizeObj)
        Fluent:Notify({ Title = "FPS Boost", Content = "Enabled! Constantly optimizing...", Duration = 3 })
    else
        if fpsConnection then
            fpsConnection:Disconnect()
            fpsConnection = nil
        end
        Lighting.GlobalShadows = true
        Fluent:Notify({ Title = "FPS Boost", Content = "Disabled! Rejoin game to fully restore graphics.", Duration = 4 })
    end
end)

local blackScreenGui
local function SetBlackScreen(enabled)
    if enabled then
        if not blackScreenGui then
            local gui = Instance.new("ScreenGui")
            gui.Name = "DummyDefenseBlackScreen"
            gui.IgnoreGuiInset = true
            gui.DisplayOrder = 2147483647
            gui.ResetOnSpawn = false
            local background = Instance.new("Frame")
            background.Size = UDim2.fromScale(1, 1)
            background.BackgroundColor3 = Color3.new(0, 0, 0)
            background.BorderSizePixel = 0
            background.Parent = gui
            local restore = Instance.new("TextButton")
            restore.AnchorPoint = Vector2.new(0.5, 0.5)
            restore.Position = UDim2.fromScale(0.5, 0.5)
            restore.Size = UDim2.fromOffset(210, 48)
            restore.BackgroundColor3 = Color3.fromRGB(25, 25, 29)
            restore.TextColor3 = Color3.new(1, 1, 1)
            restore.Text = "Disable Black Screen"
            restore.TextSize = 16
            restore.Font = Enum.Font.GothamSemibold
            restore.Parent = background
            Instance.new("UICorner", restore).CornerRadius = UDim.new(0, 10)
            gui.Parent = CoreGui
            blackScreenGui = gui
            restore.Activated:Connect(function()
                if Options.BlackScreenToggle then Options.BlackScreenToggle:SetValue(false) end
            end)
        end
        game:GetService("RunService"):Set3dRenderingEnabled(false)
    else
        game:GetService("RunService"):Set3dRenderingEnabled(true)
        if blackScreenGui then blackScreenGui:Destroy(); blackScreenGui = nil end
    end
end

Tabs.Misc:AddToggle("BlackScreenToggle", {
