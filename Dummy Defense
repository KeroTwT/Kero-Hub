local function ToMultiMap(v)
    if type(v) ~= "table" then
        return {}
    end
    if v[1] ~= nil then
        local m = {}
        for _, name in ipairs(v) do
            if type(name) == "string" then
                m[name] = true
            end
        end
        return m
    end
    return v
end

local function ToMultiList(v)
    if type(v) ~= "table" then
        return {}
    end
    if v[1] ~= nil then
        return v
    end
    local list = {}
    for name, on in pairs(v) do
        if on then
            table.insert(list, name)
        end
    end
    table.sort(list)
    return list
end

local function ApplyElementValue(el, v, multi)
    if not el then
        return
    end
    if multi then
        local list = ToMultiList(v)
        if el.Select then
            pcall(function()
                el:Select(list)
            end)
        elseif el.Set then
            pcall(function()
                el:Set(list)
            end)
        end
        return
    end
    if el.Select then
        pcall(function()
            el:Select(v)
        end)
    end
    if el.Set then
        pcall(function()
            el:Set(v)
        end)
    end
    pcall(function()
        el.Value = v
    end)
end

local function BindElement(el, opts)
    opts = opts or {}
    local box = {
        _el = el,
        _v = opts.default,
        _multi = opts.multi,
        _onChanged = nil,
    }

    function box:OnChanged(cb)
        self._onChanged = cb
        return self
    end

    function box:SetValue(v)
        if self._multi then
            v = ToMultiMap(v)
        end
        self._v = v
        ApplyElementValue(el, v, self._multi)
        if self._onChanged then
            self._onChanged(self._v)
        end
        QueueSave()
    end

    function box:SetValues(list)
        pcall(function()
            if el and el.Refresh then
                el:Refresh(list)
            end
        end)
    end

    function box:SetTitle(t)
        pcall(function()
            if el.SetTitle then
                el:SetTitle(t)
            elseif el.Set then
                el:Set({ Title = t })
            end
        end)
    end

    function box:SetDesc(d)
        pcall(function()
            if el.SetDesc then
                el:SetDesc(d)
            elseif el.Set then
                el:Set({ Desc = d })
            end
        end)
    end

    return setmetatable(box, {
        __index = function(self, k)
            if k == "Value" then
                return self._v
            end
        end,
        __newindex = function(self, k, v)
            if k == "Value" then
                self:SetValue(v)
            else
                rawset(self, k, v)
            end
        end,
    })
end

local function WrapTab(tab)
    local proxy = {}

    function proxy:AddParagraph(cfg)
        local el = tab:Paragraph({
            Title = cfg.Title or "",
            Desc = cfg.Content or cfg.Desc or "",
        })
        return BindElement(el, {})
    end

    function proxy:AddDropdown(key, cfg)
        local values = cfg.Values or {}
        local default = cfg.Default
        if type(default) == "number" then
            default = values[default]
        end
        if cfg.Multi then
            default = default or {}
        end
        local box
        local pending
        local el = tab:Dropdown({
            Title = cfg.Title,
            Desc = cfg.Desc,
            Values = (#values > 0) and values or { "(none)" },
            Value = default,
            Multi = cfg.Multi and true or false,
            Search = cfg.Search and true or false,
            Callback = function(v)
                local store = cfg.Multi and ToMultiMap(v) or v
                if box then
                    box._v = store
                    if cfg.Callback then
                        cfg.Callback(v)
                    end
                    if box._onChanged then
                        box._onChanged(box._v)
                    end
                    QueueSave()
                else
                    pending = store
                end
            end,
        })
        box = BindElement(el, { default = pending ~= nil and pending or default, multi = cfg.Multi })
        Options[key] = box
        return box
    end

    function proxy:AddToggle(key, cfg)
        local box
        local pending
        local el = tab:Toggle({
            Title = cfg.Title,
            Desc = cfg.Desc,
            Value = cfg.Default or false,
            Callback = function(v)
                if box then
                    box._v = v
                    if cfg.Callback then
                        cfg.Callback(v)
                    end
                    if box._onChanged then
                        box._onChanged(v)
                    end
                    QueueSave()
                else
                    pending = v
                end
            end,
        })
        box = BindElement(el, { default = pending ~= nil and pending or (cfg.Default or false) })
        Options[key] = box
        return box
    end

    function proxy:AddInput(key, cfg)
        local box
        local pending
        local el = tab:Input({
            Title = cfg.Title,
            Desc = cfg.Desc,
            Placeholder = cfg.Placeholder,
            Value = cfg.Default or "",
            Callback = function(v)
                if box then
                    box._v = v
                    if cfg.Callback then
                        cfg.Callback(v)
                    end
                    if box._onChanged then
                        box._onChanged(v)
                    end
                    QueueSave()
                else
                    pending = v
                end
            end,
        })
        box = BindElement(el, { default = pending ~= nil and pending or (cfg.Default or "") })
        Options[key] = box
        return box
    end

    function proxy:AddButton(cfg)
        return tab:Button({
            Title = cfg.Title,
            Icon = cfg.Icon,
            Callback = cfg.Callback,
        })
    end

    function proxy:Section(cfg)
        pcall(function()
            tab:Section({ Title = cfg.Title, Desc = cfg.Desc })
        end)
        return proxy
    end

    return proxy
end

