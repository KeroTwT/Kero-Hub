    local ok, err = pcall(SetBlackScreen, v)
    if not ok then Notify("Black Screen", tostring(err), 4) end
end)

local function WaveIsListed(value, wave)
    if wave <= 0 then return false end
    for token in tostring(value or ""):gmatch("%d+") do
        if tonumber(token) == wave then return true end
    end
    return false
end

-- No Delay mode is intentionally independent from the normal half-second hub loop.
-- This game accepts VoteSkip repeatedly, so keep the interval short while still
-- yielding to Roblox and honoring the user's stop-wave list.
task.spawn(function()
    while task.wait(0.05) do
        if SettingsFlags.AutoSkipNoDelay then
            local wave = GetWaveNumber()
            local info = Workspace:FindFirstChild("Info")
            local endState = info and info:FindFirstChild("Endgamemode")
            local ended = endState and endState.Value == true
            local stopValue = Options.StopSkipWavesInput and Options.StopSkipWavesInput.Value or ""
            if info and wave > 0 and not ended and not WaveIsListed(stopValue, wave) then
                local funcs = GetFunctions()
                local voteSkip = funcs and funcs:FindFirstChild("VoteSkip")
                if voteSkip and voteSkip:IsA("RemoteFunction") then
                    pcall(function() voteSkip:InvokeServer() end)
                end
            end
        end
    end
end)

task.spawn(function()
    local wasInMatch = false
    local hasStartedMap = false
    local hasStartedMode = false
    local hasVotedMap = false
    local hasVotedMode = false
    local lastVoteTime = 0
    local delayModeUntil = 0
    local delayModifierUntil = 0
    local lastElevatorCheck = 0
    local lastMatchmaking = 0
    local hasVotedModifiers = false
    local lastCutsceneSkip = 0
    local lastSpeedVoteTime = 0
    local lastEndActionTime = 0
    local soldBusiness = {}
    local lastSellWave = 0
    local soldAllWaves = {}
    local endHandled = false

    task.spawn(function()
        while task.wait(1) do
            if Options.NoFogToggle and Options.NoFogToggle.Value then
                local Lighting = game:GetService("Lighting")
                Lighting.FogEnd = 100000
                for _, v in pairs(Lighting:GetChildren()) do
                    if v:IsA("Atmosphere") then
                        v.Density = 0
                    end
                end
            end
        end
    end)

    while task.wait(0.5) do
        local currentWave = GetCurrentWave()
        local wNum = ParseWave(currentWave)
        local info = Workspace:FindFirstChild("Info")
        local endState = info and info:FindFirstChild("Endgamemode")
        local matchEnded = endState and endState.Value == true

        local inLobby = (wNum <= 0) or (not info)
        local inMatch = (not inLobby) and (not matchEnded)

        if inMatch ~= State.LastMatchActive then
            State.LastMatchActive = inMatch
            State.GameAutoSkipApplied = false
            State.GameSpeedApplied = false
        end

        if SettingsFlags.RemoveEnemies and inMatch then
            AttachRemoveEnemies()
        end

        if inLobby and SettingsFlags.AutoMatchmaking and tick() - lastMatchmaking > 8 then
            lastMatchmaking = tick()
            local remotes = ReplicatedStorage:FindFirstChild("MatchmakingRemotes")
            local startMatchmaking = remotes and remotes:FindFirstChild("StartMatchmaking")
            if startMatchmaking and startMatchmaking:IsA("RemoteEvent") then
                local amount = tonumber(Options.MatchmakingPlayers and Options.MatchmakingPlayers.Value) or 1
                local mapName = Options.AutoMap and Options.AutoMap.Value or "Any Map"
                local modeName = Options.AutoMode and Options.AutoMode.Value or "Any Mode"
                pcall(function()
                    startMatchmaking:FireServer({
                        Map = mapName,
                        Mode = modeName,
                        Amount = math.clamp(amount, 1, 4),
                        MinLevel = 1,
                        MaxLevel = 269,
                    })
                end)
            end
        end

        if inMatch and Options.AutoSpeedToggle and Options.AutoSpeedToggle.Value then
            if not State.GameSpeedApplied and (tick() - lastSpeedVoteTime > 0.75) then
                lastSpeedVoteTime = tick()
                SetGameSpeed15()
            end
        end

        if inLobby and SettingsFlags.AutoJoinElevator and tick() - lastElevatorCheck > 1 then
            lastElevatorCheck = tick()
            local character = LocalPlayer.Character
            local hrp = character and character:FindFirstChild("HumanoidRootPart")
            local elevatorsFolder = Workspace:FindFirstChild("Lobby") and Workspace.Lobby:FindFirstChild("Elevators")
            if hrp and elevatorsFolder then
                local inElevator = false
                for eNum = 1, 6 do
                    local e = elevatorsFolder:FindFirstChild("Elevator " .. tostring(eNum))
                    local tIn = e and e:FindFirstChild("TeleportIn1")
                    if tIn and tIn:IsA("BasePart") and (hrp.Position - tIn.Position).Magnitude < 10 then
                        inElevator = true
                        local startEvt = e:FindFirstChild("StartElevator")
                        if startEvt and startEvt:IsA("RemoteEvent") then
                            pcall(function()
                                startEvt:FireServer()
                            end)
                        end
                        break
                    end
                end
                if not inElevator then
                    for i = 1, 6 do
                        local elevator = elevatorsFolder:FindFirstChild("Elevator " .. tostring(i))
                        if elevator then
                            local screen = elevator:FindFirstChild("Screen")
                            local surfaceGui = screen and screen:FindFirstChild("SurfaceGui")
                            local title = surfaceGui and surfaceGui:FindFirstChild("Title")
                            if title and title:IsA("TextLabel") and title.Text:sub(1, 2) == "0/" then
                                local tpIn = elevator:FindFirstChild("TeleportIn1")
                                if tpIn and tpIn:IsA("BasePart") then
                                    hrp.CFrame = tpIn.CFrame + Vector3.new(0, 3, 0)
                                    break
                                end
                            end
                        end
                    end
                end
            end
        end

        if inMatch and Options.AutoSkipCutscene and Options.AutoSkipCutscene.Value
            and tick() - lastCutsceneSkip > 2 then
            lastCutsceneSkip = tick()
            local evts = GetEvents()
            local cutscene = evts and evts:FindFirstChild("Cutscene")
            local requestSkip = cutscene and cutscene:FindFirstChild("RequestSkipVote")
            if requestSkip and requestSkip:IsA("RemoteEvent") then
                pcall(function() requestSkip:FireServer() end)
            end
        end

        if inMatch and SettingsFlags.AutoSkipGameButton and not State.GameAutoSkipApplied then
            if SetGameAutoSkip(true) then
                UpdateStatus("Running", "Game Auto Skip enabled")
            end
        end

        if not inLobby and Options.AutoSellBusinessToggle and Options.AutoSellBusinessToggle.Value then
            local targetWave = tonumber(Options.AutoSellWaveInput and Options.AutoSellWaveInput.Value) or 0
            if targetWave > 0 and wNum >= targetWave then
                if lastSellWave ~= wNum then
                    lastSellWave = wNum
                    soldBusiness = {}
                end
                local towersFolder = Workspace:FindFirstChild("Towers")
                local funcs = GetFunctions()
                if towersFolder and funcs and funcs:FindFirstChild("SellTower") then
                    for _, t in ipairs(towersFolder:GetChildren()) do
                        if t.Name:find("Business Dummy", 1, true) and not soldBusiness[t] then
                            soldBusiness[t] = true
                            State.IgnoreRemote = true
                            pcall(function()
                                funcs.SellTower:InvokeServer(t)
                            end)
                            State.IgnoreRemote = false
                        end
                    end
                end
            end
        end

        if inMatch and Options.AutoSellAllToggle and Options.AutoSellAllToggle.Value
            and WaveIsListed(Options.AutoSellAllWavesInput and Options.AutoSellAllWavesInput.Value, wNum)
            and not soldAllWaves[wNum] then
            soldAllWaves[wNum] = true
            local towersFolder = Workspace:FindFirstChild("Towers")
            local funcs = GetFunctions()
            local sellTower = funcs and funcs:FindFirstChild("SellTower")
            if towersFolder and sellTower then
                for _, tower in ipairs(towersFolder:GetChildren()) do
                    State.IgnoreRemote = true
                    pcall(function() sellTower:InvokeServer(tower) end)
                    State.IgnoreRemote = false
                    task.wait(0.03)
                end
            end
        end

        if matchEnded and not endHandled then
            endHandled = true
            State.IsPlaying = false
            if Options.PlayToggle then
                Options.PlayToggle:SetValue(false)
            end
            if State.IsRecording then
                State.IsRecording = false
                SaveCurrentMacro()
                if Options.RecordToggle then Options.RecordToggle:SetValue(false) end
            end
            if Options.WebhookEnabled and Options.WebhookEnabled.Value then
                task.spawn(function()
                    local report = string.format(
                        "**Player:** %s\n**Wave:** %d\n**Cash:** %d\n**Place ID:** %s",
                        LocalPlayer.Name,
                        wNum,
                        GetCurrentMoney(),
                        tostring(game.PlaceId)
                    )
                    SendWebhook("Dummy Defense Match Report", report)
                end)
            end
            if tick() - lastEndActionTime > 2 then
                lastEndActionTime = tick()
                local action = Options.EndAction and Options.EndAction.Value or SettingsFlags.EndAction
                local evts = GetEvents()
                if action == "Replay" and evts and evts:FindFirstChild("ReplayVote") then
                    pcall(function() evts.ReplayVote:FireServer() end)
                elseif action == "Exit" and evts and evts:FindFirstChild("ExitGame") then
                    pcall(function() evts.ExitGame:FireServer() end)
                end
            end
        end

        if SettingsFlags.AutoStart and wNum < 1 then
            local pGui = LocalPlayer:FindFirstChild("PlayerGui")
            local gameGui = pGui and pGui:FindFirstChild("GameGui")
            local evts = GetEvents()
            if gameGui and evts then
                local mapName = Options.AutoMap and Options.AutoMap.Value or "Noobland"
                local modeName = Options.AutoMode and Options.AutoMode.Value or "TeamNoob"

                local mapVoting = gameGui:FindFirstChild("Voting")
                local modeVoting = gameGui:FindFirstChild("ModeVoting")
                local titleScroll = mapVoting and mapVoting:FindFirstChild("TitleScroll")
                local mapUiOn = true
                if titleScroll and titleScroll:IsA("GuiObject") then
                    mapUiOn = titleScroll.Visible
                elseif mapVoting and mapVoting:IsA("GuiObject") then
                    mapUiOn = mapVoting.Visible
                end

                if not hasStartedMap and mapUiOn then
                    local mapList = mapVoting and mapVoting:FindFirstChild("Maps")
                    local mapFrame = mapList and (mapList:FindFirstChild(mapName) or mapList:FindFirstChild(mapName, true))
                    if HasPlayerIcon(mapFrame) then
                        hasVotedMap = true
                        hasStartedMap = true
                        pcall(function()
                            evts.StartTimerVote:FireServer()
                        end)
                        lastVoteTime = tick()
                        delayModeUntil = tick() + 4
                    elseif not hasVotedMap then
                        hasVotedMap = true
                        lastVoteTime = tick()
                        pcall(function()
                            evts.VoteForMap:FireServer(mapName, 0.5, 0.5)
                        end)
                    elseif tick() - lastVoteTime > 3 then
                        hasStartedMap = true
                        pcall(function()
                            evts.StartTimerVote:FireServer()
                        end)
                        lastVoteTime = tick()
                        delayModeUntil = tick() + 4
                    end
                end

                local modeReady = modeVoting and (not modeVoting:IsA("GuiObject") or modeVoting.Visible)
                if hasStartedMap and not hasStartedMode and tick() >= delayModeUntil and modeReady then
                    local modesFolder = modeVoting:FindFirstChild("Modes") or modeVoting
                    local modeFrame = modesFolder and (modesFolder:FindFirstChild(modeName) or modesFolder:FindFirstChild(modeName, true))
                    if HasPlayerIcon(modeFrame) then
                        hasVotedMode = true
                        hasStartedMode = true
                        pcall(function()
                            evts.StartTimerVote:FireServer()
                        end)
                        lastVoteTime = tick()
                        delayModifierUntil = tick() + 2
                    elseif not hasVotedMode then
                        hasVotedMode = true
                        lastVoteTime = tick()
                        pcall(function()
                            evts.VoteForMap:FireServer(modeName, 0.5, 0.5)
                        end)
                    elseif tick() - lastVoteTime > 3 then
                        hasStartedMode = true
                        pcall(function()
                            evts.StartTimerVote:FireServer()
                        end)
                        lastVoteTime = tick()
                        delayModifierUntil = tick() + 2
                    end
                end

                if hasStartedMode and tick() >= delayModifierUntil and not hasVotedModifiers then
                    hasVotedModifiers = true
                    pcall(function()
                        local modEvt = evts:FindFirstChild("VoteForModifier")
                        if modEvt and Options.AutoModifiers and Options.AutoModifiers.Value then
                            for modName, isSelected in pairs(Options.AutoModifiers.Value) do
                                if isSelected then
                                    modEvt:FireServer(modName)
                                end
                            end
                        end
                        evts.StartTimerVote:FireServer()
                    end)
                end
            end
        end

        if inMatch then
            if not wasInMatch then
                wasInMatch = true
                hasStartedMap = false
                hasStartedMode = false
                hasVotedMap = false
                hasVotedMode = false
                hasVotedModifiers = false
                delayModeUntil = 0
                delayModifierUntil = 0
                soldBusiness = {}
                lastSellWave = 0
                soldAllWaves = {}
                endHandled = false
                State.GameAutoSkipApplied = false
                local isWave1 = tostring(currentWave) == "1" or tostring(currentWave):match("^1/")
                if SettingsFlags.AutoPlay and not State.IsPlaying and isWave1 then
                    if Options.PlayToggle then
                        Options.PlayToggle:SetValue(true)
                    end
                end
            end
        else
            wasInMatch = false
            if inLobby then
                State.GameAutoSkipApplied = false
                endHandled = false
            end
        end
    end
end)

