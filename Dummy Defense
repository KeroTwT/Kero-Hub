local function ReadPrice(priceObj)
    if not priceObj then
        return 0
    end
    local text
    if priceObj:IsA("TextLabel") or priceObj:IsA("TextButton") then
        text = priceObj.Text
    else
        text = tostring(priceObj.Value or "")
    end
    return tonumber((tostring(text):gsub("%D", ""))) or 0
end

local function GetUnitCost(unitName)
    if not unitName or unitName == "" then
        return 0
    end
    local val = 0
    pcall(function()
        local pGui = LocalPlayer:FindFirstChild("PlayerGui")
        if not pGui then
            return
        end
        local gameGui = pGui:FindFirstChild("GameGui")
        local towers = gameGui and (gameGui:FindFirstChild("Towers") or gameGui:FindFirstChild("TowersLoadout"))
        local towerIcon = towers and towers:FindFirstChild("TowerIcon")
        local unitFrame = towerIcon and towerIcon:FindFirstChild(unitName)
        if not unitFrame and towers then
            unitFrame = towers:FindFirstChild(unitName)
        end
        if unitFrame then
            val = ReadPrice(unitFrame:FindFirstChild("Price", true))
            if val > 0 then
                return
            end
        end
        local shop = pGui:FindFirstChild("ShopGui")
        local shopTowers = shop and shop:FindFirstChild("Towers")
        local shopUnit = shopTowers and shopTowers:FindFirstChild(unitName)
        if shopUnit then
            val = ReadPrice(shopUnit:FindFirstChild("Price", true))
        end
    end)
    return val
end

local function GetTowerPart(tower)
    if not tower then
        return nil
    end
    if tower.PrimaryPart then
        return tower.PrimaryPart
    end
    return tower:FindFirstChild("HumanoidRootPart") or tower:FindFirstChildWhichIsA("BasePart")
end

local function NameMatches(towerName, expected)
    if not expected or expected == "" then
        return true
    end
    if towerName == expected then
        return true
    end
    local n = #expected
    if towerName:sub(1, n) == expected then
        local nextc = towerName:sub(n + 1, n + 1)
        return nextc == "" or nextc == " " or nextc == ":" or nextc == "."
    end
    return false
end

local function GetTowerFromCFrame(cframe, expectedName, maxDist, skipName)
    local towersFolder = Workspace:FindFirstChild("Towers")
    if not towersFolder or not cframe then
        return nil
    end
    local closest, minDist = nil, maxDist or 1.0
    for _, t in ipairs(towersFolder:GetChildren()) do
        local part = GetTowerPart(t)
        if part then
            if not skipName or t.Name ~= skipName then
                if NameMatches(t.Name, expectedName) then
                    local dist = (part.Position - cframe.Position).Magnitude
                    if dist < minDist then
                        minDist = dist
                        closest = t
                    end
                end
            end
        end
    end
    return closest
end

local function CountTowersAt(cframe, expectedName, maxDist)
    local towersFolder = Workspace:FindFirstChild("Towers")
    if not towersFolder or not cframe then
        return 0
    end
    local count, radius = 0, maxDist or 0.5
    for _, t in ipairs(towersFolder:GetChildren()) do
        local part = GetTowerPart(t)
        if part and NameMatches(t.Name, expectedName) then
            if (part.Position - cframe.Position).Magnitude <= radius then
                count = count + 1
            end
        end
    end
    return count
end

