local function SaveCurrentMacro()
    if State.CurrentMacroName == "" then
        return
    end
    local success, err = pcall(function()
        local path = State.MacroFolder .. "/" .. State.CurrentMacroName .. ".json"
        local json = HttpService:JSONEncode({
            Version = 2,
            Game = "Dummy Defense",
            PlaceId = game.PlaceId,
            Name = State.CurrentMacroName,
            RecordedAt = os.time(),
            ActionCount = #State.Actions,
            Actions = State.Actions,
        })
        json = string.gsub(json, "(%d+)%.([,%]%}])", "%1.0%2")
        writefile(path, json)
    end)
    if not success then
        warn("[DummyHub] Failed to save macro:", err)
        UpdateStatus("Error", "ERROR SAVING MACRO! Check F9.")
    end
end

local function LoadMacro(name)
    if not name or name == "" then
        return false
    end
    local path = State.MacroFolder .. "/" .. name .. ".json"
    if not isfile(path) then
        return false
    end
    local json = readfile(path)
    local success, decoded = pcall(function()
        return HttpService:JSONDecode(json)
    end)
    if success and type(decoded) == "table" then
        local loaded = type(decoded.Actions) == "table" and decoded.Actions or decoded
        local hasHandledPlace = false
        for _, action in ipairs(loaded) do
            if action.Action == "Place" and action.Handle ~= nil then
                hasHandledPlace = true
                break
            end
        end

        -- Version 2 records created before this fix also kept rejected placement
        -- attempts. Successful placements have a server-returned tower handle;
        -- rejected attempts do not. Clean those old attempts in memory so an
        -- existing macro cannot stop on a click that never placed a tower.
        local cleaned, removedPlaces, removedSkips = {}, 0, 0
        for _, action in ipairs(loaded) do
            if action.Action == "SkipWave" then
                removedSkips = removedSkips + 1
            elseif hasHandledPlace and action.Action == "Place" and action.Handle == nil then
                removedPlaces = removedPlaces + 1
            else
                table.insert(cleaned, action)
            end
        end
        State.Actions = cleaned
        State.CurrentMacroName = name
        if removedPlaces > 0 or removedSkips > 0 then
            task.defer(UpdateStatus, "Idle", string.format(
                "Loaded %s; ignored %d rejected placement(s), %d legacy skip(s)",
                name,
                removedPlaces,
                removedSkips
            ))
        end
        return true
    end
    warn("[DummyHub] Failed to decode macro:", name, decoded)
    State.Actions = {}
    State.CurrentMacroName = ""
    return false
end

local lastActionSig, lastActionAt = "", 0
local function PushAction(act)
    local sig = table.concat({
        tostring(act.Action),
        tostring(act.UnitName or act.NewName or ""),
        tostring(act.CFrame and act.CFrame[1] or ""),
        tostring(act.CFrame and act.CFrame[3] or ""),
    }, "|")
    if sig == lastActionSig and (tick() - lastActionAt) < 0.12 then
        return
    end
    lastActionSig, lastActionAt = sig, tick()
    table.insert(State.Actions, act)
    State.LastRecordedAt = tick()
    if State.IsRecording and State.CurrentMacroName ~= "" then
        task.defer(SaveCurrentMacro)
    end
end

local function SnapshotTowers()
    local seen = {}
    local towersFolder = Workspace:FindFirstChild("Towers")
    if towersFolder then
        for _, tower in ipairs(towersFolder:GetChildren()) do
            seen[tower] = true
        end
    end
    return seen
end

local function FindNewTowerAt(seen, cframe, expectedName, maxDist)
    local towersFolder = Workspace:FindFirstChild("Towers")
    if not towersFolder or not cframe then return nil end
    local closest, closestDistance = nil, maxDist or 3
    for _, tower in ipairs(towersFolder:GetChildren()) do
        if not seen[tower] and NameMatches(tower.Name, expectedName) then
            local part = GetTowerPart(tower)
            local distance = part and (part.Position - cframe.Position).Magnitude
            if distance and distance <= closestDistance then
                closest, closestDistance = tower, distance
            end
        end
    end
    return closest
end

local function GetOrCreateHandle(tower)
    if typeof(tower) ~= "Instance" then
        return nil
    end
    local handle = State.InstanceHandles[tower]
    if not handle then
        State.NextHandle = State.NextHandle + 1
        handle = State.NextHandle
        State.InstanceHandles[tower] = handle
    end
    return handle
end

local function HasPlayerIcon(inst)
    if not inst then
        return false
    end
    local icon = inst:FindFirstChild("PlayerIcon") or inst:FindFirstChild("PlayerIcon", true)
    if icon then
        if icon:IsA("GuiObject") then
            if icon.Visible then
                return true
            end
        else
            return true
        end
    end
    local sel = inst:FindFirstChild("Selected")
    if not sel then
        return false
    end
    if sel:IsA("BoolValue") then
        return sel.Value == true
    end
    if sel:IsA("GuiObject") then
        return sel.Visible
    end
    return false
end

