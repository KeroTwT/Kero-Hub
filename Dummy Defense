local function ProcessRemoteCall(_method, remote, args, returned)
    if State.IgnoreRemote or not State.IsRecording then
        return
    end
    local rName = tostring(remote.Name)

    if rName == "SpawnTower" then
        local newName = args[1]
        local cframe = args[2]
        local oldTower = args[3]
        local costArg = args[5]
        local wave = GetCurrentWave()
        local t = tick() - State.StartTime
        local c = typeof(cframe) == "CFrame" and { cframe:GetComponents() } or nil

        local newTower = returned and returned[1]
        if oldTower and typeof(oldTower) == "Instance" then
            if typeof(newTower) ~= "Instance" then
                return
            end
            local handle = GetOrCreateHandle(oldTower)
            local action = {
                Action = "Upgrade",
                Time = t,
                Wave = wave,
                Handle = handle,
                PreviousName = oldTower.Name,
                NewName = tostring(newName),
                CFrame = c,
                Cost = costArg or 0,
            }
            PushAction(action)
            if typeof(newTower) == "Instance" and handle then
                State.InstanceHandles[newTower] = handle
            end
            task.defer(UpdateStatus, "Recording", "Recorded Upgrade: " .. tostring(newName))
        else
            if typeof(newTower) ~= "Instance" then
                return
            end
            local inferred = GetUnitCost(tostring(newName))
            local preCash = GetCurrentMoney()
            local handle = GetOrCreateHandle(newTower)
            PushAction({
                Action = "Place",
                Time = t,
                Wave = wave,
                Handle = handle,
                UnitName = tostring(newName),
                CFrame = c,
                Cost = inferred,
            })
            local idx = #State.Actions
            task.defer(UpdateStatus, "Recording", "Recorded Place: " .. tostring(newName) .. " ($" .. inferred .. ")")
            if inferred == 0 then
                task.spawn(function()
                    task.wait(0.25)
                    local postCash = GetCurrentMoney()
                    local act = State.Actions[idx]
                    if act and act.Action == "Place" and postCash < preCash then
                        act.Cost = preCash - postCash
                    end
                end)
            end
        end
    elseif rName == "SellTower" then
        local target = args[1]
        local part = typeof(target) == "Instance" and GetTowerPart(target)
        if part then
            PushAction({
                Action = "Sell",
                Time = tick() - State.StartTime,
                Wave = GetCurrentWave(),
                Handle = GetOrCreateHandle(target),
                UnitName = target.Name,
                CFrame = { part.CFrame:GetComponents() },
                Cost = 0,
            })
            task.defer(UpdateStatus, "Recording", "Recorded Sell")
        end
    elseif rName == "ChangeTowerMode" then
        local target = args[1]
        local part = typeof(target) == "Instance" and GetTowerPart(target)
        if part then
            local action = {
                Action = "TargetMode",
                Time = tick() - State.StartTime,
                Wave = GetCurrentWave(),
                Handle = GetOrCreateHandle(target),
                UnitName = target.Name,
                CFrame = { part.CFrame:GetComponents() },
                Cost = 0,
            }
            local config = target:FindFirstChild("Config")
            local mode = config and config:FindFirstChild("TargetMode")
            action.PreviousMode = mode and tostring(mode.Value) or nil
            PushAction(action)
            task.delay(0.2, function()
                if mode and mode.Parent then
                    action.TargetMode = tostring(mode.Value)
                    SaveCurrentMacro()
                end
            end)
            task.defer(UpdateStatus, "Recording", "Recorded TargetMode")
        end
    end
end

local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
    local method = getnamecallmethod()
    local fromScript = false
    pcall(function()
        fromScript = checkcaller()
    end)

    if SettingsFlags.PlaceAnywhere and not fromScript then
        local collisionQuery = method == "GetPartsInPart"
            or method == "GetPartBoundsInBox"
            or method == "GetPartBoundsInRadius"
            or method == "GetTouchingParts"
        if collisionQuery then
            State.PlaceAnywhereBypasses = (State.PlaceAnywhereBypasses or 0) + 1
            if not State.PlaceAnywhereUiQueued then
                State.PlaceAnywhereUiQueued = true
                task.defer(function()
                    State.PlaceAnywhereUiQueued = false
                    if PlacementParagraph then
                        PlacementParagraph:SetTitle("Place Anywhere: Active")
                        PlacementParagraph:SetDesc(string.format(
                            "%d collision checks bypassed",
                            State.PlaceAnywhereBypasses
                        ))
                    end
                end)
            end
            return {}
        end
    end

    local returned = table.pack(oldNamecall(self, ...))
    if State.IsRecording and not State.IgnoreRemote and not fromScript then
        if method == "InvokeServer" or method == "FireServer" then
            local args = { ... }
            pcall(function()
                local rName = self.Name
                if rName == "SellTower" or rName == "ChangeTowerMode" then
                    ProcessRemoteCall(method, self, args, returned)
                end
            end)
        end
    end
    return table.unpack(returned, 1, returned.n)
end))

-- Dummy Defense calls SpawnTower through a cached/direct InvokeServer method,
-- so __namecall alone cannot see placement or upgrades.
do
    local sample = Instance.new("RemoteFunction")
    local invokeMethod = sample.InvokeServer
    sample:Destroy()
    local originalInvoke
    local ok, err = pcall(function()
        originalInvoke = hookfunction(invokeMethod, newcclosure(function(remote, ...)
            local fromScript = type(checkcaller) == "function" and checkcaller()
            local args = table.pack(...)
            local returned = table.pack(originalInvoke(remote, ...))
            if not fromScript and State.IsRecording and not State.IgnoreRemote
                and typeof(remote) == "Instance" and remote.Name == "SpawnTower" then
                pcall(ProcessRemoteCall, "InvokeServer", remote, args, returned)
            end
            return table.unpack(returned, 1, returned.n)
        end))
    end)
    if not ok then
        warn("[Dummy Defense Hub] Direct InvokeServer hook unavailable:", err)
    end
end

local currentPlaybackSession = 0

local function ResolveActionCost(act)
    local cost = tonumber(act.Cost) or 0
    if cost > 0 then
        return cost
    end
    if act.Action == "Place" then
        return GetUnitCost(act.UnitName)
    end
    if act.Action == "Upgrade" then
        return tonumber(act.Cost) or 0
    end
    return 0
end

local function ResolvePlaybackTower(act)
    local handle = tonumber(act and act.Handle)
    local tower = handle and State.PlaybackTowers[handle] or nil
    if tower and tower.Parent then
        return tower
    end
    local cf = CFrameFromAction(act)
    tower = GetTowerFromCFrame(cf, act and act.UnitName, 1.5)
        or GetTowerFromCFrame(cf, nil, 1.5)
    if tower and handle then
        State.PlaybackTowers[handle] = tower
    end
    return tower
end

local function PlayMacroLoop()
    if State.IsPlaying then
        return
    end
    if #State.Actions == 0 then
        UpdateStatus("Error", "Macro trống — chọn file trước.")
        return
    end
    State.IsPlaying = true
    State.PlaybackTowers = {}
    currentPlaybackSession = currentPlaybackSession + 1
    local session = currentPlaybackSession

    task.spawn(function()
        local startT = tick()
        local step = 1
        local total = #State.Actions
        local currentStep = 1
        local stepStartT = tick()
        local actionAttempted = false
        local towersBeforeAttempt = nil
        local attemptedTower = nil

        while State.IsPlaying and session == currentPlaybackSession do
            if step ~= currentStep then
                currentStep = step
                stepStartT = tick()
                actionAttempted = false
                towersBeforeAttempt = nil
                attemptedTower = nil
            end

            local w = GetWaveNumber()
            if w < 1 then
                startT = tick()
                task.wait(0.1)
            elseif step <= total then
                local act = State.Actions[step]
                local passed = tick() - startT
                local cash = GetCurrentMoney()
                local cost = ResolveActionCost(act)
                local mode = State.PlaybackMode
                local readyT, readyM

                if mode == "Time" then
                    readyT = passed >= (act.Time or 0)
                    readyM = true
                elseif mode == "Money" then
                    readyT = true
                    readyM = cost <= 0 or cash >= cost
                else
                    readyT = passed >= (act.Time or 0)
                    readyM = cost <= 0 or cash >= cost
                    if w > ParseWave(act.Wave) and ParseWave(act.Wave) > 0 then
                        readyT = true
                    end
                end

                if readyT and readyM then
                    UpdateStatus("Playing", string.format("Step %d/%d: %s", step, total, tostring(act.Action)))
                    local rFuncs = GetFunctions()
                    local stepDone = false

                    if rFuncs then
                        if act.Action == "Place" then
                            local cf = CFrameFromAction(act)
                            if not cf then
                                stepDone = true
                            else
                                if not actionAttempted then
                                    actionAttempted = true
                                    towersBeforeAttempt = SnapshotTowers()
                                    local ok, placed = pcall(function()
                                        return rFuncs.SpawnTower:InvokeServer(act.UnitName, cf)
                                    end)
                                    if ok and typeof(placed) == "Instance" then
                                        if act.Handle then State.PlaybackTowers[tonumber(act.Handle)] = placed end
                                        stepDone = true
                                    elseif ok and placed == false then
                                        State.IsPlaying = false
                                        UpdateStatus("Stopped", string.format("Action %d failed: Place was rejected", step))
                                    end
                                end

                                -- Some executor/game combinations do not expose the
                                -- RemoteFunction return. Confirm the one request from
                                -- replicated tower state instead of blindly retrying it.
                                if not stepDone and actionAttempted and towersBeforeAttempt then
                                    local replicated = FindNewTowerAt(towersBeforeAttempt, cf, act.UnitName, 3)
                                    if replicated then
                                        if act.Handle then State.PlaybackTowers[tonumber(act.Handle)] = replicated end
                                        stepDone = true
                                    end
                                end
                                if not stepDone and State.IsPlaying and tick() - stepStartT > 5 then
                                    State.IsPlaying = false
                                    UpdateStatus("Stopped", string.format("Action %d failed: no placed tower confirmed", step))
                                end
                            end
                        elseif act.Action == "Upgrade" then
                            local cf = CFrameFromAction(act)
                            if not cf then
                                stepDone = true
                            else
                                local target = ResolvePlaybackTower(act)
                                if target and not actionAttempted then
                                    actionAttempted = true
                                    attemptedTower = target
                                    local ok, upgraded = pcall(function()
                                        return rFuncs.SpawnTower:InvokeServer(act.NewName, cf, target, nil, act.Cost)
                                    end)
                                    if ok and typeof(upgraded) == "Instance" then
                                        if act.Handle then State.PlaybackTowers[tonumber(act.Handle)] = upgraded end
                                        stepDone = true
                                    elseif ok and upgraded == false then
                                        State.IsPlaying = false
                                        UpdateStatus("Stopped", string.format("Action %d failed: Upgrade was rejected", step))
                                    end
                                end

                                if not stepDone and actionAttempted then
                                    local replicated = GetTowerFromCFrame(cf, act.NewName, 3)
                                    if replicated and replicated ~= attemptedTower then
                                        if act.Handle then State.PlaybackTowers[tonumber(act.Handle)] = replicated end
                                        stepDone = true
                                    end
                                end
                                if not stepDone and State.IsPlaying and tick() - stepStartT > 5 then
                                    State.IsPlaying = false
                                    UpdateStatus("Stopped", string.format("Action %d failed: no upgrade confirmed", step))
                                end
                            end
                        elseif act.Action == "Sell" then
                            local target = ResolvePlaybackTower(act)
                            if target then
                                local ok, accepted = pcall(function()
                                    return rFuncs.SellTower:InvokeServer(target)
                                end)
                                if ok and accepted == true then
                                    if act.Handle then State.PlaybackTowers[tonumber(act.Handle)] = nil end
                                    stepDone = true
                                end
                            end
                            if not stepDone and tick() - stepStartT > 8 then
                                State.IsPlaying = false
                                UpdateStatus("Stopped", string.format("Action %d failed: Sell was rejected", step))
                            end
                        elseif act.Action == "TargetMode" then
                            local target = ResolvePlaybackTower(act)
                            if target then
                                local ok, accepted = pcall(function()
                                    return rFuncs.ChangeTowerMode:InvokeServer(target)
                                end)
                                if ok and accepted == true then
                                    stepDone = true
                                end
                            end
                            if not stepDone and tick() - stepStartT > 8 then
                                State.IsPlaying = false
                                UpdateStatus("Stopped", string.format("Action %d failed: Target change was rejected", step))
                            end
                        else
                            stepDone = true
                        end
                    end

                    if stepDone then
                        step = step + 1
                    end
                else
                    local waitInfo = ""
                    if not readyT then
                        waitInfo = string.format("Wait Time: %.1fs", (act.Time or 0) - passed)
                    elseif not readyM then
                        waitInfo = string.format("Wait Cash: %d/%d", cash, cost)
                    end
                    UpdateStatus("Waiting", string.format("Step %d/%d: %s\n%s", step, total, tostring(act.Action), waitInfo))
                end
            else
                UpdateStatus("Waiting", "Macro Finished")
            end
            task.wait(0.05)
        end
    end)
end

local function OptVal(key, fallback)
    local o = Options[key]
    if not o then
        return fallback
    end
    local v = o._v
    if v == nil then
        return fallback
    end
    return v
end

local function OptStr(key, fallback)
    local v = OptVal(key, fallback)
    if type(v) == "table" then
        if type(v[1]) == "string" then
            return v[1]
        end
        for name, on in pairs(v) do
            if on and type(name) == "string" then
                return name
            end
        end
        return fallback
    end
    if type(v) == "string" then
        return v
    end
    return fallback
end

local function OptBool(key, fallback)
    local v = OptVal(key, fallback)
    if type(v) == "boolean" then
        return v
    end
    return fallback
end

