.PlaybackMode==\"Time\" then timed=H.GameTime-H.PlayStart>=(a.Time or 0) end\n                    return timed and (a.Kind==\"Upgrade\" or H.Cash()>=(a.Cost or 0))\n                end,S.ActionTimeout,serial)\n                if not ready then error(\"Step \"..i..\": timing or funds timeout\",0) end\n                local success,why=H.DoAction(a,serial)\n                if not success then error(\"Step \"..i..\": \"..tostring(why),0) end\n            end\n        end)\n        if H.Serial==serial then\n            H.Playing=false;H.Status=ok and \"Playback complete\" or tostring(err)\n            if not ok then H.Notify(H.Status) end\n        end\n    end)\nend\nfunction H.Webhook(url,title,fields,color,description,image)\n    if type(url)~=\"string\" or not url:match(\"^https://discord%.com/api/webhooks/%d+/[%w_%-]+\") then return false,\"Invalid webhook URL\" end\n    local requestFn=request or http_request or (syn and syn.request)\n    if type(requestFn)~=\"function\" then return false,\"HTTP requests unavailable\" end\n    local embed={title=title,description=description,color=color or 5793266,fields=fields,\n        footer={text=\"Made By Kero\",icon_url=\"https://i.postimg.cc/HWKcyfKJ/download-(2).jpg\"},\n        timestamp=os.date(\"!%Y-%m-%dT%H:%M:%SZ\")}\n    if image then embed.image={url=image} end\n    local encoded,body=pcall(HTTP.JSONEncode,HTTP,{username=\"Alliance TD Hub\",allowed_mentions={parse={}},embeds={embed}})\n    if not encoded then return false,\"Could not encode webhook payload\" end\n    local ok,response=pcall(requestFn,{Url=url,Method=\"POST\",Headers={[\"Content-Type\"]=\"application/json\"},Body=body})\n    local status=ok and type(response)==\"table\" and tonumber(response.StatusCode or response.Status)\n    return status and status>=200 and status<300 or false, status and (\"HTTP \"..status) or \"Request failed\"\nend\nfunction H.Result()\n    local root=H.PG(\"GameEndUI/NewFrame\")\n    if not H.Visible(root) then return end\n    local status=H.Text(H.Path(root,\"Upside/StatusFrame/Status\"))\n    if status~=\"Triumph!\" and status~=\"You Lose!\" then return end\n    local rewards={};local list=root:FindFirstChild(\"ListRewards\",true)\n    if list then for _,item in ipairs(list:GetChildren()) do\n        local amount=item:FindFirstChild(\"Amount\",true)\n        local name=item.Name:gsub(\"^Reward_\",\"\")\n        if name~=\"Template\" and H.Visible(item) and amount and H.Text(amount)~=\"\" then\n            local labels={Coins=\"\240\159\146\181 Coins\",Pumpkins=\"\240\159\142\131 Pumpkins\",Xp=\"\226\156\168 XP\",XP=\"\226\156\168 XP\"}\n            rewards[#rewards+1]=(labels[name] or name)..\": \"..H.Text(amount)\n        end\n    end end\n    table.sort(rewards)\n    return {Status=status,Map=H.Text(H.Path(root,\"Upside/MapName\")),Mode=H.Text(H.Path(root,\"Upside/Mode/Mode\")),\n        Time=H.Text(H.Path(root,\"Upside/Timer/TextLabel\")),Rewards=table.concat(rewards,\"\\n\")}\nend\nfunction H.MatchReport(r)\n    local result=r.Status==\"Triumph!\" and \"Victory\" or r.Status==\"You Lose!\" and \"Defeat\" or r.Status\n    local function text(value,fallback) return type(value)==\"string\" and value~=\"\" and value or fallback end\n    return {\n        Title=\"Alliance TD Match Report\",\n        Description=string.format(\"**Stage:** %s\\n**Mode:** %s\\n**Result:** %s\",\n            text(r.Map,tostring(H.MapId() or \"Unavailable\")),text(r.Mode,S.Difficulty),result),\n        Color=result==\"Victory\" and 65280 or result==\"Defeat\" and 16711680 or 16776960,\n        Fields={\n            {name=\"Player Info\",value=\"\240\159\145\164 Name: ||\"..P.Name..\"||\\n\226\157\164\239\184\143 Base HP: \"..tostring(r.BaseHP or \"Unavailable\"),inline=false},\n            {name=\"Clear Time\",value=\"\226\143\177\239\184\143 \"..text(r.Time,\"Unavailable\"),inline=true},\n            {name=\"Match Rewards\",value=text(r.Rewards,\"None\"),inline=false}},\n        Image=\"https://i.postimg.cc/1RYRdwrS/Bo-suu-tap.jpg\"}\nend\nfunction H.ReturnLobby()\n    H.SaveConfig(true);H.QueueTeleport()\n    if game.PlaceId==H.MatchId then\n        H.Call(\"ReturnToLobby\")\n        task.delay(10,function() if H.Running then pcall(TP.Teleport,TP,H.LobbyId,P) end end)\n    else pcall(TP.Teleport,TP,H.LobbyId,P) end\nend\nfunction H.QueueTeleport()\n    if H.TeleportQueued or not S.AutoExecute then return end\n    local queue=queue_on_teleport or queueonteleport or (syn and syn.queue_on_teleport)\n    if type(queue)~=\"function\" or not H.FS then return end\n    local code='local e=getgenv(); if not e.__AllianceTDAutoBoot then local p=game:GetService(\"Players\").LocalPlayer or game:GetService(\"Players\").PlayerAdded:Wait(); local c=\"AllianceTD_Macros/Settings/\"..p.Name..\".json\"; local ok,s=pcall(function() return game:GetService(\"HttpService\"):JSONDecode(readfile(c)) end); if ok and s.AutoExecute then e.__AllianceTDAutoBoot=true; local f=loadstring(readfile(\"AllianceTD_Macros/Hub.lua\")); if f then f() end end end'\n    local ok=pcall(queue,code);H.TeleportQueued=ok\nend\nfunction H.EndStep(result)\n    if not H.Ended then\n        H.Ended=true;H.StopRecord();H.StopPlayback();H.EndAt=os.clock()\n        local cycle=E.__AllianceTDResult\n        if not cycle or cycle.JobId~=game.JobId or not cycle.Counted then\n            S.MatchesCompleted=S.MatchesCompleted+1;H.SaveConfig(true)\n            E.__AllianceTDResult={JobId=game.JobId,Counted=true}\n        end\n        H.Status=result.Status\n        if S.WebhookEnabled and S.WebhookMatchEnd and not E.__AllianceTDResult.Reported then\n            E.__AllianceTDResult.Reported=true\n            task.delay(1,function()\n                if not H.Running then return end\n                local r=H.Result() or result\n                local report=H.MatchReport(r)\n                local ok,reason=H.Webhook(S.WebhookURL,report.Title,report.Fields,report.Color,report.Description,report.Image)\n                if not ok then H.Notify(\"Webhook: \"..tostring(reason)) end\n            end)\n        end\n    end\n    if os.clock()-H.EndAt<S.EndDelay or H.EndSent then return end\n    if S.AutoReturnAfterMatches and S.MatchesCompleted>=S.MatchLimit then H.EndSent=true;H.ReturnLobby()\n    elseif S.EndAction==\"Return Lobby\" then H.EndSent=true;H.ReturnLobby()\n    elseif S.EndAction==\"Replay\" then H.EndSent=true;H.QueueTeleport();H.Call(\"ReplayVote\") end\nend\nfunction H.UpdateSpeed(state)\n    if type(state)~=\"table\" then return end\n    H.TickClock();H.Speed=tonumber(state.Speed) or H.Speed;H.SpeedState=state\nend\nfunction H.MatchStep()\n    H.TickClock();local result=H.Result()\n    if result then H.EndStep(result);return end\n    if H.Ended then\n        if H.Visible(H.PG(\"GameEndUI/NewFrame\")) then return end\n        H.Ended,H.EndSent=false,false;H.Wave,H.GameTime,H.WaveTime=0,0,0;H.AutoPlayed=false;H.LastSkipWave=nil\n        H.SellAllDone={};H.SellRound=(H.SellRound or 0)+1\n        E.__AllianceTDResult={JobId=game.JobId,Counted=false};H.Next.Speed=0\n    end\n    local map=H.Map();local mode=map and map:GetAttribute(\"Mode\")\n    local vote=H.Path(RS,\"ModeVote/Votes/\"..P.UserId)\n    if S.AutoDifficulty and (not vote or vote.Value~=S.Difficulty) and H.Wave==0 and H.Due(\"Difficulty\",3) then\n        H.Call(\"Vote\",S.Difficulty)\n    end\n    if S.AutoSpeed and H.Due(\"Speed\",3) then\n        if not H.SpeedState or H.Due(\"SpeedState\",30) then local ok,state=H.Call(\"GetGameSpeedState\");if ok then H.UpdateSpeed(state) end end\n        local state=H.SpeedState\n        if state and state.Ready and not state.Locked then\n            local desired=math.min(tonumber(S.Speed) or 1,tonumber(state.MaxSpeed) or 1)\n            if math.abs(H.Speed-desired)>.01 then H.Call(\"SetGameSpeed\",desired) end\n        end\n    end\n    local blocked=false\n    for value in tostring(S.StopAtWave):gmatch(\"%d+\") do if tonumber(value)==H.Wave then blocked=true;break end end\n    if