_,enemy in ipairs(enemies) do\n        if enemy:IsA(\"Model\") and enemy.Parent then\n            local health=tonumber(enemy:GetAttribute(\"Health\") or enemy:GetAttribute(\"HP\"))\n            if not health or health>0 then\n                local position=enemy:GetPivot().Position\n                local dx,dz=position.X-origin.X,position.Z-origin.Z\n                if dx*dx+dz*dz<=range*range then return true end\n            end\n        end\n    end\n    return false\nend\nfunction H.AbilityStep()\n    if not H.Running or not H.AbilityAllowed() or os.clock()<(H.Next.Ability or 0) then return end\n    local mobs=WS:FindFirstChild(\"Mobs\");if not mobs then return end\n    local enemies=mobs:GetChildren();if #enemies==0 then return end\n    local towers=H.Towers();if #towers==0 then return end\n    H.AbilityAttempts=H.AbilityAttempts or setmetatable({}, {__mode=\"k\"})\n    for offset=1,#towers do\n        local index=((H.AbilityCursor or 0)+offset-1)%#towers+1;local tower=towers[index]\n        if os.clock()>=(H.AbilityAttempts[tower] or 0) and H.AbilityTargetInRange(tower,enemies) then\n            H.AbilityCursor=index\n            local ok,success,detail=H.Call(\"UseTowerAbility\",tower)\n            local delay=S.AbilityDelay\n            if ok and success==true then\n                if type(detail)==\"number\" then\n                    local clockOK,serverNow=pcall(WS.GetServerTimeNow,WS)\n                    if clockOK and detail>serverNow and detail-serverNow<3600 then delay=math.max(delay,detail-serverNow) end\n                end\n            else delay=math.max(delay,tostring(detail):lower()==\"no target\" and 1 or 5) end\n            H.AbilityAttempts[tower]=os.clock()+delay;H.Next.Ability=os.clock()+S.AbilityDelay\n            return -- One in-flight activation; rotate towers on the next pass.\n        end\n    end\nend\nH.PotionNames={Money=\"Coin Potion\",Luck=\"Luck Potion\",SummonDiscount=\"Summon Discount\",XP=\"Double XP\",Pumpkins=\"Double Pumpkins\"}\nfunction H.UpdateBoosts(state)\n    if type(state)==\"table\" and type(state.Inventory)==\"table\" then H.BoostState=state;H.BoostReadAt=os.clock()+5 end\nend\nfunction H.PotionStep()\n    if not H.Running or not S.AutoUsePotion or game.PlaceId~=H.LobbyId or not next(S.SelectedPotions)\n        or not H.Due(\"Potion\",S.PotionDelay) then return end\n    if (not H.BoostState or os.clock()>=(H.BoostReadAt or 0)) and not H.BoostReadBusy then\n        H.BoostReadBusy=true;H.BoostReadAt=os.clock()+5\n        task.spawn(function()\n            local called,ok,state=pcall(H.Call,\"GetBoostState\")\n            H.BoostReadBusy=false\n            if H.Running and called and ok then H.UpdateBoosts(state) end\n        end)\n    end\n    if not H.Running or not S.AutoUsePotion or game.PlaceId~=H.LobbyId then return end\n    local inventory=H.BoostState and H.BoostState.Inventory\n    if not inventory then return end\n    local available={}\n    for name in pairs(H.PotionNames) do\n        if S.SelectedPotions[name] and (tonumber(inventory[name]) or 0)>0 then available[#available+1]=name end\n    end\n    table.sort(available)\n    if #available==0 or (H.PotionPending or 0)>=8 then return end\n    local index=1\n    for i,name in ipairs(available) do if name==H.LastPotion then index=i%#available+1;break end end\n    local name=available[index];H.LastPotion=name\n    H.PotionPending=(H.PotionPending or 0)+1\n    task.spawn(function()\n        if not H.Running or not S.AutoUsePotion or not S.SelectedPotions[name] or game.PlaceId~=H.LobbyId then\n            H.PotionPending=H.PotionPending-1;return\n        end\n        local called,ok,success,result=pcall(H.Call,\"UseBoost\",name)\n        H.PotionPending=H.PotionPending-1\n        if not H.Running then return end\n        if called and ok and success==true and type(result)==\"table\" and type(result.Inventory)==\"table\" then\n            local current=H.BoostState and H.BoostState.Inventory\n            if current then for id,count in pairs(result.Inventory) do\n                if type(count)==\"number\" then current[id]=math.min(tonumber(current[id]) or count,count) end\n            end end\n        end\n        -- Keep the configured dispatch interval even when a request is rejected.\n    end)\nend\nfunction H.SellAllStep()\n    if not H.Running or not S.AutoSellAllOnWave or game.PlaceId~=H.MatchId or H.Ended or H.Wave<=0 or H.AutoSelling then return end\n    local wave=H.Wave;local selected=false\n    for value in tostring(S.SellAllWaves):gmatch(\"%d+\") do if tonumber(value)==wave then selected=true;break end end\n    if not selected then return end\n    H.SellAllDone=H.SellAllDone or {};if H.SellAllDone[wave] then return end\n    H.SellAllDone[wave]=true;H.AutoSelling=true\n    local round=H.SellRound or 0;local towers=H.Towers()\n    task.spawn(function()\n        local ok,err=pcall(function()\n            for _,tower in ipairs(towers) do\n                if not H.Running or not S.AutoSellAllOnWave or H.Ended or game.PlaceId~=H.MatchId or (H.SellRound or 0)~=round then break end\n                if tower.Parent and H.Own(tower) then\n                    -- Internal caller marker excludes only these hub requests from recording.\n                    H.Call(\"SellTower\",tower);task.wait(.1)\n                end\n            end\n        end)\n        H.AutoSelling=false\n        if not ok then warn(\"[Alliance TD] Auto Sell: \"..tostring(err)) end\n    end)\nend\nfunction H.SpinWheelStep()\n    if not H.Running or not S.AutoSpinWheel or game.PlaceId~=H.LobbyId or not H.Due(\"SpinWheel\",.1) then return end\n    local state=H.SpinState\n    if not state or os.clock()>=(H.SpinReadAt or 0) then\n        local ok,fresh=H.Call(\"GetSpinWheelState\")\n        if not ok or type(fresh)~=\"table\" then H.Next.SpinWheel=os.clock()+.1;return end\n        H.SpinState=fresh;state=fresh;H.SpinReadAt=os.clock()+5\n    end\n    if not H.Running or not S.AutoSpinWheel or game.PlaceId~=H.LobbyId then return end\n    if state.InventoryFull then\n        H.Next.SpinWheel=os.clock()+.1;return\n    end\n    local free=tonumber(state.FreeSpins) or 0\n    local tickets=tonumber(state.Tickets) or 0;local cost=tonumber(state.Cost) or 1\n    if free<=0 and tickets<cost then H.Next.SpinWheel=os.clock()+.1;return end\n    if (H.SpinPending or 0)>=8 then return end\n    H.SpinPending=(H.SpinPending or 0)+1\n    task.spawn(function()\n        if not H.Running or not S.AutoSpinWheel or game.PlaceId~=H.LobbyId then\n            H.SpinPending=H.SpinPending-1;return\n        end\n        local called,sent,result=pcall(H.Call,\"SpinWheel\")\n        H.SpinPending=H.SpinPending-1\n        if not H.Running then return end\n        if called and sent and type(result)==\"table\" and result.Success==true then\n            -- Responses may arrive out of order; older balances must not refill the cache.\n            local current=H.SpinState\n            if current then\n                if tonumber(result.FreeSpins) then current.FreeSpins=math.min(tonumber(current.FreeSpins) or 0,result.FreeSpins) end\n                if tonumber(result.Tickets) then current.Tickets=math.min(tonumber(current.Tickets) or 0,result.Tickets) end\n            end\n        else\n            H.SpinState=nil;H.Next.SpinWheel=os.clock()+.1\n        end\n    end)\nend\nfunction H.SummonStep()\n    if game.PlaceId==H.LobbyId and S.AutoSummon and H.Due(\"Summon\",S.SummonDelay) then\n        local amount=({x1=1,x10=10,x25=25})[S.SummonAmount] or 1\n        local ok,result=H.Call(\"SummonUnits\",amount)\n        if not ok or type(result)~=\"table\" then\n            H.SummonStatus=\"Waiting: \"..tostring(result)\n        else\n            H.SummonStatus=\"Summon complete\"\n        end\n    end\nend\nfunction H.UpdateCrates(inventory,authoritative)\n    if type(inventory)~=\"table\" then return end\n    local counts={};local options={}\n    for name,count in pairs(inventory) do\n        if type(name)==\"string