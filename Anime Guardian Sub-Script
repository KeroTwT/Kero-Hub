                      v.Enabled = false
                  end
              end

              for _, v in ipairs(workspace:GetDescendants()) do
                  pcall(processObj, v)
              end

              if not descConn then
                  descConn = workspace.DescendantAdded:Connect(function(v)
                      task.defer(function() pcall(processObj, v) end)
                  end)
              end
          end)
