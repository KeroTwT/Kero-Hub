                        local active = sp:FindFirstChild("Active")
                        if active and active:IsA("BoolValue") and active.Value == true then
                            local char = LocalPlayer.Character
                            local rootPart = char and char:FindFirstChild("HumanoidRootPart")
                            if rootPart then
                                rootPart.CFrame = sp.CFrame
                                task.wait(3)
                                
                                while isAutoCollectPhantomSkull and active.Value == true and LocalPlayer.Character do
                                    rootPart.CFrame = sp.CFrame
                                    task.wait(0.2)
                                    
                                    local prompt = sp:FindFirstChildWhichIsA("ProximityPrompt", true)
                                    if prompt then
                                        fireproximityprompt(prompt)
                                    else
                                        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
                                        task.wait(0.1)
                                        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
                                    end
                                    task.wait(0.5)
                                end
                            end
                        end
                    end
                end
            end)
        end
        task.wait(0.5)
    end
end)

