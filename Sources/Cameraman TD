    if not r or not H.Own(tower) then
        return
    end
    if H.HookOK and (not stamp or stamp.Record ~= r) then return end
    local key = r.Keys[tower.Id]
    if kind == "Place" then
        if key then
            return
        end
        if typeof(tower.CFrame) ~= "CFrame" then
            return
        end
        r.Counter = r.Counter + 1
        key = "T" .. r.Counter
        r.Keys[tower.Id] = key
