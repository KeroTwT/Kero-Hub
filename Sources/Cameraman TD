end
function H.CircleOccupied(elevator, joined)
    if (tonumber(elevator:GetAttribute("Players")) or 0) > (joined and 1 or 0) then
        return true
    end
    local host = elevator:GetAttribute("Host")
    if
        host
        and tostring(host) ~= ""
        and tostring(host) ~= "0"
        and tostring(host) ~= tostring(P.UserId)
        and tostring(host) ~= P.Name
    then
        return true
    end
    local pad = elevator:FindFirstChild("Pad")
    if not pad or not Players.GetPlayers then
        return false
    end
    local cf, size
    if pad:IsA("Model") then
        cf, size = pad:GetBoundingBox()
    elseif pad:IsA("BasePart") then
        cf, size = pad.CFrame, pad.Size
    end
    if not cf or not size then
        return false
    end
    local radius = math.max(6, math.max(size.X, size.Z) / 2)
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= P then
            local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                local delta = hrp.Position - cf.Position
                if math.abs(delta.Y) <= 10 and Vector3.new(delta.X, 0, delta.Z).Magnitude <= radius then
                    return true
                end
            end
        end
    end
    return false
end
