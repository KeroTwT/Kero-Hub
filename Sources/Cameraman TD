    H.SetToggle("Record", true)
end
function H.StopRecord()
    local r = H.Recording
    if not r then
        return
    end
    if r.WaveConnection then
        r.WaveConnection:Disconnect()
    end
    H.RecordWave = nil
    H.Recording = nil
    H.Pending = {}
    H.SortMacroActions(r.Profile)
    H.SetToggle("Record", false)
    H.Draft = r.Profile -- retain recoverable in-memory draft if filesystem fails
    H.DraftName = S.Profile
    if not H.ValidProfile(r.Profile) then
        H.Notify("Macro validation failed; draft retained")
        return false, "Macro validation failed"
    end
    local ok, err = H.Write(H.File(S.Profile), r.Profile)
    H.SetStatus(
        "Macro",
        ok and ("Saved " .. S.Profile .. ": " .. r.Profile.ActionCount .. " actions")
            or ("Save failed: " .. tostring(err))
    )
    if ok then
        H.RefreshProfiles()
    else
        H.Notify("Save failed; recording draft retained")
    end
    if ok then
        H.SetProfileOwner(S.Profile, P.UserId)
        H.LoadedProfile = r.Profile
        H.LearnProfileCosts(r.Profile)
    end
    return ok, err
end
