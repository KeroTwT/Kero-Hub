function H.Stamp(name, payload)
    if not H.Recording or type(payload) ~= "table" then
        return
    end
    local copy = {
        Id = payload.Id,
        Name = payload.Name,
        UnitId = payload.UnitId,
        Pos = payload.Pos,
        CFrame = payload.CFrame,
    }
    -- Called inside __namecall: cached scalars/tables only. Never call Roblox APIs,
    -- require(), GUI accessors or any helper that can yield/change the namecall method.
    local now = os.clock()
