function H.ResolveUnit(action, recordedOwner)
    local equipped = H.Equipped()
    for _, u in ipairs(equipped) do
        if u.Id == action.UnitId and u.Name == action.Name then
            return u.Id
        end
    end
    local match, count = nil, 0
    for _, u in ipairs(equipped) do
        if u.Name == action.Name then
            match = u.Id
            count = count + 1
        end
    end
    if count == 1 then
        return match
    end
    if count > 1 then
        return nil, "Multiple equipped copies match " .. action.Name
    end
    if not H.InventoryData and #equipped == 0 and H.Units[action.UnitId]
        and H.Units[action.UnitId].Name == action.Name then
        return action.UnitId
    end
    -- Inventory UUIDs are saved in macro files, while H.Learn's cache lasts only
    -- for this injection. A fresh match must not require an earlier manual Place.
    -- With no readable inventory, submit the recorded UUID once and let the
    -- existing TowerAdd receipt gate confirm it. Never override live equipment.
    if not H.InventoryData and #equipped == 0 then
        if recordedOwner ~= nil and tonumber(recordedOwner) ~= P.UserId then
            return nil, "Macro belongs to another account; local equipped loadout is required"
        end
        local id = action.UnitId
        if type(id) == "string" and #id == 36
            and id:match("^%x%x%x%x%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%x%x%x%x%x%x%x%x$") then
            return id, "Recorded UUID; awaiting server placement confirmation"
        end
    end
    return nil
end
function H.CheckMacroLoadout(profile)
