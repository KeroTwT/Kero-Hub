    end
    if H.SoloWebhookPending and os.clock() - H.SoloReturnStartedAt < 8 then
        return
    end
    if os.clock() < (H.Next.SoloReturn or 0) then
        return
    end
    H.Next.SoloReturn = os.clock() + 15
