-- Convert a saved waypoint fingerprint only when the entire path still matches
-- a rigid horizontal rotation/translation. Never rewrite the user's macro file.
function H.AdaptMacroMap(profile, current)
    if not profile.Map or profile.Map == current then return profile end
    local function parse(text)
        if type(text) ~= "string" then return end
        local nodes, order = {}, {}
        for part in text:gmatch("[^;]+") do
            local name, x, y, z = part:match("^([^:;]+):([%d%.%-]+),([%d%.%-]+),([%d%.%-]+)$")
            x, y, z = tonumber(x), tonumber(y), tonumber(z)
            if not name or nodes[name] or not x or not y or not z then return end
            nodes[name] = {x,y,z};order[#order+1] = name
        end
        if #order < 3 then return end
        return nodes, order
    end
    local old, names = parse(profile.Map)
    local live, liveNames = parse(current)
    if not old or not live or #names ~= #liveNames then
        return nil, "Macro path differs from current map; cannot safely convert positions"
    end
    for _,name in ipairs(names) do
        if not live[name] then return nil, "Macro waypoint names differ from current map" end
    end
    local origin, target = old[names[1]], live[names[1]]
    local farthest, distance = nil, 0
    for _,name in ipairs(names) do
        local p = old[name]
        local d = (p[1]-origin[1])^2 + (p[3]-origin[3])^2
        if d > distance then farthest, distance = name, d end
    end
    if distance < 1 then return nil, "Macro path is too short to align" end
    local a, b = old[farthest], live[farthest]
    local ax, az, bx, bz = a[1]-origin[1], a[3]-origin[3], b[1]-target[1], b[3]-target[3]
    local liveDistance = bx*bx+bz*bz
    if math.abs(math.sqrt(distance)-math.sqrt(liveDistance)) > .3 then
        return nil, "Macro path size changed; cannot safely convert positions"
    end
    local scale = math.sqrt(distance*liveDistance)
    local cosine, sine = (ax*bx+az*bz)/scale, (ax*bz-az*bx)/scale
    local function position(p)
        local x, z = p[1]-origin[1], p[3]-origin[3]
        return {target[1]+cosine*x-sine*z, target[2]+p[2]-origin[2], target[3]+sine*x+cosine*z}
    end
    for _,name in ipairs(names) do
        local p, q = position(old[name]), live[name]
        if (p[1]-q[1])^2+(p[2]-q[2])^2+(p[3]-q[3])^2 > .3^2 then
            return nil, "Macro path layout changed; cannot safely convert positions"
        end
    end
    local converted = {}
    for key,value in pairs(profile) do converted[key] = value end
    converted.Map, converted.Actions = current, {}
    for i,action in ipairs(profile.Actions) do
        local copy = {}
        for key,value in pairs(action) do copy[key] = value end
        if type(action.CFrame) == "table" and #action.CFrame == 12 then
            local cf, p = action.CFrame, position(action.CFrame)
            copy.CFrame = {p[1],p[2],p[3],
                cosine*cf[4]-sine*cf[10], cosine*cf[5]-sine*cf[11], cosine*cf[6]-sine*cf[12],
                cf[7],cf[8],cf[9],
                sine*cf[4]+cosine*cf[10], sine*cf[5]+cosine*cf[11], sine*cf[6]+cosine*cf[12]}
        end
        if type(action.Pos)=="table" and #action.Pos==3 then copy.Pos=position(action.Pos)end
        converted.Actions[i] = copy
    end
    return converted
end
