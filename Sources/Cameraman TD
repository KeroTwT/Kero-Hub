        Kind = kind,
        Key = key,
        Time = stamp and stamp.Time or H.RecordTime(r),
        Wave = stamp and stamp.Wave or H.Wave(),
    }
    if kind == "Place" then
        local payload=stamp and stamp.Payload
        local towerPos=H.Position and H.Position(tower)
