function H.WaitUntil(fn, seconds, serial)
    local deadline = seconds and (os.clock() + seconds) or math.huge
    repeat
        if not H.Running or H.Serial ~= serial or not H.Playing or not H.Active() then
            return false, "Cancelled / match ended"
        end
        if fn() then
            return true
        end
        task.wait(0.1)
    until os.clock() >= deadline
    return false, "Timed out waiting for confirmation"
end
-- Money waits are not server acknowledgements and must survive slow income.
function H.MacroCash()
    local cash=H.Cash()
    local pending=H.MacroSpend
    if pending and cash~=pending.Before then H.MacroSpend=nil;pending=nil end
    return math.max(0,cash-(pending and pending.Amount or 0))
end
function H.ReserveMacroSpend(before,amount)
    amount=math.max(0,tonumber(amount)or 0)
    if H.Cash()~=before then H.MacroSpend=nil;return end
    local pending=H.MacroSpend
    H.MacroSpend={Before=before,Amount=amount+(pending and pending.Before==before and pending.Amount or 0)}
end
function H.WaitFunds(costFn, seconds, serial, actionLabel)
    return H.WaitUntil(function()
        local cost = tonumber(costFn()) or 0
        local cash = H.MacroCash()
        if cash >= cost then
            return true
        end
        H.SetStatus("Macro", string.format("%s | waiting for money: %s / %s", actionLabel, cash, cost))
        return false
    end, seconds, serial)
end
function H.WaitUpgradeCadence(serial, actionLabel)
    return H.WaitUntil(function()
        local remaining = (H.NextMacroUpgradeAt or 0) - os.clock()
        if remaining <= 0 then return true end
        H.SetStatus("Macro", actionLabel .. " | synchronizing previous upgrade")
        return false
    end, nil, serial)
end
function H.SendSkip(source)
    H.SkipAutomationThreads = H.SkipAutomationThreads or setmetatable({}, { __mode = "k" })
    local thread = coroutine.running()
    local previous = H.SkipAutomationThreads[thread]
    local wave = H.Wave()
    H.SkipAutomationThreads[thread] = source
    local result = table.pack(pcall(H.Fire, "WaveSkip"))
    H.SkipAutomationThreads[thread] = previous
    if not result[1] then
        return false, "WaveSkip call failed"
    end
    if result[2] then
        H.SkipSubmittedWave = wave
    end
    return table.unpack(result, 2, result.n)
end
function H.SkipVoteComplete(wave)
    if H.Wave()~=wave then return false end
    local label=H.GUI("Stats/WaveSkipGui/Title")
    local votes,total
    if label then votes,total=label.Text:match("(%d+)%s*/%s*(%d+)") end
    return tonumber(total) and tonumber(total)>0 and tonumber(votes)>=tonumber(total) or false
end
function H.PlayRecordedSkip(action, serial)
    local target = tonumber(action.Wave) or 0
    local ready, reason = H.WaitUntil(function()
        return H.Wave() >= target
    end, nil, serial)
    if not ready then
        return false, reason
    end
    if H.Wave() > target or H.SkipVoteComplete(target) then
        return true
    end
    ready, reason = H.WaitUntil(function()
        return H.Wave() > target or H.Visible(H.GUI("Stats/WaveSkipGui"))
    end, 30, serial)
    if not ready then
        return false, "Skip vote did not become available"
    end
    if H.Wave() > target then
        return true
    end
    local label = H.GUI("Stats/WaveSkipGui/Title")
    local votes, total
    if label then
        votes, total = label.Text:match("(%d+)%s*/%s*(%d+)")
    end
    if votes and tonumber(total) and tonumber(total) > 0 and tonumber(votes) >= tonumber(total) then
        return true
    end
    return H.SendSkip("Playback")
end
function H.FindPlacement(action, excluded, pending)
    excluded = excluded or {}
    local receipt = pending and pending.ReceiptId and H.Towers[pending.ReceiptId]
    if receipt and not excluded[receipt.Id] and receipt.Name == action.Name then
        return receipt
    end
    local target=action.Pos or action.CFrame
    local pos = pending and pending.Position or Vector3.new(target[1], target[2], target[3])
    local candidates = {}
    for _, t in ipairs(H.Owned()) do
        local p = H.Position(t)
        if not excluded[t.Id] and t.Name == action.Name and p and (p - pos).Magnitude < 1 then
            table.insert(candidates, { Tower = t, Distance = (p - pos).Magnitude })
        end
    end
    table.sort(candidates, function(a, b)
        return a.Distance < b.Distance
    end)
    if #candidates > 1 and math.abs(candidates[1].Distance - candidates[2].Distance) < 0.05 then
        return nil, "Placed tower identity is ambiguous"
    end
    return candidates[1] and candidates[1].Tower
end
function H.AdjustMacroPlacement(cf, pos, allowShift, minDistance)
    if not allowShift then
        return cf, pos, Vector3.new(0, 0, 0)
    end
    local minimum = tonumber(minDistance) or 3.2
    local total = Vector3.new(0, 0, 0)
    -- Resolve small borderline overlaps against already confirmed own towers.
    -- Iteration handles a point caught between two neighbours without retries.
    for _ = 1, 12 do
        local moved = false
        for _, tower in ipairs(H.Owned()) do
            local other = H.Position(tower)
            if other then
                local dx, dz = pos.X - other.X, pos.Z - other.Z
                local distance = math.sqrt(dx * dx + dz * dz)
                if distance < minimum then
                    if distance < .001 then dx, dz, distance = 1, 0, 1 end
                    local amount = minimum - distance
                    local delta = Vector3.new(dx / distance * amount, 0, dz / distance * amount)
                    pos, cf, total = pos + delta, cf + delta, total + delta
                    moved = true
                end
            end
        end
        if not moved then break end
    end
    return cf, pos, total
end
function H.WaitPlacementResources(action, unit, serial, actionLabel)
    local cost
    local ready,why=H.WaitUntil(function()
        cost = H.UnitCost(action.Name, H.Units[unit]) or action.Cost or 0
        local cash = H.MacroCash()
        local label = H.GUI("Stats/OtherUI/Towers")
        local count, limit
        if label then count, limit = label.Text:match("(%d+)%s*/%s*(%d+)") end
        count, limit = tonumber(count), tonumber(limit)
        if count and limit and limit > 0 and count >= limit then
            H.SetStatus("Macro", string.format("%s | waiting for a free tower slot: %d/%d", actionLabel, count, limit))
            return false
        end
        if cash < cost then
            H.SetStatus("Macro", string.format("%s | waiting for money: %s / %s", actionLabel, cash, cost))
            return false
        end
        if os.clock()<(H.NextMacroPlacementAt or 0)then
            H.SetStatus("Macro",actionLabel.." | synchronizing previous placement")
            return false
        end
        return true
    end, nil, serial)
    return ready,why,cost
end
function H.ActionReady(action, started, mode, context)
    local money = H.Cash() >= (tonumber(action.Cost) or 0)
    if mode == "Time" then
        return H.GameClock() - started >= (tonumber(action.Time) or 0)
    end
    if mode == "Money" then
        return money
    end
    -- Hybrid follows wave and funds; Skip timing belongs to its own wave.
    -- Legacy macros retain the delay after the previous action on the same wave.
    if action.Kind == "Skip" then
        local target = tonumber(action.Wave) or 0
        local wave = H.Wave()
        -- A passed wave needs no vote and must not hold up the remaining macro.
        if wave > target or (wave == target and H.SkipVoteComplete(target)) then
            return true
        end
        if wave<target then return false end
        if tonumber(action.WaveTime) and H.WaveStartedGame then
            return H.GameClock()-H.WaveStartedGame >= math.max(0,tonumber(action.WaveTime))
        end
        local previous=context and context.Previous
        if previous and tonumber(previous.Wave)==target then
            local delay=math.max(0,(tonumber(action.Time) or 0)-(tonumber(previous.Time) or 0))
            return H.GameClock()-(context.CompletedAt or started)>=delay
        end
        return H.GameClock() - started >= (tonumber(action.Time) or 0)
    end
    return H.Wave() >= (tonumber(action.Wave) or 0) and money
end
