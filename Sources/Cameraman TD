-- Executor GC APIs may omit tables or return sparse/dictionary collections.
-- Every discovery route must still prove ownership using the replica's tags.
function H.ReadLocalReplica(object, source, id)
    if type(object) ~= "table" then return false end
    local tags, data = rawget(object, "Tags"), rawget(object, "Data")
    local replicaId = rawget(object, "Id")
    if type(tags) ~= "table" or type(data) ~= "table" then
        tags, data = rawget(object, 2), rawget(object, 3)
        replicaId = tonumber(id) and id or nil
    end
    local owner = type(tags) == "table" and rawget(tags, "UserId")
    -- Updated ReplicaClient uses a positional owner tag. An explicit named tag
    -- remains authoritative; never accept a conflicting positional owner.
    if owner == nil and type(tags) == "table" then owner = rawget(tags, 1) end
    if type(tags) ~= "table" or tonumber(owner) ~= P.UserId
        or type(data) ~= "table" or type(rawget(data, "Towers")) ~= "table" then return false end
    H.Inventory(data)
    if replicaId ~= nil then H.ReplicaId = replicaId end
    H.LoadoutSource = source
    return true
end
function H.RecoverLoadout(objects, batched)
    local seen, count, entries, batchAt = {}, 0, 0, os.clock()
    local function scan(value, depth, source, id)
        local kind = type(value)
        if (kind ~= "table" and kind ~= "function") or seen[value] or depth > 6
            or count >= 4096 or entries >= 20000 or not H.Running then return false end
        seen[value] = true;count = count + 1
        if batched and os.clock()-batchAt >= .002 then task.wait();batchAt=os.clock() end
        if kind == "table" then
            if H.ReadLocalReplica(value, source, id) then return true end
            for key, child in next, value do
                entries = entries + 1
                if entries >= 20000 then break end
                if scan(child, depth+1, source, key) then return true end
            end
        else
            local upvalues = getupvalues or (debug and debug.getupvalues)
            if type(upvalues) == "function" then
                local ok, values = pcall(upvalues, value)
                if ok and type(values) == "table" and scan(values, depth+1, source) then return true end
            else
                local upvalue = getupvalue or (debug and debug.getupvalue)
                if type(upvalue) == "function" then for index=1,64 do
                    local ok, first, second = pcall(upvalue, value, index)
                    if not ok or first == nil then break end
