function H.StartPlayback()
    if H.Playing or H.Recording then
        H.Notify("Stop the active macro first")
        return false
    end
    if not H.Active() then
        H.SetStatus("Macro", "Waiting for match / intermission")
        return false, "wait"
    end
    if H.Auto and H.Auto.Busy() then
        H.SetStatus("Macro", "Waiting for outstanding Auto Play requests")
        return false, "wait"
    end
    local profile = H.Read(H.File(S.Profile))
    local recordedOwner = H.ProfileOwner(S.Profile, profile, true)
    if not H.ValidProfile(profile) or #profile.Actions == 0 then
        H.Notify("Selected macro is empty or invalid")
        return false
    end
    H.LoadedProfile = profile
    H.LearnProfileCosts(profile)
    local current = H.CurrentMap()
    if not current then
        H.SetStatus("Macro", "Waiting for map waypoints")
        return false, "wait"
    end
    local converted, mapReason = H.AdaptMacroMap(profile, current)
    if not converted then
        H.Notify(mapReason)
        return false
    end
    profile = converted
    H.SortMacroActions(profile)
    H.Hydrate()
    local loadoutReady, loadoutReason = H.CheckMacroLoadout(profile)
    if not loadoutReady then
        H.PlaybackFailure, H.PlaybackCompleted = true, nil
        H.SetStatus("Macro", loadoutReason)
        H.Notify(loadoutReason)
        return false
    end
    local mode = S.PlaybackMode
    if mode ~= "Money" and (tonumber(profile.Actions[1].Wave) or 0) > 0 and H.Wave() < 1 then
        H.SetStatus("Macro", "Playback armed: waiting for wave 1")
        return false, "wait"
    end
    H.PlaybackFailure = nil
    H.PlaybackCompleted = nil
    H.PendingMacroPlacement = nil
    H.NextMacroUpgradeAt = nil
    H.Playing = true
    H.Serial = H.Serial + 1
    if S.AutoPlayback then
        H.AutoPlayed = true
    end
    local serial = H.Serial
    local start = H.GameClock()
    local context = {}
    local refs = {}
    local claimed = {}
    local fundsTimeout = nil -- Wait for income until cancelled / match ended.
    -- Baseline must be captured before any request; never bind a pre-existing tower.
    for _, t in ipairs(H.Owned()) do
        claimed[t.Id] = true
    end
    task.spawn(function()
        local phase, actionLabel = "starting", "macro"
        local ok, err = pcall(function()
            for index, a in ipairs(profile.Actions) do
                actionLabel =
                    string.format("Action %d/%d | %s %s", index, #profile.Actions, a.Kind, a.Name or a.Key or "WaveSkip")
                phase = "waiting for playback condition"
                H.SetStatus(
                    "Macro",
                    string.format("Playing %s: %d/%d | %s", S.Profile, index, #profile.Actions, a.Kind)
                )
                H.PlaybackIndex = index
                H.PlaybackTotal = #profile.Actions
                local ready, why = true, nil
                -- Money has no recorded Cost/Wave/Time gate. Each spending action
                -- below checks its current price; Target/Sell execute immediately.
                if mode ~= "Money" then
                    ready, why = H.WaitUntil(function()
                        return H.ActionReady(a, start, mode, context)
                    end, nil, serial)
                    assert(ready, "Playback condition not reached (wave / time / money)")
                end
                if a.Kind == "Place" then
                    phase = "waiting for equipped loadout"
                    local unit, unitReason = H.WaitForUnit(a, serial, recordedOwner)
                    assert(
                        unit,
                        unitReason
                            or (
                                "Cannot resolve equipped unit: "
                                .. a.Name
                                .. "; refresh loadout / equip the recorded unit"
                            )
                    )
                    phase = "waiting for placement money / tower slot"
                    local placementCost
                    ready, why, placementCost = H.WaitPlacementResources(a, unit, serial, actionLabel)
                    assert(ready, why)
                    phase = "sending placement"
                    local cf = CFrame.new(unpack(a.CFrame))
                    local pos=type(a.Pos)=="table"and Vector3.new(unpack(a.Pos))or cf.Position
                    local adjustment
                    cf,pos,adjustment=H.AdjustMacroPlacement(cf,pos)
                    local cashBefore=H.Cash()
                    H.LastMacroPlacement={Name=a.Name,RecordedUnitId=a.UnitId,SentUnitId=unit,
                        LoadoutSource=H.LoadoutSource or (H.InventoryData and "local replica"or "recorded UUID fallback"),
                        Cash=cashBefore,AvailableCash=H.MacroCash(),Cost=placementCost or a.Cost,
                        SentAt=os.clock(),Frame=a.CFrame,Pos={pos.X,pos.Y,pos.Z},
                        Adjustment={adjustment.X,adjustment.Y,adjustment.Z},Confirmed=false}
                    -- Time playback follows the recorded schedule and must catch up
                    -- quickly. Other modes use the conservative live-tested cadence.
                    H.NextMacroPlacementAt=os.clock()+(mode=="Time"and .5 or 2)
                    local pendingPlacement={Name=a.Name,UnitId=unit,Position=pos}
                    H.PendingMacroPlacement=pendingPlacement
                    local sent, problem =
                        H.Fire("TowerAdd", { Name = a.Name, UnitId = unit, Pos = pos, CFrame = cf })
                    if not sent then H.PendingMacroPlacement=nil end
                    assert(sent, problem)
                    H.ReserveMacroSpend(cashBefore,placementCost or a.Cost)
                    phase = "waiting for TowerAdd confirmation"
                    local found, identityError
                    ready, why = H.WaitUntil(function()
                        found, identityError = H.FindPlacement(a, claimed, pendingPlacement)
                        return found ~= nil or identityError ~= nil
                    end, 10, serial)
                    assert(not identityError, identityError)
                    if not ready and type(writefile)=="function"then pcall(function()
                        H.LastMacroPlacement.CurrentCash=H.Cash();H.LastMacroPlacement.LoadoutGC=H.LoadoutGC
                        writefile("CameraTD_Macro_Debug.json",game:GetService("HttpService"):JSONEncode(H.LastMacroPlacement))
                    end)end
                    assert(ready, "Placement unconfirmed" .. (H.LastMacroPlacement.LastNotice and (" (" .. H.LastMacroPlacement.LastNotice .. ")") or "")
                        .. "; check equipped tower " .. a.Name
                        .. " and its recorded UUID. Stopped to avoid duplicate placements")
                    H.PendingMacroPlacement=nil
                    H.LastMacroPlacement.Confirmed=true
                    refs[a.Key] = found.Id
                    claimed[found.Id] = true
                elseif a.Kind == "Skip" then
                    phase = "waiting for recorded skip wave / vote"
                    ready, why = H.PlayRecordedSkip(a, serial)
                    assert(ready, why)
                else
                    local id = refs[a.Key]
                    local t = id and H.Towers[id]
                    assert(t, "Missing recorded tower " .. a.Key)
                    if a.Kind == "Upgrade" then
                        while (tonumber(t.Level) or 1) < a.Level do
                            local before = tonumber(t.Level) or 1
                            phase = "waiting for upgrade money"
                            ready, why = H.WaitFunds(function()
                                return H.UpgradeCost(t) or a.Cost or 0
                            end, fundsTimeout, serial, actionLabel)
                            assert(ready, why)
                            ready, why = H.WaitUpgradeCadence(serial, actionLabel)
                            assert(ready, why)
                            phase = "sending upgrade"
                            local cashBefore=H.Cash()
                            local upgradeCost=H.UpgradeCost(t)or a.Cost or 0
                            local sent, problem = H.Fire("TowerUpgrade", { Id = id })
                            assert(sent, problem)
                            H.NextMacroUpgradeAt = os.clock() + .35
                            H.ReserveMacroSpend(cashBefore,upgradeCost)
                            phase = "waiting for TowerUpgrade confirmation"
                            ready, why = H.WaitUntil(function()
                                t = H.Towers[id]
                                return t and (tonumber(t.Level) or 1) > before
                            end, 10, serial)
                            assert(ready, "Upgrade unconfirmed; playback stopped")
                        end
                    elseif a.Kind == "Target" then
                        for _ = 1, 12 do
                            if t.TargetMode == a.Target then
                                break
                            end
                            ready, why = H.WaitUpgradeCadence(serial, actionLabel)
                            assert(ready, why)
                            phase = "waiting for TowerTarget confirmation"
                            local before = t.TargetMode
                            local sent, problem = H.Fire("TowerTarget", { Id = id })
                            assert(sent, problem)
                            H.NextMacroUpgradeAt = os.clock() + .35
                            ready, why = H.WaitUntil(function()
                                t = H.Towers[id]
                                return t and t.TargetMode ~= before
                            end, 5, serial)
                            assert(ready, why)
                        end
                        assert(t.TargetMode == a.Target, "Target mode could not be reached")
                    elseif a.Kind == "Sell" then
                        phase = "waiting for TowerRemove confirmation"
                        local sent, problem = H.Fire("TowerSell", { Id = id })
                        assert(sent, problem)
                        ready, why = H.WaitUntil(function()
                            return H.Removed[id] ~= nil
                        end, 10, serial)
                        assert(ready, why)
                    end
                end
                context.Previous,context.CompletedAt=a,H.GameClock()
            end
        end)
        if H.Serial == serial then
            H.PendingMacroPlacement = nil
            H.Playing = false
            H.PlaybackFailure = not ok and true or nil
            H.PlaybackCompleted = ok and true or nil
            if ok then
                H.Auto.NextAt = 0
                H.PlaybackIndex = 0
            end
            local reason = tostring(err):gsub("^.-:%d+:%s*", "")
            H.SetStatus(
                "Macro",
                ok and "Playback complete"
                    or string.format("Stopped: %s | %s | cash %s | %s", actionLabel, phase, H.Cash(), reason)
            )
        end
    end)
    return true
end
function H.AutoPlaybackStep(active, now)
    if active and S.AutoPlayback and not H.AutoPlayed and not H.Recording and not H.Playing
        and now >= (H.Next.AutoPlayback or 0) then
        local started, reason=H.StartPlayback()
        H.Next.AutoPlayback=now+(reason=="wait" and 0.3 or 10)
        H.AutoPlayed=started or reason~="wait" or nil
    end
end
-- Resolve costs from the game's own configuration when available.
function H.ConfigUnit(name)
    local root = H.Path(RS, "ModuleLoader/Configs/Config")
    if not root then
        return nil
    end
    if root:IsA("ModuleScript") then
        if not H.Config then
            local ok, c = pcall(require, root)
            if ok then
                H.Config = c
            end
        end
        local config = H.Config
        if type(config) == "table" and type(config.Towers) == "table" then
            return config.Towers[name]
        end
    end
    local unit = H.Path(root, "Towers/" .. name)
    if unit then
        local module = unit:IsA("ModuleScript") and unit or unit:FindFirstChild("Config")
        if module and module:IsA("ModuleScript") then
            H.ConfigUnits = H.ConfigUnits or {}
            if not H.ConfigUnits[name] then
                local ok, c = pcall(require, module)
                if ok then
                    H.ConfigUnits[name] = c
                end
            end
            return H.ConfigUnits[name]
        end
    end
end
function H.UnitCost(name, unit)
    -- A config container can exist without exposing a base price. Keep falling
    -- through to the actual equipped slot instead of returning nil early.
    local c = H.ConfigUnit(name)
    if type(c) == "table" then
        local base = c[1] or c.Stats or c
        local price = type(base) == "table" and tonumber(base.Price or base.Cost)
        if price and price > 0 then
            return price
        end
    end
    local function slotPrice(u)
        local slot = tonumber(u.Equipped)
        if not slot or slot < 1 or slot > 5 or slot % 1 ~= 0 then
            return nil
        end
        local label = H.GUI("Slots/Slot" .. string.format("%d", slot) .. "/TroopFrame/Price")
        local raw = label and label.Text:gsub(",", ""):match("[%d%.]+")
        local price = tonumber(raw)
        if price and price > 0 then
            return price
        end
    end
    if unit then
        local price = slotPrice(unit)
        if price then
            return price
        end
    else
        for _, u in ipairs(H.Equipped()) do
            if u.Name == name then
                local price = slotPrice(u)
                if price then
                    return price
                end
            end
        end
    end
    return H.KnownCosts[name] and H.KnownCosts[name][1] or nil
end
function H.UpgradeCost(tower)
    if not tower then
        return nil
    end
    local c = H.ConfigUnit(tower.Name)
    local levels = type(c) == "table" and (c.Upgrades or c.Levels or c)
    local nextLevel = type(levels) == "table" and levels[(tonumber(tower.Level) or 1) + 1]
    local configured = type(nextLevel) == "table" and tonumber(nextLevel.Price or nextLevel.Cost)
    if configured ~= nil then
        return configured
    end
    local known = H.KnownCosts[tower.Name]
    return known and known[(tonumber(tower.Level) or 1) + 1] or nil
end
function H.Maps()
