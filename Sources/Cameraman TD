function H.SellFarmStep()
    if not S.AutoSellFarm then H.FarmSell = nil; return end
    if not H.Active() or H.FinalSeen or H.SoloReturning or H.Wave() < S.SellFarmWave then return end
    local now = os.clock()
    local state = H.FarmSell
    if not state then
        state = { Queue = {}, Index = 1, Pending = {}, Attempted = {}, NextAt = now, Sold = 0 }
        H.FarmSell = state
    end
    local function appendNewFarms()
        local added = false
        for _, tower in ipairs(H.Owned()) do
            if H.IsFarm(tower) and not state.Attempted[tower.Id] then
                state.Attempted[tower.Id] = true
                table.insert(state.Queue, tower.Id)
                added = true
            end
        end
        return added
    end
    if appendNewFarms() then state.Done = nil end
    if state.Done then return end
    if state.Index > #state.Queue and not next(state.Pending) then
        H.FarmSell = nil
        return
    end
    local waiting = false
    for id, deadline in pairs(state.Pending) do
        if not H.Towers[id] then
            state.Pending[id] = nil
            state.Sold = state.Sold + 1
        elseif now >= deadline then
            state.Pending[id] = nil
            state.Unconfirmed = (state.Unconfirmed or 0) + 1
        else waiting = true end
    end
    if now < state.NextAt then return end
    local id = state.Queue[state.Index]
    if id then
        state.Index = state.Index + 1
        local tower = H.Towers[id]
        if H.IsFarm(tower) then
            state.NextAt = now + S.SellFarmDelay
            state.Pending[id] = now + 5
            H.FarmSellThreads = H.FarmSellThreads or setmetatable({}, { __mode = "k" })
            local thread = coroutine.running()
            local previous = H.FarmSellThreads[thread]
            H.FarmSellThreads[thread] = true
            local ok, sent = pcall(H.Fire, "TowerSell", { Id = id })
            H.FarmSellThreads[thread] = previous
            if not ok or not sent then
                state.Pending[id] = nil
                state.Unconfirmed = (state.Unconfirmed or 0) + 1
            end
        end
    elseif not waiting then
        -- TowerAdd receipts can arrive after the wave threshold. Re-scan before
        -- completing, and keep the state able to reopen for newly placed farms.
        if appendNewFarms() then
            state.Done = nil
        else
            state.Done = true
            H.SetStatus("FarmSell", string.format("Farm sale: %d confirmed, %d unconfirmed", state.Sold, state.Unconfirmed or 0))
        end
    end
end
