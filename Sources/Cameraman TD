function H.ClaimableQuests()
    local result = {}
    local daily = H.InventoryData and H.InventoryData.ActiveQuests and H.InventoryData.ActiveQuests.Daily
    if type(daily) == "table" and type(daily.Quests) == "table" then
        local generation = tostring(daily.LastUpdate or 0)
        for _, quest in pairs(daily.Quests) do
            if type(quest) == "table" and type(quest.Id) == "string" then
                local key = generation .. "/Daily/" .. quest.Id
                local current, target = tonumber(quest.CurrentProgress), tonumber(quest.Progress)
                local done = quest.Completed == true or quest.State == "Completed"
                    or (current and target and target > 0 and current >= target)
                if done and quest.RewardClaimed ~= true then
                    table.insert(result, { Id = quest.Id, Key = key, Type = "Daily" })
                end
            end
        end
    else
        -- Local row flags remain usable when the Quests panel is closed.
        local list = H.Path(P:FindFirstChild("PlayerGui"), "Main/Main/Quests/QuestsFrame/AllQuests/List")
        if list then
            for _, row in ipairs(list:GetChildren()) do
                if row.Name ~= "Template" then
                    local amount = H.Path(row, "Progress/AmountDone")
                    local claim = H.Path(row, "Progress/ClaimButton")
                    local claimed = H.Path(row, "Progress/ClaimedText")
                    local current, target
                    if amount then current, target = amount.Text:match("(%d+)%s*/%s*(%d+)") end
                    if current and tonumber(target) > 0 and tonumber(current) >= tonumber(target)
                        and claim and claim.Visible and not (claimed and claimed.Visible) then
                        table.insert(result, { Id = row.Name, Key = "GUI/Daily/" .. row.Name, Type = "Daily" })
                    end
