function H.InventorySellPlan(name, mode)
    local data = H.InventoryData
    if type(data) ~= "table" or type(data.Towers) ~= "table" then return nil, "Waiting for your inventory" end
    if type(name) ~= "string" or name == "" then return nil, "Select a unit first" end
    local ids, total = {}, 0
    for id, unit in pairs(data.Towers) do
        if type(id) == "string" and type(unit) == "table" and unit.Name == name then
            total = total + 1
            if unit.Equipped ~= true and (tonumber(unit.Equipped) or 0) < 1 and unit.Locked ~= true then
                ids[#ids + 1] = id
            end
        end
    end
    table.sort(ids)
    local amount
    if mode == "All" then amount = #ids
    elseif mode == "Half" then amount = math.min(#ids, math.floor(total / 2))
    elseif mode == "KeepOne" then amount = math.min(#ids, math.max(0, total - 1))
    else return nil, "Unknown inventory sell mode" end
    while #ids > amount do ids[#ids] = nil end
    return ids
end
