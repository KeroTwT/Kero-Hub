    if R.Attempts == 0 then return end
    R.Log("teleport_state", { state = tostring(state) })
    if state == Enum.TeleportState.Started or state == Enum.TeleportState.InProgress then
        R.InFlight = R.InFlight or os.clock()
        R.Status("Teleporting to lobby")
    elseif state == Enum.TeleportState.Failed then R.InFlight = nil end
end)
