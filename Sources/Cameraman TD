    end
end

function H.WalkToJoin(position, target)
    if not H.Running or not S.AutoLobby or S.JoinMethod ~= "Walk" or game.PlaceId ~= H.LobbyId then
        H.CancelJoinWalk()
        return false
    end
    local character = P.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not root or not humanoid or humanoid.Health <= 0 then
        H.CancelJoinWalk()
        H.SetStatus("Lobby", "Waiting for character")
        return false
    end
    local function near(a, b, radius)
        local delta = a - b
        return Vector3.new(delta.X, 0, delta.Z).Magnitude <= radius and math.abs(delta.Y) <= 6
    end
    local walk = H.JoinWalk
    if walk and (walk.Character ~= character or walk.Target ~= target
        or (walk.Position - position).Magnitude > 2) then
        H.CancelJoinWalk()
        walk = nil
    end
    if near(root.Position, position, 2.5) then
        H.CancelJoinWalk()
        return true
    end
    local now = os.clock()
    if not walk then
        walk = { Character = character, Root = root, Humanoid = humanoid,
            Position = position, Target = target, ProgressPosition = root.Position,
            ProgressAt = now, NextPlanAt = 0 }
        H.JoinWalk = walk
        -- Advance waypoints independently of the slower lobby decision loop.
        task.spawn(function()
            local nextCheck = 0
            local map = S.Map
            while H.JoinWalk == walk do
                if not H.Running or not S.AutoLobby or S.JoinMethod ~= "Walk"
                    or game.PlaceId ~= H.LobbyId or H.Teleporting or H.Elevator
                    or P.Character ~= character or not root.Parent or not humanoid.Parent
                    or humanoid.Health <= 0 or S.Map ~= map then
                    H.CancelJoinWalk()
                    return
                end
                if os.clock() >= nextCheck then
                    nextCheck = os.clock() + 0.4
                    local elevators = WS:FindFirstChild("Elevators")
                    local elevator = elevators and elevators:FindFirstChild(target)
                    if not string.match(target, "^Exit:") and (not elevator
                        or elevator:GetAttribute("Map") ~= S.Map or H.CircleOccupied(elevator, false)) then
                        H.CancelJoinWalk()
                        return
                    end
                end
                local ok, err = pcall(H.WalkToJoin, position, target)
                if not ok then
                    if H.JoinWalk == walk then H.CancelJoinWalk() end
                    H.SetStatus("Lobby", "Walking failed: " .. tostring(err))
                    return
                end
                if H.JoinWalk ~= walk then return end
                task.wait(0.08)
            end
        end)
    end
    if (root.Position - walk.ProgressPosition).Magnitude >= 0.75 then
        walk.ProgressPosition, walk.ProgressAt = root.Position, now
    end
    -- One path request at a time; no per-frame movement or teleport fallback.
    if not H.JoinPathBusy and now >= walk.NextPlanAt
        and (not walk.Points or now - walk.ProgressAt >= 3) then
        walk.NextPlanAt = now + 4
        H.JoinPathBusy = true
        task.spawn(function()
            local ok, points = pcall(function()
                local path = game:GetService("PathfindingService"):CreatePath({
                    AgentRadius = 2, AgentHeight = 5, AgentCanJump = true,
                })
                path:ComputeAsync(root.Position, position)
                if path.Status == Enum.PathStatus.Success then return path:GetWaypoints() end
            end)
            H.JoinPathBusy = false
            if H.JoinWalk ~= walk or not H.Running or not S.AutoLobby
                or S.JoinMethod ~= "Walk" or game.PlaceId ~= H.LobbyId
                or P.Character ~= character then return end
            -- A missing path still uses ordinary MoveTo; never snap the character.
            walk.Points = ok and type(points) == "table" and #points > 0
                and points or { { Position = position } }
            walk.Index, walk.LastMoveIndex, walk.ProgressAt = 1, nil, os.clock()
        end)
    end
    if not walk.Points then return false end
    while walk.Index <= #walk.Points and near(root.Position, walk.Points[walk.Index].Position, 2) do
        walk.Index = walk.Index + 1
    end
    local point = walk.Points[walk.Index]
    if not point then
        walk.Points = nil
        return false
    end
    if walk.LastMoveIndex ~= walk.Index or now - (walk.LastMoveAt or -math.huge) >= 6 then
        if point.Action == Enum.PathWaypointAction.Jump then humanoid.Jump = true end
        humanoid:MoveTo(point.Position)
        walk.LastMoveIndex, walk.LastMoveAt = walk.Index, now
    end
    return false
end

function H.SetJoinMethod(value)
    S.JoinMethod = value == "Walk" and "Walk" or "TP"
    H.CancelJoinWalk()
    H.JoinWalkExit, H.LobbyAttempt = nil, nil
    H.SaveSettings()
end

function H.AvoidCircle(elevator)
    H.CircleCooldowns = H.CircleCooldowns or {}
    H.CircleCooldowns[elevator.Name] = os.clock() + 15
    H.Invoke("ElevatorLeave", elevator.Name)
    local pad = elevator:FindFirstChild("Pad")
    local pos = pad and (pad:IsA("Model") and pad:GetPivot().Position or pad.Position)
    H.CancelJoinWalk()
    if pos and P.Character then
        if S.JoinMethod == "Walk" then
            H.JoinWalkExit = { Position = pos + Vector3.new(24, 0, 0), Id = elevator.Name }
        else
            P.Character:PivotTo(CFrame.new(pos + Vector3.new(24, 3, 0)))
        end
    end
    H.Elevator = nil
    H.IsHost = false
    H.StartRequested = nil
    H.LobbyAttempt = nil
    H.SetStatus("Lobby", "Another player in " .. elevator.Name .. "; switching to an empty circle")
end

H.ModifierCatalog = { Hp_Mobs = "X2 Hp Mobs" }
function H.ModifierOptions()
    local list = H.Path(P:FindFirstChild("PlayerGui"), "ElevatorGui/Modifiers/List/ScrollingFrame")
    if list then
        for _, item in ipairs(list:GetChildren()) do
            local title = item.Name ~= "Template" and H.Path(item, "Holder/Title")
            if title and title.Text ~= "" then H.ModifierCatalog[item.Name] = title.Text end
        end
    end
    local values = {}
    for _, title in pairs(H.ModifierCatalog) do table.insert(values, title) end
    table.sort(values)
    return values
end
function H.RefreshModifiers()
    if game.PlaceId ~= H.LobbyId or os.clock() < (H.Next.ModifierCatalog or 0) then return end
    H.Next.ModifierCatalog = os.clock() + 5
    local values = H.ModifierOptions()
    local signature = table.concat(values, "|")
    if H.ModifierCatalogSignature ~= signature and H.Widgets.Modifiers then
        H.ModifierCatalogSignature = signature
        pcall(function() H.Widgets.Modifiers:Refresh(values) end)
    end
end
function H.ModifierSelection(input)
    local ids = {}
    for k, v in pairs(type(input) == "table" and input or {}) do
        local value = type(k) == "string" and v == true and k or v
        if type(value) == "string" then
            for id, title in pairs(H.ModifierCatalog) do
                if (value == id or value == title) and not table.find(ids, id) then table.insert(ids, id) end
            end
        end
    end
    table.sort(ids)
    return ids
end
function H.ModifierLabels()
    H.ModifierOptions()
    local labels = {}
    for _, id in ipairs(S.Modifiers) do table.insert(labels, H.ModifierCatalog[id] or id) end
    return labels
end
function H.ApplyModifiers()
    if not H.Elevator or not H.IsHost then return false end
    H.ModifierOptions()
    local ids = H.ModifierSelection(S.Modifiers)
    local key = H.Elevator .. "/" .. table.concat(ids, ",")
    if H.ModifierAppliedKey == key then return true end
    if os.clock() < (H.Next.Modifiers or 0) then return false end
    H.Next.Modifiers = os.clock() + 5
    local elevator = H.Elevator
    local ok, accepted = H.Invoke("ElevatorSetModifiers", elevator, ids)
    if ok and accepted == true and H.Elevator == elevator then
        H.ModifierAppliedKey = key
        return true
    end
    H.SetStatus("Lobby", "Modifier selection not accepted; waiting before start")
    return false
end

function H.LobbyStep()
    if game.PlaceId ~= H.LobbyId or not S.AutoLobby or H.Teleporting then
        H.CancelJoinWalk()
        H.JoinWalkExit = nil
        return
    end
    local elevators = WS:FindFirstChild("Elevators")
    if not elevators then
        return
    end
    if H.Elevator then
        H.CancelJoinWalk()
        H.JoinWalkExit = nil
        local elevator = elevators:FindFirstChild(H.Elevator)
        if not elevator then
            H.Elevator = nil
            return
        end
        if S.Players == 1 and (H.CircleOccupied(elevator, true) or not H.IsHost) then
            H.AvoidCircle(elevator)
            return
        end
        H.SetStatus(
            "Lobby",
            string.format(
                "%s | %s | %s/%s | %ss",
                H.Elevator,
                tostring(elevator:GetAttribute("Map")),
                tostring(elevator:GetAttribute("Players")),
                tostring(elevator:GetAttribute("MaxPlayers")),
                tostring(elevator:GetAttribute("Time"))
            )
        )
        if H.IsHost and not H.ApplyModifiers() then return end
        if
            S.StartNow
            and H.IsHost
            and not H.StartRequested
            and (tonumber(elevator:GetAttribute("Players")) or 0) >= S.Players
        then
            H.StartRequested = true
            local ok, accepted = H.Invoke("ElevatorStart", H.Elevator)
            if not ok or accepted ~= true then
                H.SetStatus("Lobby", "Start rejected; waiting for the elevator countdown")
            end
        end
        return
    end
    local character = P.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    if not hrp then
        H.SetStatus("Lobby", "Waiting for character")
        return
    end
    if H.LobbyAttempt and S.Players == 1 then
        local target = elevators:FindFirstChild(H.LobbyAttempt.Id)
        if target and H.CircleOccupied(target, true) then
            H.AvoidCircle(target)
            return
        end
    end
    if H.LobbyAttempt and os.clock() - H.LobbyAttempt.At < 15 then
        H.SetStatus("Lobby", "Waiting for ElevatorEntered confirmation")
        return
    end
    H.LobbyAttempt = nil
    if H.JoinWalkExit then
        if S.JoinMethod == "Walk" and not H.WalkToJoin(H.JoinWalkExit.Position, "Exit:" .. H.JoinWalkExit.Id) then
            H.SetStatus("Lobby", "Walking out of the occupied elevator")
            return
        end
        H.JoinWalkExit = nil
    end
    local chosen, dist
    if S.JoinMethod == "Walk" and H.JoinWalk then
        local target = elevators:FindFirstChild(H.JoinWalk.Target)
        if target and target:GetAttribute("Map") == S.Map and not H.CircleOccupied(target, false)
            and os.clock() >= ((H.CircleCooldowns or {})[target.Name] or 0) then
            chosen = target
        else
            H.CancelJoinWalk()
        end
    end
    local locked = chosen ~= nil
    for _, elevator in ipairs(elevators:GetChildren()) do
        if
            elevator:GetAttribute("Map") == S.Map
            and not H.CircleOccupied(elevator, false)
            and os.clock() >= ((H.CircleCooldowns or {})[elevator.Name] or 0)
        then
            local pad = elevator:FindFirstChild("Pad")
            local pos = pad
                and (pad:IsA("Model") and pad:GetPivot().Position or pad:IsA("BasePart") and pad.Position)
            if pos and not locked then
                local d = (pos - hrp.Position).Magnitude
                if not dist or d < dist then
                    chosen, dist = elevator, d
                end
            end
        end
    end
    if not chosen then
        H.CancelJoinWalk()
        H.SetStatus("Lobby", "Waiting for an empty elevator: " .. S.Map)
        return
    end
    if H.CircleOccupied(chosen, false) then
        return
    end
    local pad = chosen:FindFirstChild("Pad")
    local pos = pad:IsA("Model") and pad:GetPivot().Position or pad.Position
    local method = S.JoinMethod
    if method == "Walk" then
        if not H.WalkToJoin(pos, chosen.Name) then
            H.SetStatus("Lobby", "Walking to " .. chosen.Name)
            return
        end
    else
        H.CancelJoinWalk()
        character:PivotTo(CFrame.new(pos + Vector3.new(0, 3, 0)))
    end
    H.LobbyAttempt = { At = os.clock(), Id = chosen.Name }
    task.wait(0.8) -- let the game's physical zone handler run first
    if not H.Running or not S.AutoLobby or S.JoinMethod ~= method
        or chosen:GetAttribute("Map") ~= S.Map or P.Character ~= character then
        return
    end
    if S.Players == 1 and (H.CircleOccupied(chosen, true) or H.Elevator and H.Elevator ~= chosen.Name) then
        H.AvoidCircle(chosen)
        return
    end
    if not H.Elevator then
        if H.CircleOccupied(chosen, false) then
            H.AvoidCircle(chosen)
            return
        end
        local ok, accepted = H.Invoke("ElevatorEnter", chosen.Name)
        if not ok or accepted ~= true then
            H.SetStatus("Lobby", "Enter rejected; checking elevator again in 15s")
        end
    end
end
function H.LeaveElevator()
    H.CancelJoinWalk()
    H.JoinWalkExit, H.LobbyAttempt = nil, nil
    if H.Elevator then
        H.Invoke("ElevatorLeave", H.Elevator)
    end
end
function H.QueueTeleport()
    if not S.AutoExecute or H.Queued then
        return
    end
    local queue = queue_on_teleport or queueonteleport or (syn and syn.queue_on_teleport)
    if type(queue) ~= "function" or not H.FS or not isfile(H.Folder .. "/Hub.lua") then
        H.SetStatus("Macro", "Auto Execute unavailable: queue_on_teleport + shared filesystem required")
        return
    end
    local code = [=[
        if game.GameId ~= 10762636904 then return end
        task.wait(3)
        local players = game:GetService("Players")
        local player = players.LocalPlayer or players.PlayerAdded:Wait()
        local e = getgenv()
        local key = tostring(game.JobId) .. "/" .. tostring(player.UserId)
        if e.__CameraTDQueuedJob ~= key then
            local enabled = true
            local ok, raw = pcall(readfile, "CameraTD_Macros/Settings/" .. player.Name .. ".json")
            if ok then
                local good, config = pcall(function() return game:GetService("HttpService"):JSONDecode(raw) end)
                if good and type(config) == "table" then enabled = config.AutoExecute ~= false end
            end
            if enabled then
                local source = readfile("CameraTD_Macros/Hub.lua")
                local chunk, reason = loadstring(source)
                assert(chunk, reason)
                e.__CameraTDQueuedJob = key
                chunk()
            end
        end
    ]=]
    local ok, err = pcall(queue, code)
    H.Queued = ok
    if not ok then
        H.SetStatus("Macro", "Auto Execute queue failed: " .. tostring(err))
    end
end
function H.PathTarget()
    local map = WS:FindFirstChild("Game")
    if not map then
        return nil
    end
    local auto = H.Auto
    if auto.Map ~= map then
        for _, c in ipairs(auto.MapConnections or {}) do
            c:Disconnect()
        end
        auto.MapConnections = {}
        auto.Map = map
        auto.SurfaceParts, auto.SurfaceRoot, auto.NodeLayout, auto.PathNodes = nil,nil,nil,nil
        auto.GridSerial=(auto.GridSerial or 0)+1
        H.ClearAutoVisual()
        auto.GeometryAt = -math.huge
        auto.GeometryDirty = true
        auto.PlacePending = {}
        auto.UpgradePending = {}
        auto.Failures = {}
        auto.SlotCooldowns = {}
        auto.TowerCooldowns = {}
        local function changed(object)
            local node = object
            while node and node ~= map do
                if node.Name == "Waypoints" or node.Name == "TowerArea" then
                    auto.GeometryDirty = true
                    auto.SurfaceDirty = true
                    auto.GridSerial=(auto.GridSerial or 0)+1
                    return
                end
                node = node.Parent
            end
        end
        table.insert(auto.MapConnections, map.DescendantAdded:Connect(changed))
        table.insert(auto.MapConnections, map.DescendantRemoving:Connect(changed))
    end
    if os.clock() - (auto.GeometryAt or -math.huge) >= 5 or auto.GeometryDirty then
        auto.GeometryAt = os.clock()
        auto.GeometryDirty = false
        local root = map:FindFirstChild("Waypoints")
        local nodes = root and root:GetChildren() or {}
        table.sort(nodes, function(a, b)
            return (tonumber(a.Name:match("%d+")) or 0) < (tonumber(b.Name:match("%d+")) or 0)
        end)
        if nodes[1] and not nodes[1]:IsA("BasePart") then
            nodes = nodes[1]:GetChildren()
        end
        local points = {}
        for _, node in ipairs(nodes) do
            if node:IsA("BasePart") then
                table.insert(points, node)
            end
        end
        table.sort(points, function(a, b)
            return (tonumber(a.Name:match("%d+")) or 0) < (tonumber(b.Name:match("%d+")) or 0)
        end)
        auto.Points = points
        auto.Area = map:FindFirstChild("TowerArea")
    end
    local points = auto.Points or {}
    if #points == 0 then
        return nil
    end
    local total = 0
    for i = 2, #points do
        total = total + (points[i].Position - points[i - 1].Position).Magnitude
    end
    local distance = total * S.PlacementRange / 100
    for i = 2, #points do
        local a, b = points[i - 1].Position, points[i].Position
        local length = (b - a).Magnitude
        if distance <= length then
            local flat = Vector3.new(b.X - a.X, 0, b.Z - a.Z)
            local direction = flat.Magnitude > 0 and flat / flat.Magnitude or Vector3.new(1, 0, 0)
            return a:Lerp(b, length > 0 and distance / length or 0), direction
        end
        distance = distance - length
    end
    local a = points[math.max(1, #points - 1)].Position
    local b = points[#points].Position
    local flat = Vector3.new(b.X - a.X, 0, b.Z - a.Z)
    return b, flat.Magnitude > 0 and flat / flat.Magnitude or Vector3.new(1, 0, 0)
end
function H.SurfacePoint(part, point, clampToBounds)
        if not part.Parent or part.CFrame.UpVector.Y < 0.8 then return nil end
        local cf, half = part.CFrame, part.Size * 0.5
        local normal = cf.UpVector
        local top = cf:PointToWorldSpace(Vector3.new(0, half.Y, 0))
        local y = top.Y - (normal.X * (point.X - top.X) + normal.Z * (point.Z - top.Z)) / normal.Y
        local localPoint = cf:PointToObjectSpace(Vector3.new(point.X, y, point.Z))
        local inset = 1
        if half.X <= inset or half.Z <= inset then return nil end
        if not clampToBounds and (math.abs(localPoint.X) > half.X - inset or math.abs(localPoint.Z) > half.Z - inset) then return nil end
        return cf:PointToWorldSpace(Vector3.new(
            math.clamp(localPoint.X, -half.X + inset, half.X - inset), half.Y,
            math.clamp(localPoint.Z, -half.Z + inset, half.Z - inset)))
    end

function H.SearchTarget()
    local point,direction=H.PathTarget()
    if not point then return nil end
    local auto=H.Auto
    local area=auto.Map and auto.Map:FindFirstChild("TowerArea")
    if area~=auto.SurfaceRoot or auto.SurfaceDirty or not auto.SurfaceParts then
        auto.SurfaceRoot,auto.SurfaceDirty,auto.SurfaceParts=area,false,{}
        if area then
            if area:IsA("BasePart") then auto.SurfaceParts[#auto.SurfaceParts+1]=area end
            for _,part in ipairs(area:GetDescendants()) do
                if part:IsA("BasePart") then auto.SurfaceParts[#auto.SurfaceParts+1]=part end
            end
        end
    end
    local best,distance
    for _,part in ipairs(auto.SurfaceParts) do
        local projected=H.SurfacePoint(part,point,true)
        if projected then
            local d=(projected.X-point.X)^2+(projected.Z-point.Z)^2
            if not distance or d<distance then best,distance=projected,d end
        end
    end
    return best,direction,auto.Map
end
function H.ClearAutoVisual()
    if H.Ring then H.Ring:Destroy();H.Ring=nil end
    if H.Auto then H.Auto.VisualNodes=nil end
end
function H.PlacementNodes()
        local auto=H.Auto
        local center, direction, map = H.SearchTarget()
        if not center then return nil end
        local points={}
        for _,part in ipairs(auto.Points or {}) do points[#points+1]=part.Position end
        local generation=auto.GridSerial
        local previous = auto.NodeLayout
        local same = previous and previous.Map == map and previous.Center == center
            and previous.Direction == direction and #previous.Points == #points
            and #previous.Floors == #(auto.SurfaceParts or {})
        if same then
            for i, point in ipairs(points) do
                if previous.Points[i] ~= point then same = false; break end
            end
        end
        if same then
            for i, part in ipairs(auto.SurfaceParts or {}) do
                local floor = previous.Floors[i]
                if floor.Part ~= part or floor.CFrame ~= part.CFrame or floor.Size ~= part.Size then same = false; break end
            end
        end
        if same then return auto.PathNodes end
        auto.NodeBuildSerial = (auto.NodeBuildSerial or 0) + 1
        local serial, sliceAt, work = auto.NodeBuildSerial, os.clock(), 0
        local layout = { Map = map, Center = center, Direction = direction, Points = {}, Floors = {} }
        for i, point in ipairs(points) do layout.Points[i] = point end
        for i, part in ipairs(auto.SurfaceParts or {}) do
            layout.Floors[i] = { Part = part, CFrame = part.CFrame, Size = part.Size }
        end
        local function checkpoint()
            work = work + 1
            if work % 16 == 0 and os.clock() - sliceAt >= 0.001 then
                task.wait(); sliceAt = os.clock()
                if not H.Running or auto.Map ~= map or auto.NodeBuildSerial ~= serial
                    or not H.Active() or auto.GridSerial~=generation then return false end
            end
            return true
        end
        local nodes, side = {}, Vector3.new(-direction.Z, 0, direction.X)
        for x = -4, 4 do
            for z = -4, 4 do
                if x * x + z * z <= 16 then
                    local point, ground = center + direction * (x * 4.5) + side * (z * 4.5)
                    for _, floor in ipairs(layout.Floors) do
                        if not checkpoint() then return nil end
                        ground = H.SurfacePoint(floor.Part, point, false)
                        if ground then break end
                    end
                    if ground then
                        local distance = math.huge
                        for i = 2, #layout.Points do
                            if not checkpoint() then return nil end
                            local a, b = layout.Points[i - 1], layout.Points[i]
                            local dx, dz, px, pz = b.X - a.X, b.Z - a.Z, ground.X - a.X, ground.Z - a.Z
                            local length = dx * dx + dz * dz
                            local t = length > 0 and math.clamp((px * dx + pz * dz) / length, 0, 1) or 0
                            distance = math.min(distance, (px - dx * t)^2 + (pz - dz * t)^2)
                        end
                        if distance >= 3.5^2 then
                            nodes[#nodes + 1] = { Position = ground, PathDistance = distance, CenterDistance = x*x + z*z }
                        end
                    end
                end
            end
        end
        table.sort(nodes, function(a, b)
            if a.PathDistance ~= b.PathDistance then return a.PathDistance < b.PathDistance end
            return a.CenterDistance < b.CenterDistance
        end)
        auto.NodeLayout, auto.PathNodes, auto.NodeCursor = layout, nodes, 0
        return nodes
    end

function H.PlaceCandidate()
    local auto=H.Auto
    local nodes=H.PlacementNodes()
    if not nodes or #nodes==0 then return nil end
    local map,generation=auto.Map,auto.GridSerial
    local positions={}
    local work,sliceAt=0,os.clock()
    local function checkpoint()
        work=work+1
        if work%16==0 and os.clock()-sliceAt>=0.001 then task.wait();sliceAt=os.clock() end
        return H.Running and S.AutoPlace and not H.Playing and not H.Recording
            and H.Active() and auto.Map==map and auto.PathNodes==nodes and auto.GridSerial==generation
    end
    for _,tower in pairs(H.Towers) do
        local pos=H.Position(tower)
        if pos then positions[#positions+1]=pos end
        if not checkpoint() then return nil end
    end
    for _,pending in pairs(auto.PlacePending) do
        local cf=pending.Action.CFrame
        positions[#positions+1]=Vector3.new(cf[1],cf[2],cf[3])
    end
    -- Every request starts at the nearest free edge; occupied points expand outwards.
    for _,node in ipairs(nodes) do
        local clear=true
        for _,pos in ipairs(positions) do
            if not checkpoint() then return nil end
            if (pos.X-node.Position.X)^2+(pos.Z-node.Position.Z)^2<4.5^2 then clear=false;break end
        end
        if clear and checkpoint() then return CFrame.new(node.Position) end
    end
    return nil
end

-- Slop-style serial dispatcher: poll confirmations without blocking other towers.
H.Auto = {
    PlacePending = {},
    UpgradePending = {},
    SlotCooldowns = {},
    TowerCooldowns = {},
    Failures = {},
    NextAt = 0,
    PlaceTurn = true,
}
function H.Auto.Busy()
    return next(H.Auto.PlacePending) ~= nil or next(H.Auto.UpgradePending) ~= nil
end
function H.Auto.Budget()
    local reserved = 0
    for _, pending in pairs(H.Auto.PlacePending) do
        reserved = reserved + (pending.Cost or H.Cash())
    end
    for _, pending in pairs(H.Auto.UpgradePending) do
        reserved = reserved + (pending.Cost or H.Cash())
    end
    return math.max(0, H.Cash() - reserved)
end
function H.Auto.Poll()
    local auto = H.Auto
    local now = os.clock()
    for id, pending in pairs(auto.PlacePending) do
        local found, ambiguous = H.FindPlacement(pending.Action, pending.Before)
        if found and found.UnitId == id then
            auto.PlacePending[id] = nil
            auto.SlotCooldowns[id] = now + H.AutoInterval()
            H.SetStatus("Auto", "Placed " .. found.Name .. " | confirmed")
        elseif (ambiguous or now - pending.At >= 10) and not pending.Warned then
            pending.Warned = true
            H.SetStatus(
                "Auto",
                ambiguous
                    or (
                        "Placement unconfirmed: "
                        .. pending.Action.Name
                        .. " | this unit is locked pending late confirmation"
                    )
            )
        end
    end
    for id, pending in pairs(auto.UpgradePending) do
        local tower = H.Towers[id]
        if not tower or (tonumber(tower.Level) or 1) > pending.Level then
            auto.UpgradePending[id] = nil
            auto.TowerCooldowns[id] = now + H.AutoInterval()
            auto.Failures[id] = nil
            if tower then
                H.SetStatus("Auto", "Upgraded " .. tower.Name .. " | level " .. tower.Level)
            end
        elseif now - pending.At >= 10 then
            auto.UpgradePending[id] = nil
            auto.TowerCooldowns[id] = now + 15
            auto.Failures[id] = { Wave = H.Wave(), Cash = H.Cash(), Level = tower.Level }
            H.SetStatus(
                "Auto",
                "Upgrade unconfirmed: " .. tower.Name .. " | paused until wave/cash/level changes"
            )
        end
    end
end
function H.Auto.UpgradeStep()
    if not S.AutoUpgrade then
        return false
    end
    local auto = H.Auto
    local cash = auto.Budget()
    local ready = {}
    for _, tower in ipairs(H.Owned()) do
        local id = tower.Id
        local failure = auto.Failures[id]
        local price = H.UpgradeCost(tower)
        local changed = not failure
            or tower.Level ~= failure.Level
            or H.Wave() ~= failure.Wave
            or H.Cash() > failure.Cash + 100
        if
            changed
            and not auto.UpgradePending[id]
            and os.clock() >= (auto.TowerCooldowns[id] or 0)
            and ((price and price > 0 and price <= cash) or (not price and cash > 0 and not auto.Busy()))
        then
            table.insert(ready, { Tower = tower, Price = price })
        end
    end
    table.sort(ready, function(a, b)
        local ap, bp = a.Price or math.huge, b.Price or math.huge
        if ap == bp then
            return tostring(a.Tower.Id) < tostring(b.Tower.Id)
        end
        return ap < bp
    end)
    local entry = ready[1]
    if not entry then
        return false
    end
    local tower = entry.Tower
    local pending = { At = os.clock(), Level = tonumber(tower.Level) or 1, Cost = entry.Price }
    auto.UpgradePending[tower.Id] = pending -- subscribe/capture before dispatch
    local sent, reason = H.Fire("TowerUpgrade", { Id = tower.Id })
    if not sent then
        auto.UpgradePending[tower.Id] = nil
        auto.TowerCooldowns[tower.Id] = os.clock() + 2
        H.SetStatus("Auto", tostring(reason))
    else
        H.SetStatus("Auto", "Upgrading " .. tower.Name .. " | waiting for level confirmation")
    end
    return true
end
function H.Auto.PlaceStep()
    if not S.AutoPlace then
        return false
    end
    local auto = H.Auto
    local units = H.Equipped()
    local cash = auto.Budget()
    if #units == 0 then
        H.SetStatus("Auto", "Waiting for equipped loadout from local replica")
        return false
    end
    local label = H.GUI("Stats/OtherUI/Towers")
    if label then
        local count, max = label.Text:match("(%d+)%s*/%s*(%d+)")
        local pending = 0
        for _ in pairs(auto.PlacePending) do
            pending = pending + 1
        end
        if count and tonumber(count) + pending >= tonumber(max) then
            H.SetStatus("Auto", "Tower limit reached / reserved")
            return false
        end
    end
    local chosen, cost
    local missing, pendingCount, cheapest = 0, 0, math.huge
    for _ = 1, #units do
        auto.SlotIndex = (auto.SlotIndex or 0) % #units + 1
        local unit = units[auto.SlotIndex]
        local price = H.UnitCost(unit.Name, unit)
        if not price or price <= 0 then
            missing = missing + 1
        end
        if auto.PlacePending[unit.Id] then
            pendingCount = pendingCount + 1
        end
        if price and price > 0 then
            cheapest = math.min(cheapest, price)
        end
        if
            not auto.PlacePending[unit.Id]
            and os.clock() >= (auto.SlotCooldowns[unit.Id] or 0)
            and price
            and price > 0
            and price <= cash
        then
            chosen, cost = unit, price
            break
        end
    end
    if not chosen then
        local reason
        if pendingCount == #units then
            reason = "Waiting for TowerAdd confirmation | " .. pendingCount .. " slot(s) pending"
        elseif missing == #units then
            reason = "Cannot read equipped slot prices | cash " .. H.Cash()
        elseif cheapest > cash then
            reason = "Waiting for money | available " .. cash .. " / cheapest " .. cheapest
        else
            reason = "Waiting for slot cooldown / pending confirmation | available " .. cash
        end
        H.SetStatus("Auto", reason)
        return false
    end
    local cf = H.PlaceCandidate()
    if not cf then
        H.SetStatus("Auto", "Searching for clear ground beside the path")
        return false
    end
    -- Grid generation may yield. Recheck user intent and reserved cash before dispatch.
    if not H.Running or not S.AutoPlace or H.Playing or H.Recording or not H.Active()
        or (S.AutoPlayback and not H.PlaybackCompleted) or cost>auto.Budget() then return false end
    local stillEquipped=false
    for _,unit in ipairs(H.Equipped()) do
        if unit.Id==chosen.Id and unit.Name==chosen.Name then stillEquipped=true;break end
    end
    if not stillEquipped then return false end
    local before = {}
    for _, t in ipairs(H.Owned()) do
        before[t.Id] = true
    end
    H.Candidate = 0 -- Start again at the nearest free edge for the next tower.
    local action = { Name = chosen.Name, UnitId = chosen.Id, CFrame = { cf:GetComponents() } }
    auto.PlacePending[chosen.Id] = { At = os.clock(), Before = before, Action = action, Cost = cost }
    local sent, reason =
        H.Fire("TowerAdd", { Name = chosen.Name, UnitId = chosen.Id, Pos = cf.Position, CFrame = cf })
    if not sent then
        auto.PlacePending[chosen.Id] = nil
        auto.SlotCooldowns[chosen.Id] = os.clock() + 2
        H.SetStatus("Auto", tostring(reason))
    else
        H.SetStatus("Auto", "Placing " .. chosen.Name .. " | waiting for tower confirmation")
    end
    return true
end
function H.AutoStep()
    local auto = H.Auto
    auto.Poll()
    if not S.AutoPlace and not S.AutoUpgrade then
        H.SetStatus("Auto", auto.Busy() and "Disabled | resolving outstanding requests" or "Disabled")
        return
    end
    if H.Playing or H.Recording then
        H.SetStatus("Auto", "Paused: macro recording / playback")
        return
    end
    if S.AutoPlayback and not H.PlaybackCompleted then
        H.SetStatus("Auto", H.PlaybackFailure and "Paused: macro playback failed" or "Waiting for macro completion")
        return
    end
    if not H.Active() then
        H.SetStatus("Auto", "Waiting for a match")
        return
    end
    H.PathTarget()
    if S.AutoPlace and #H.Equipped() == 0 and os.clock() >= (auto.HydrateAt or 0) then
        auto.HydrateAttempts = (auto.HydrateAttempts or 0) + 1
        auto.HydrateAt = os.clock() + (auto.HydrateAttempts <= 3 and 10 or 30)
        H.Hydrate()
    end
    if os.clock() < auto.NextAt then
        return
    end
    local dispatched = false
    if auto.PlaceTurn then
        dispatched = auto.PlaceStep()
        if not dispatched then
            dispatched = auto.UpgradeStep()
        end
    else
        dispatched = auto.UpgradeStep()
        if not dispatched then
            dispatched = auto.PlaceStep()
        end
    end
    if dispatched then
        auto.PlaceTurn = not auto.PlaceTurn
    end
    auto.NextAt = os.clock() + H.AutoInterval()
end
-- Auto Skip owns its own scheduler; recording/playback cannot enable or disable it.
H.Skip = { NextAt = 0, LastWave = nil }
function H.IsAutoSkipStopped(wave)
    local text = S.StopAutoSkipAt
    if H.Skip.StopText ~= text then
        H.Skip.StopText, H.Skip.StopWaves = text, {}
        for token in tostring(text):gmatch("[^,%s;]+") do
            if token:match("^%d+$") then
                local value = tonumber(token)
                if value and value >= 1 then H.Skip.StopWaves[value] = true end
            end
        end
    end
    return H.Skip.StopWaves[wave] == true
end
function H.SkipStep()
    if not S.AutoSkip then
        return
    end
    if not H.Active() then
        return
    end
    local panel = H.GUI("Stats/WaveSkipGui")
    local label = H.GUI("Stats/WaveSkipGui/Title")
    if not H.Visible(panel) then
        return
    end
    local text = label and label.Text or ""
    local votes, total = text:match("(%d+)%s*/%s*(%d+)")
    if votes and tonumber(total) > 0 and tonumber(votes) >= tonumber(total) then
        return
