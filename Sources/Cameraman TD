function R.ReadPrompt()
    local root = Core:FindFirstChild("RobloxPromptGui")
    local overlay = root and root:FindFirstChild("promptOverlay")
    local prompt = overlay and overlay:FindFirstChild("ErrorPrompt")
    prompt = prompt or (root and root:FindFirstChild("ErrorPrompt", true))
    -- UI versions may rename the prompt frame; keep fallback scanning confined
    -- to RobloxPromptGui rather than scanning the full CoreGui tree.
    prompt = prompt or overlay or root
    if not prompt or not visible(prompt) then return nil end
    local texts = {}
    for _, object in ipairs(prompt:GetDescendants()) do
        if object:IsA("TextLabel") and visible(object) and object.Text ~= "" then
            table.insert(texts, object.Text)
        end
    end
    return #texts > 0 and table.concat(texts, " | ") or nil
end
function R.ConnectionError(text)
    if type(text) ~= "string" then return false end
    local lower = text:lower()
    -- Only text read from Roblox's error prompt reaches this classifier.
    -- Accept all displayed error codes, including codes not yet encountered.
    if lower:match("error%s*code%s*:%s*%d+") then return true end
    return lower:find("disconnect", 1, true) ~= nil
        or lower:find("reconnect", 1, true) ~= nil
        or lower:find("lost connection", 1, true) ~= nil
        or lower:find("connection lost", 1, true) ~= nil
        or lower:find("internet connection", 1, true) ~= nil
        or lower:find("connection timed out", 1, true) ~= nil
end
function R.Reset()
    R.Prompt, R.Attempts, R.NextAt, R.InFlight = nil, 0, nil, nil
end
function R.Step(text)
    if not R.Active or not R.Armed then return end
    local now = os.clock()
    if R.InFlight then
        if now - R.InFlight < 45 then return end
        R.InFlight = nil
        R.Log("teleport_unconfirmed", { attempt = R.Attempts })
    end
    if not text then
        if R.Prompt then R.Reset();R.Log("prompt_closed", {}) end
        R.Status("Monitoring connection")
        return
    end
    if not R.ConnectionError(text) then
        if R.Prompt then R.Reset() end
        R.Status("Prompt detected; no reconnect required")
        return
    end
    if not R.Prompt then
        R.Prompt = text
        R.Attempts = 0
        R.NextAt = now + delays[1]
        R.Log("disconnect_detected", { prompt = text })
    end
    if R.Attempts >= #delays then
        R.Status("Retry limit reached. See test log.")
        return
    end
    if now < R.NextAt then
        R.Status("Lobby retry " .. (R.Attempts + 1) .. "/3 in " .. math.ceil(R.NextAt - now) .. "s")
        return
    end
    R.Attempts = R.Attempts + 1
    R.NextAt = now + (delays[R.Attempts + 1] or 30)
    R.Log("rejoin_attempt", { attempt = R.Attempts, placeId = LobbyId })
    local hub = E.CameraTDHub
    if hub and hub.Running and hub.QueueTeleport then pcall(hub.QueueTeleport) end
    local ok, reason = pcall(function() TP:Teleport(LobbyId, P) end)
    if not ok then
        R.Log("teleport_call_error", { attempt = R.Attempts, error = tostring(reason) })
        R.Status("Teleport call failed; waiting for next retry")
    else
        -- Returning from Teleport is not proof that the destination was reached.
        R.Status("Lobby request sent; awaiting teleport")
    end
end
function R.Stop()
    if not R.Active then return end
    R.Active, R.Armed = false, false
    for _, connection in ipairs(R.Connections) do connection:Disconnect() end
    R.Log("stopped", { attempts = R.Attempts })
end
R.Connect(TP.TeleportInitFailed, function(player, result, message, placeId)
    if player ~= P or placeId ~= LobbyId or R.Attempts == 0 then return end
    R.InFlight = nil
    R.Log("teleport_init_failed", { result = tostring(result), message = tostring(message), attempt = R.Attempts })
end)
