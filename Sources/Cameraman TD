    if not H.InventoryData then return true end
    local equipped, missing, seen = {}, {}, {}
    for _,unit in ipairs(H.Equipped()) do equipped[unit.Name] = true end
    for _,action in ipairs(profile.Actions) do
        if action.Kind == "Place" and not equipped[action.Name] and not seen[action.Name] then
            seen[action.Name] = true
            missing[#missing+1] = action.Name
        end
    end
    if #missing > 0 then
        table.sort(missing)
        return false, "Equip required towers before playback: " .. table.concat(missing, ", ")
    end
    return true
end
function H.WaitForUnit(action, serial, recordedOwner)
    local unit, reason = H.ResolveUnit(action, recordedOwner)
    if unit then return unit end
    local nextRead = 0
    local ready, why = H.WaitUntil(function()
        if os.clock() >= nextRead then
            nextRead = os.clock()+2
            H.Hydrate(true)
        end
        unit, reason = H.ResolveUnit(action, recordedOwner)
        return unit ~= nil
    end, 15, serial)
    if ready and H.Running and H.Playing and H.Serial==serial and H.Active() then return unit end
    if ready then return nil, "Cancelled / match ended" end
    if why == "Cancelled / match ended" then return nil, why end
    return nil, reason or (H.InventoryData
        and ("Recorded unit is not equipped: " .. tostring(action.Name))
        or ("Cannot read local equipped loadout on this executor (GC " .. tostring(H.LoadoutGC)
            .. "); no placement sent. Re-equip a unit to refresh the local replica."))
end
