end
function H.TakeStamp(name, tower)
    local list = H.Pending[name] or {}
    for i = #list, 1, -1 do
        if os.clock() - list[i].At > 15 then
            table.remove(list, i)
        end
    end
    if name == "TowerAdd" then
        local towerPos = H.Position(tower)
        local bestIndex, bestDistance = nil, 1
        for i = #list, 1, -1 do
            local payload = list[i].Payload
            if payload.UnitId == tower.UnitId and typeof(payload.Pos) == "Vector3" and towerPos then
                local distance = (payload.Pos - towerPos).Magnitude
                if distance < bestDistance - 1e-4 then
                    bestIndex, bestDistance = i, distance
                    if distance < 1e-3 then break end
                end
            end
        end
        if bestIndex then
            local stamp = list[bestIndex]
            for i = bestIndex, 1, -1 do
                if list[i].Payload.UnitId == tower.UnitId then
                    table.remove(list, i)
                end
            end
            return stamp
        end
        return
    end
    for i, stamp in ipairs(list) do
        local payload = stamp.Payload
        if payload.Id == tower.Id then
            table.remove(list, i)
            return stamp
        end
    end
end
-- One reusable hook, gated by recording and five exact remote Instances.
-- No JSON serialization, world scans, waits, or blind remote retries inside the hook.
function H.InstallRecorderHook()
    local router = E.__CameraTDRecorderRouter
    if router and router.Version ~= 5 then
        router.Hub = nil
        router = nil
        E.__CameraTDRecorderRouter = nil
    end
    if not router then
        router = { Version = 5 }
        E.__CameraTDRecorderRouter = router
        if type(hookmetamethod) ~= "function" or type(getnamecallmethod) ~= "function" then
            E.__CameraTDRecorderRouter = nil
            return false
        end
        local old
        local callback = function(self, ...)
            local hub = router.Hub
            -- This hook sees every game namecall. Reject unrelated Instances before
            -- querying the method; especially important for obfuscated builds.
            local name = hub and hub.Recording and hub.Running and hub.RecordRemotes[self]
            if name and getnamecallmethod() == "FireServer" then
                if name == "WaveSkip" then
                    if not (hub.SkipAutomationThreads and hub.SkipAutomationThreads[coroutine.running()]) then
                        local record = hub.Recording
                        local stamp = {
                            Record = record,
                            Wave = hub.RecordWave or hub.LastWave or 0,
                            Time = hub.RecordTime(record),
                            WaveTime = hub.WaveStartedGame and math.max(0, hub.GameClock() - hub.WaveStartedGame),
                        }
                        -- Forward first; capture only cached Lua data before the call.
                        local result = table.pack(old(self, ...))
                        pcall(hub.RecordManualSkip, stamp)
                        return table.unpack(result, 1, result.n)
                    end
                elseif name and not (name == "TowerSell"
                    and hub.FarmSellThreads and hub.FarmSellThreads[coroutine.running()]) then
                    pcall(hub.Stamp, name, ...)
                end
            end
            return old(self, ...)
        end
        if type(newcclosure) == "function" then
            callback = newcclosure(callback)
        end
        local ok, result = pcall(hookmetamethod, game, "__namecall", callback)
        if not ok then
            E.__CameraTDRecorderRouter = nil
            return false
        end
        old = result
        router.Installed = true
    end
    router.Hub = H
    H.RecordRemotes = {}
    for _, name in ipairs({ "TowerAdd", "TowerUpgrade", "TowerTarget", "TowerSell", "WaveSkip" }) do
        local remote = H.Remote(name)
        if remote then
            H.RecordRemotes[remote] = name
        end
    end
    return router.Installed == true
end
function H.StartRecord()
