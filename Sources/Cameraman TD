function H.SoloGuard()
    if not S.AutoLobby or S.Players ~= 1 then
        H.SoloReturning = nil
        return
    end
    if game.PlaceId ~= H.MatchId or not S.AutoLobby or S.Players ~= 1 or not Players.GetPlayers then
        return
    end
    local roster = Players:GetPlayers()
    if #roster <= 1 and not H.SoloReturning then
