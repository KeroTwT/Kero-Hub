            Game = "CameraTD",
            Version = 1,
            Map = H.CurrentMap(),
            LobbyMap = S.Map,
            Difficulty = S.Difficulty,
            Created = os.time(),
            TimeBasis = "GameSeconds",
            RecordedSpeed = H.Speed.Value,
            Actions = {},
        },
    }
    H.RecordWave = H.Wave()
    local record = H.Recording
