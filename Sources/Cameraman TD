function H.WebhookStep(final, active)
    local runtime = H.ReportRuntime
    if not final and active and H.Wave() > 0 and not H.ReportStartedAt then
        H.ReportStartedAt = os.clock()
    end
    if not final then
        -- Only a confirmed new round resets timing; a result UI flicker does not.
        return true
    end
    if not runtime.Final then
        runtime.Final = true
        runtime.At = os.clock()
        H.ReportEndedAt = os.clock()
    end
    if not S.WebhookEnabled or not S.WebhookMatchEnd then
        return true
    end
    local key = tostring(game.JobId)
        .. "/"
        .. P.UserId
        .. "/"
        .. tostring(H.CurrentMap())
        .. "/"
        .. tostring(H.RoundId or (E.__CameraTDRoundCounters or {})[tostring(game.PlaceId) .. "/" .. tostring(game.JobId)] or 0)
        .. "/"
        .. S.WebhookURL
    E.__CameraTDMatchReports = E.__CameraTDMatchReports or {}
    if E.__CameraTDMatchReports[key] and not runtime.Pending then
        return true
    end
    if not runtime.Requested then
        -- Let the result GUI populate before reading coins/time and returning.
        if os.clock() - runtime.At < 0.75 then
            return false
        end
        local rewards = H.ResultRewards()
        local signature = table.concat({ tostring(rewards.Coins), tostring(rewards.Candy),
            tostring(rewards.Exp), tostring(rewards.Crates) }, "/")
        if signature ~= runtime.RewardSignature then
            runtime.RewardSignature, runtime.RewardChangedAt = signature, os.clock()
        end
        if os.clock() - runtime.At < 3 then
            if rewards.Coins == nil or os.clock() - runtime.RewardChangedAt < 0.35 then return false end
        end
        local report = H.MatchReport()
        runtime.Requested = true
        runtime.Pending = true
        runtime.SendAt = os.clock()
        E.__CameraTDMatchReports[key] = true -- Do not duplicate an uncertain delivery.
        task.spawn(function()
            local ok, reason = H.SendWebhook(
                report.Title,
                report.Description,
                report.Color,
                report.Fields,
                "https://i.postimg.cc/1RYRdwrS/Bo-suu-tap.jpg"
            )
            runtime.Pending = false
            runtime.Sent = ok
            H.WebhookStatus(ok, reason)
        end)
    end
    return not runtime.Pending or os.clock() - runtime.SendAt >= 8
end

