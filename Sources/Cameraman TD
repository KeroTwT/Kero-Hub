end
function H.SortMacroActions(profile)
    if type(profile) ~= "table" or type(profile.Actions) ~= "table" then return profile end
    local ordered = {}
    for index, action in ipairs(profile.Actions) do
        ordered[index] = { Action = action, Index = index, Time = tonumber(action.Time) or math.huge }
    end
    table.sort(ordered, function(a, b)
        if a.Time == b.Time then return a.Index < b.Index end
        return a.Time < b.Time
    end)
    for index, entry in ipairs(ordered) do profile.Actions[index] = entry.Action end
    profile.ActionCount = #profile.Actions
    return profile
end
