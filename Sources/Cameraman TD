function H.CloseClick()
    local c = H.Close
    if not H.Running or not c.Enabled or game.PlaceId ~= H.MatchId
        or H.SoloReturning or H.Final() or os.clock() - c.LastClickAt < .5 then return end
    H.CloseRefresh()
    local model = c.Preview
    if not model or not model:IsA("Model") then return end
    c.LastClickAt = os.clock();c.ClickSerial = c.ClickSerial + 1
    local click, serial = c.ClickSerial, c.SendSerial
    local cf, name = model:GetPivot(), model.Name
    -- The game's own input connection may run just before ours.
    local prior = c.LastSend
    if prior and os.clock() - prior.At < .1 and prior.Name == name
        and typeof(prior.Pos) == "Vector3" and (prior.Pos - cf.Position).Magnitude < .1 then return end
    task.delay(.15, function()
        if not H.Running or not c.Enabled or game.PlaceId ~= H.MatchId
            or H.SoloReturning or H.Final() or c.ClickSerial ~= click or c.SendSerial ~= serial then return end
        H.CloseRefresh()
        if c.Preview ~= model then return end
        local unit
        for _, equipped in ipairs(H.Equipped()) do
            if equipped.Name == name then unit = equipped;break end
        end
        if not unit then H.Notify("Cannot resolve equipped unit: " .. name);return end
        -- One fallback, unchanged live preview position/rotation; no retries.
        H.Fire("TowerAdd", { Name = name, UnitId = unit.Id, Pos = cf.Position, CFrame = cf })
    end)
end
function H.SetClosePlacement(enabled)
    local c = H.Close
    c.Enabled = false;c.ClickSerial = c.ClickSerial + 1
    if not enabled or game.PlaceId ~= H.MatchId then return end
    if type(hookmetamethod) ~= "function" or type(getnamecallmethod) ~= "function"
        or type(getcallingscript) ~= "function" then
        H.Notify("Close + Path requires executor hook and caller support");return
    end
    if E.CameraTDCloseTest and E.CameraTDCloseTest.Stop then pcall(E.CameraTDCloseTest.Stop) end
    H.Hydrate();H.CloseRefresh()
    c.Add, c.UI = H.Remote("TowerAdd"), H.Path(RS, "ModuleLoader/Client/UI")
    if not c.Add or not c.UI then H.Notify("Close + Path: game placement UI unavailable");return end
    -- Recorder captures fallback calls too, so manual placements remain recordable.
    H.InstallRecorderHook()
    local router = E.__CameraTDHubPlacementRouter
    if router and router.Version ~= 2 then
        router.Hub = nil
        router = nil
    end
    if not router then
        router = { Version = 2 };E.__CameraTDHubPlacementRouter = router
        local old
        local callback = function(self, ...)
            local hub = router.Hub
            if not hub or not hub.Running or not hub.Close.Enabled then return old(self, ...) end
            local state = hub.Close
            if self ~= state.Add and self ~= WS then return old(self, ...) end
            local filtering
            do
                local method = getnamecallmethod()
                if self == state.Add and method == "FireServer" then
                    state.SendSerial = state.SendSerial + 1
                    local payload = ...
                    if type(payload) == "table" then
                        state.LastSend = { At = os.clock(), Name = payload.Name, Pos = payload.Pos }
                    end
                elseif self == WS and method == "GetPartsInPart" and state.Hitboxes[(...)] then
                    filtering = getcallingscript() == state.UI
                        and not (type(checkcaller) == "function" and checkcaller())
                end
            end
            if not filtering then return old(self, ...) end
            local result = table.pack(old(self, ...))
            if filtering and type(result[1]) == "table" then result[1] = hub.CloseFilter(result[1]) end
            return table.unpack(result, 1, result.n)
        end
        local ok, previous = pcall(hookmetamethod, game, "__namecall",
            type(newcclosure) == "function" and newcclosure(callback) or callback)
        if not ok then E.__CameraTDHubPlacementRouter = nil;H.Notify("Close + Path hook unavailable");return end
        old = previous
    end
    router.Hub = H
    if not c.InputBound then
        c.InputBound = true
        H.Connect(game:GetService("UserInputService").InputBegan, function(input, processed)
            if not processed and input.UserInputType == Enum.UserInputType.MouseButton1 then H.CloseClick() end
        end)
    end
    c.Enabled = true
end

