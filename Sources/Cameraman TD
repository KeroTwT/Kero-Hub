function H.HideOwnNameObject(object)
    if not H.Running or not S.HideName then return end
    if object:IsA("Humanoid") then
        if not H.HiddenNameOriginal[object] then
            H.HiddenNameOriginal[object] = { DisplayName = object.DisplayName,
                NameDisplayDistance = object.NameDisplayDistance }
        end
        object.NameDisplayDistance = 0
        object.DisplayName = ""
    elseif (object:IsA("TextLabel") or object:IsA("TextButton"))
        and object:FindFirstAncestorWhichIsA("BillboardGui") then
        local text = object.Text
        if text:find(P.Name, 1, true) or (P.DisplayName ~= "" and text:find(P.DisplayName, 1, true)) then
            if not H.HiddenNameOriginal[object] then
                H.HiddenNameOriginal[object] = { Visible = object.Visible, TextTransparency = object.TextTransparency,
                    TextStrokeTransparency = object.TextStrokeTransparency }
            end
            object.Visible = false
            object.TextTransparency, object.TextStrokeTransparency = 1, 1
        end
    end
