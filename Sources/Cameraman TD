function H.CloseFilter(parts)
    local c, kept = H.Close, {}
    for _, part in ipairs(parts) do
        if not (typeof(part) == "Instance" and
            ((c.TowerRoot and part:IsDescendantOf(c.TowerRoot)) or
             (c.PathRoot and part:IsDescendantOf(c.PathRoot)))) then
            table.insert(kept, part)
        end
