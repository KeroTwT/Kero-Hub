        H.Notify("Stop the active macro first")
        return
    end
    if not H.Active() then
        H.Notify("Start recording in match intermission / wave 0 or later")
        return
    end
    if S.Profile == "" then
        H.Notify("Create / select a macro first")
        return
    end
    if not H.FS then
        H.Notify("Recording needs executor filesystem support")
        return
    end
