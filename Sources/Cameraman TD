function H.IsOwnNameText(text)
    local name = tostring(text or ""):match("^%s*(.-)%s*$")
    return name == P.Name or (type(P.DisplayName) == "string" and P.DisplayName ~= "" and name == P.DisplayName)
        or name == "@" .. P.Name
