H.Close = { Enabled = false, Hitboxes = {}, SendSerial = 0, ClickSerial = 0, LastClickAt = -10 }
function H.CloseRefresh()
    local c = H.Close
    c.TowerRoot, c.PathRoot = H.Path(WS, "Game/Towers"), H.Path(WS, "Game/Paths")
    local folder = H.Path(WS, "Game/PlacingTowers")
