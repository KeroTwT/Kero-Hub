function H.CrateRequest(kind, item, amount)
    if kind == "Open" then return H.Invoke("OpenCrate", item, amount) end
    if kind ~= "Buy" then return false, "Unknown crate action" end
    -- BuyCrate is a two-argument RemoteEvent; H.Fire only accepts one payload.
    local remote = H.Remote("BuyCrate", "RemoteEvent")
    if not remote or not remote:IsA("RemoteEvent") then return false, "Missing BuyCrate RemoteEvent" end
    return pcall(remote.FireServer, remote, item, amount)
end
function H.CrateStep()
    if not H.RewardLobby() then return end
    local pending = H.CratePending
    if pending then
        local state = H.CrateInventory(pending.Name)
        if not state then H.SetStatus("Crates", "Waiting for your crate inventory"); return end
        local confirmed = pending.Kind == "Buy" and state.Count >= pending.Count + pending.Amount
            and state.Candy ~= nil and state.Candy <= pending.Candy - pending.Price
            or pending.Kind == "Open" and state.Count <= pending.Count - pending.Amount
        if confirmed then
            H.CratePending = nil
            H.Next.Crate = os.clock() + S.CrateDelay
            H.SetStatus("Crates", pending.Kind .. " confirmed: " .. pending.Amount .. " " .. pending.Name)
        elseif os.clock() - pending.At >= 15 and not pending.Warned then
            pending.Warned = true
            H.SetStatus("Crates", "Waiting for inventory confirmation; no request will be repeated")
        end
        return
    end
    if not (S.AutoBuyCrate or S.AutoOpenCrate) or os.clock() < (H.Next.Crate or 0) then return end
    -- Opening takes priority so buying cannot starve the selected inventory queue.
    local kind, name, amount, state, buyPrice, waiting
    if S.AutoOpenCrate then
        name = S.OpenCrateName
        state = H.CrateInventory(name)
        if state and state.Count > 0 and state.Space and state.Towers < state.Space then
            amount = S.OpenCrateAmount == 10 and state.Count >= 10 and state.Space - state.Towers >= 10 and 10 or 1
            kind = "Open"
        elseif not state then waiting = "Waiting for your crate inventory"
        elseif state.Count == 0 then waiting = "No owned " .. tostring(name)
        elseif not state.Space then waiting = "Waiting for inventory capacity; open Units once"
        else waiting = "Tower inventory full: " .. state.Towers .. "/" .. state.Space
        end
    end
    if not kind and S.AutoBuyCrate then
        name, amount = "Exclusive Halloween Crate", S.BuyCrateAmount
        state = H.CrateInventory(name)
        local price = H.CratePrice(amount)
        if state and price and state.Candy and state.Candy >= price then kind, buyPrice = "Buy", price
        elseif not state then waiting = "Waiting for your crate inventory"
        elseif not price then waiting = "Waiting for Halloween shop price; open Event Shop once"
        elseif not state.Candy then waiting = "Waiting for your Candy balance"
        else waiting = "Need " .. price .. " Candy | Available: " .. state.Candy end
    end
    if not kind then H.SetStatus("Crates", waiting or "Waiting for an available crate"); return end
    pending = {Kind = kind, Name = name, Amount = amount, Count = state.Count,
        Candy = state.Candy, Price = buyPrice, At = os.clock()}
    H.CratePending = pending -- reserve before sending; FireServer's nil return is not a failure
    H.Next.Crate = os.clock() + math.max(2, S.CrateDelay)
    local ok, result = H.CrateRequest(kind, kind == "Buy" and name or state.Ids[1], amount)
    H.Next.Crate = os.clock() + math.max(2, S.CrateDelay)
    pending.Warned = not ok or result == false
    H.SetStatus("Crates", pending.Warned
        and (kind .. " request unconfirmed: " .. tostring(result):sub(1, 180) .. " | Waiting for inventory")
        or (kind .. " sent; waiting for inventory confirmation"))
end
