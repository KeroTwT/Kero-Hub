    local cache = H.Folder .. "/WindUI.lua"
    local url = "https://raw.githubusercontent.com/Footagesus/WindUI/main/dist/main.lua"
    local function save(source)
        if type(writefile) == "function" then
            pcall(writefile, cache, "-- CameraWindUICache " .. os.time() .. "\n" .. source)
        end
    end
    local function execute(source)
        if type(source) ~= "string" or source == "" then return end
        local chunk = loadstring(source)
        if not chunk then return end
        local ok, library = pcall(chunk)
        if ok and type(library) == "table" and type(library.CreateWindow) == "function" then return library end
    end
    if type(readfile) == "function" then
        local ok, source = pcall(readfile, cache)
        if ok then
            local library = execute(source)
            if library then
                H.LoadTimes.WindUI = "Cache"
                local savedAt = tonumber(source:match("^%-%- CameraWindUICache (%d+)")) or 0
                if os.time() - savedAt >= 86400 then
                    task.delay(15, function()
                        if not H.Running then return end
                        local fetched, fresh = pcall(game.HttpGet, game, url)
                        if fetched and type(fresh) == "string" and loadstring(fresh) and H.Running then save(fresh) end
                    end)
                end
                return library
            end
        end
    end
    local source = game:HttpGet(url)
    local library = execute(source)
    if not library then error("WindUI source could not initialize", 0) end
    save(source)
    H.LoadTimes.WindUI = "Network"
    return library
