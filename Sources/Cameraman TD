            root = root[path[i]]
        end
        if #path > 0 then
            root[path[#path]] = value
            -- Money/playtime and other scalar updates are already visible via
            -- InventoryData. Only tower mutations require rebuilding unit/UI data.
            if path[1] == "Towers" then H.Inventory(H.InventoryData) end
        end
    end)
end
function H.StopPlayback(reason)
