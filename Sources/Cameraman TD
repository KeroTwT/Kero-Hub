function H.ValidProfile(profile)
    if
        type(profile) ~= "table"
        or profile.Game ~= "CameraTD"
        or profile.Version ~= 1
        or type(profile.Actions) ~= "table"
    then
        return false
    end
    if profile.ActionCount ~= #profile.Actions then
        return false
    end
    local placed = {}
    for _, a in ipairs(profile.Actions) do
        if
            type(a) ~= "table"
            or not table.find({ "Place", "Upgrade", "Target", "Sell", "Skip" }, a.Kind)
            or (a.Kind ~= "Skip" and type(a.Key) ~= "string")
            or type(a.Time) ~= "number"
            or a.Time < 0
            or type(a.Wave) ~= "number"
            or a.Wave < 0
        then
            return false
        end
        if a.Kind == "Place" then
            if
                placed[a.Key]
                or type(a.Name) ~= "string"
                or type(a.UnitId) ~= "string"
                or type(a.CFrame) ~= "table"
                or #a.CFrame ~= 12
            then
                return false
            end
            for _, v in ipairs(a.CFrame) do
                if type(v) ~= "number" or v ~= v or math.abs(v) == math.huge then
                    return false
                end
            end
            if a.Pos~=nil then
                if type(a.Pos)~="table"or #a.Pos~=3 then return false end
                for i=1,3 do local v=a.Pos[i];if type(v)~="number"or v~=v or math.abs(v)==math.huge then return false end end
            end
            placed[a.Key] = true
        elseif a.Kind == "Skip" then
            if a.WaveTime~=nil and (type(a.WaveTime)~="number" or a.WaveTime~=a.WaveTime or a.WaveTime<0 or a.WaveTime==math.huge) then return false end
            if a.Wave < 1 then
                return false
            end
        elseif not placed[a.Key] then
            return false
        end
        if a.Kind == "Upgrade" and (type(a.Level) ~= "number" or a.Level < 2) then
            return false
        end
        if a.Kind == "Target" and type(a.Target) ~= "string" then
            return false
        end
    end
    return true
end
function H.LearnProfileCosts(profile)
    local names = {}
    for _, action in ipairs(profile.Actions) do
        if action.Kind == "Place" then
            names[action.Key] = action.Name
        end
        local name = names[action.Key]
        local level = action.Kind == "Place" and 1 or action.Kind == "Upgrade" and action.Level
        if name and level and (tonumber(action.Cost) or 0) > 0 then
            H.KnownCosts[name] = H.KnownCosts[name] or {}
            H.KnownCosts[name][level] = action.Cost
        end
    end
end
function H.RecordAction(kind, tower, stamp)
