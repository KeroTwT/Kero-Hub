    if name == "TowerUpgrade" then
        local costs = tower and H.KnownCosts[tower.Name]
        stamp.Cost = costs and costs[(tonumber(tower.Level) or 1) + 1] or 0
    end
    if name == "TowerAdd" then
        local costs = H.KnownCosts[payload.Name]
        stamp.Cost = costs and costs[1] or 0
    end
