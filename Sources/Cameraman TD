function H.WatchOwnNameLabel(object)
    if not (object:IsA("TextLabel") or object:IsA("TextButton")) or H.NameWatched[object] then return end
    local key = object.Name:lower()
    -- Watch the shared tower-owner field even before a tower is selected.
    if key ~= "ownername" and not key:find("playername", 1, true)
        and not key:find("displayname", 1, true) and not H.IsOwnNameText(object.Text) then return end
    H.NameWatched[object] = true
    local function update()
        if not H.Running or not S.HideName then return end
        local saved = H.HiddenNameOriginal[object]
        if H.IsOwnNameText(object.Text) then
            if not saved then
                saved = { Visible = object.Visible, TextTransparency = object.TextTransparency, TextStrokeTransparency = object.TextStrokeTransparency }
                H.HiddenNameOriginal[object] = saved
            end
            object.Visible = false
            object.TextTransparency, object.TextStrokeTransparency = 1, 1
        elseif saved then
            -- Selecting another player's tower restores that player's visible name.
            object.Visible = saved.Visible
            object.TextTransparency, object.TextStrokeTransparency = saved.TextTransparency, saved.TextStrokeTransparency
            H.HiddenNameOriginal[object] = nil
        end
    end
    table.insert(H.NameConnections, object:GetPropertyChangedSignal("Text"):Connect(update))
    update()
end
function H.BindHiddenNameCharacter(character)
