function H.FPSObject(object)
    if
        object:IsA("ParticleEmitter")
        or object:IsA("Trail")
        or object:IsA("Beam")
        or object:IsA("Smoke")
        or object:IsA("Fire")
        or object:IsA("Sparkles")
        or object:IsA("PostEffect")
    then
        H.FPSSet(object, "Enabled", false)
    elseif object:IsA("BasePart") then
        H.FPSSet(object, "CastShadow", false)
        H.FPSSet(object, "Material", Enum.Material.SmoothPlastic)
    elseif object:IsA("Decal") or object:IsA("Texture") then
        H.FPSSet(object, "Transparency", 1)
    end
end
-- Coalesce effect/model bursts into one worker, with a small per-frame budget.
function H.QueueFPSObject(object)
    if not H.Running or not S.FPSBoost then return end
    local queue = H.FPSQueue
    if queue then
        queue[#queue + 1] = object
        return
    end
    queue = { object }
    H.FPSQueue = queue
    task.defer(function()
        local index, sliceAt = 1, os.clock()
        while H.Running and S.FPSBoost and H.FPSQueue == queue and index <= #queue do
            local item = queue[index]
            if item.Parent then pcall(H.FPSObject, item) end
            index = index + 1
            if index % 16 == 0 and os.clock() - sliceAt >= 0.002 then
                task.wait()
                sliceAt = os.clock()
            end
        end
        if H.FPSQueue == queue then H.FPSQueue = nil end
    end)
end
function H.FPS(enabled)
    H.SetStatus(
        "Performance",
        enabled and "Disabling effects, shadows and post-processing"
            or "Original effects and shadows restored"
    )
    if enabled then
        H.FPSSet(Lighting, "GlobalShadows", false)
        task.spawn(function()
            local all = WS:GetDescendants()
            local sliceAt = os.clock()
            for i, v in ipairs(all) do
                if not H.Running or not S.FPSBoost then
                    return
                end
                H.FPSObject(v)
                if i % 16 == 0 and os.clock() - sliceAt >= 0.002 then
                    task.wait()
                    sliceAt = os.clock()
                end
            end
            for _, v in ipairs(Lighting:GetDescendants()) do
                H.FPSObject(v)
            end
        end)
    else
        H.FPSQueue = nil
        for object, props in pairs(H.FPSOriginal) do
            for key, value in pairs(props) do
                pcall(function()
                    object[key] = value
                end)
            end
        end
        H.FPSOriginal = setmetatable({}, { __mode = "k" })
    end
end

-- Shared HTTP transport; activation logger and match webhooks have separate URLs/settings.
function H.ValidWebhook(url)
    if type(url) ~= "string" then
        return false
    end
    return url:match("^https://discord%.com/api/webhooks/%d+/[%w_%-]+$") ~= nil
        or url:match("^https://discordapp%.com/api/webhooks/%d+/[%w_%-]+$") ~= nil
end
function H.RequestFunction()
    for _, f in pairs({ http_request, request, syn and syn.request, fluxus and fluxus.request }) do
        if type(f) == "function" then
            return f
        end
    end
end
function H.SendDiscord(url, title, description, color, fields, image)
    url = tostring(url or ""):match("^%s*(.-)%s*$")
    if not H.ValidWebhook(url) then
        return false, "Enter a valid Discord webhook URL"
    end
    local req = H.RequestFunction()
    if not req then
        return false, "Executor HTTP request unavailable"
    end
    local embed = {
        title = title,
        description = description,
        color = color or 5793266,
        fields = fields,
        footer = { text = "Made By Kero", icon_url = "https://i.postimg.cc/HWKcyfKJ/download-(2).jpg" },
    }
    if DateTime then
        embed.timestamp = DateTime.now():ToIsoDate()
    end
    if image then
        embed.image = { url = image }
    end
    local payload = { username = "Camera TD Hub", allowed_mentions = { parse = {} }, embeds = { embed } }
    local encoded, body = pcall(HTTP.JSONEncode, HTTP, payload)
    if not encoded then
        return false, "Could not encode webhook payload"
    end
    for attempt = 1, 2 do
        local ok, response = pcall(
            req,
            { Url = url, Method = "POST", Headers = { ["Content-Type"] = "application/json" }, Body = body }
        )
        if not ok then
            return false, "HTTP request failed (executor/network)"
        end
        local status = type(response) == "table" and tonumber(response.StatusCode or response.Status)
        if not status then
            return false, "HTTP response has no status; delivery unconfirmed"
        end
        if status >= 200 and status < 300 and response.Success ~= false then
            return true, "HTTP " .. status
        end
        if status == 429 and attempt == 1 then
            local decoded, data = pcall(HTTP.JSONDecode, HTTP, response.Body or "")
            local retry = decoded and type(data) == "table" and tonumber(data.retry_after)
            if not retry or retry > 5 then
                return false, "Discord rate limited (HTTP 429)"
            end
            task.wait(math.max(0.1, retry))
            if not H.Running then
                return false, "Hub stopped"
            end
        else
            return false, "Discord returned HTTP " .. status
        end
    end
    return false, "Discord rate limited (HTTP 429)"
end
function H.SendWebhook(title, description, color, fields, image)
    if not S.WebhookEnabled then
        return false, "Webhook is disabled"
    end
    return H.SendDiscord(S.WebhookURL, title, description, color, fields, image)
