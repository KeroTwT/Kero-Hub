    Utilities.Hidden = {}
end
function Utilities.IsOwnName(text)
    local name = tostring(text or ""):match("^%s*(.-)%s*$")
    return name == LocalPlayer.Name or name == "@" .. LocalPlayer.Name
        or (LocalPlayer.DisplayName ~= "" and name == LocalPlayer.DisplayName)
