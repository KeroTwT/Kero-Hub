local function AddAction(action)
    if Hub.MatchFlow then Hub.MatchFlow.UpdateRecorderClock() end
    action.Wave = action.Wave or GetWave()
    action.RecordedAt = action.RecordedAt or (os.clock() - State.RecordStartedAt)
