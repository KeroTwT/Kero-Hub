            pcall(function() Remotes.Speed:FireServer(1) end)
        end

        local gui = GetPlayerGui()
        local skipGui = gui and gui:FindFirstChild("skipWave")
        local skipWindowOpen = skipGui and skipGui.Enabled == true
        if State.AutoSkip
            and macroAutomationReady
            and not ended
