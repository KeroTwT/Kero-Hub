        end

        local speedEligible = State.AutoSpeed
            and macroAutomationReady
            and matchReady
            and Remotes.Speed
            and not ended

        if speedEligible then
            if speedReadySince == nil then
                speedReadySince = now
            elseif now - speedReadySince >= State.SpeedScaleDelay then
                speedReadySince = now
