local function GetMoney()
    local leaderstats = LocalPlayer:FindFirstChild("leaderstats")
    local money = leaderstats and leaderstats:FindFirstChild("Money")
    local value = money and tonumber(money.Value) or 0
    -- Brutal probe 1792742021: sandbox money exposes INT64_MIN in the replicated value
    -- to INT64_MIN while normal placement/upgrades continue to succeed.
    -- Match only that sentinel (Luau doubles round it), never arbitrary debt.
    if value == -9223372036854775808 or value == math.huge then
        return math.huge
    end
    if value ~= value or value == -math.huge then return 0 end
    return value
end

